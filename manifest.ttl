PREFIX atns: <https://linked.data.gov.au/def/atns/model/>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX mrr: <https://prez.dev/ManifestResourceRoles/>
PREFIX odrl: <http://www.w3.org/ns/odrl/2/>
PREFIX prez: <https://prez.dev/>
PREFIX prof: <http://www.w3.org/ns/dx/prof/>
PREFIX rico: <https://www.ica.org/standards/RiC/ontology/>
PREFIX schema: <https://schema.org/>

[]
    a prez:Manifest ;
    prof:hasResource
        [
            prof:hasArtifact "catalogue.ttl" ;
            prof:hasRole mrr:CatalogueData ;
            schema:description "The definition of, and metadata for, the container which here is a sdo:DataCatalog object" ;
            schema:name "Catalogue Definition" ;
        ] ,
        # reference
        [
            prof:hasArtifact "resources/reference/vocabs/sync/*.ttl" ;
            prof:hasRole mrr:ResourceData ;
            schema:description "skos:ConceptScheme objects in RDF (Turtle) files in the vocabs/sync/ folder for syncing" ;
            schema:name "Reference Vocabularies" ;
            dcterms:conformsTo <https://linked.data.gov.au/def/vocpub/validator> ;
        ] ,
        [
            prof:hasArtifact "resources/reference/datasets/metadata/*.ttl" ;
            prof:hasRole mrr:ResourceData ;
            schema:description "schema:Dataset objects in RDF (Turtle) files in the datasets/metadata/ folder for syncing" ;
            schema:name "Reference Spatial Datasets" ;
            schema:additionalType schema:Dataset ;
            # LOC-I validator
        ] ,
        [
            prof:hasArtifact "resources/reference/ontologies/*.ttl" ;
            prof:hasRole mrr:ResourceData ;
            schema:description "owl:Ontology objects in RDF (Turtle) files in the ontologies/ folder for syncing" ;
            schema:name "Reference Ontologies" ;
            dcterms:conformsTo <https://linked.data.gov.au/def/ontpub/validator> ;
        ] ,
        # isu
        [
            prof:hasArtifact "resources/isu/*.ttl" ;
            prof:hasRole mrr:ResourceData ;
            schema:description "sdo:CreativeWork objects in RDF (Turtle) files in the resources/ folder" ;
            schema:name "Resource Data" ;
            # dcterms:conformsTo <https://data.idnau.org/pid/cp/validator> ;
        ] ,
        [
            prof:hasArtifact "resources/isu/isu-archive.ttl" ;
            prof:hasRole mrr:ResourceData ;
            schema:description "sdo:CreativeWork objects in RDF (Turtle) files in the resources/ folder" ;
            schema:name "Resource Data" ;
            schema:additionalType
                schema:CreativeWork ,
                rico:RecordResource ;
            # dcterms:conformsTo <https://data.idnau.org/pid/cp/validator> ;
        ] ,
        # kp
        [
            prof:hasArtifact "resources/keeping-place/*.ttl" ;
            prof:hasRole mrr:ResourceData ;
            schema:description "sdo:CreativeWork objects in RDF (Turtle) files in the resources/ folder" ;
            schema:name "Resource Data" ;
            # dcterms:conformsTo <https://data.idnau.org/pid/cp/validator> ;
            # dcterms:conformsTo "bcp.ttl" ;
        ] ,
        # external
        [
            prof:hasArtifact "resources/*.ttl" ;
            prof:hasRole mrr:ResourceData ;
            schema:description "schema:CreativeWork objects in RDF (Turtle) files in the resources/ folder for syncing" ;
            schema:name "Syncable Resource Data" ;
            # dcterms:conformsTo <https://data.idnau.org/pid/cp/validator> ;
        ] ,
        # demo
        [
            prof:hasArtifact
                "resources/demo/0811114042000269281.ttl" ,
                "resources/demo/24750158.2024.2411643.ttl" ,
                "resources/demo/762463a4-f8b1-4eec-a335-3689c8d86e9e.ttl" ,
                "resources/demo/MPF1226_titleOnlyVariant.ttl" ,
                "resources/demo/b494af84-a16e-4cc1-b1f1-aad2486c4656.ttl" ,
                "resources/demo/bja.2025.17.ttl" ,
                "resources/demo/iipj.2023.14.1.10987.ttl" ,
                "resources/demo/isbn0864090293.ttl" ,
                "resources/demo/storeroom1189.ttl" ,
                "resources/demo/watch?v=tEdweyPh-N8.ttl" ;
            prof:hasRole mrr:ResourceData ;
            schema:additionalType schema:CreativeWork ;
            schema:description "Creative work resource data in RDF (Turtle) files" ;
            schema:name "Creative Work Resource Data" ;
        ] ,
        [
            prof:hasArtifact "resources/demo/multipleIRIspatial.ttl" ;
            prof:hasRole mrr:ResourceData ;
            schema:additionalType dcat:Dataset ;
            schema:description "Dataset resource data in an RDF (Turtle) file" ;
            schema:name "Dataset Resource Data" ;
        ] ,
        [
            prof:hasArtifact "resources/demo/policy-telstra-ngaanyatjarra-ilua.ttl" ;
            prof:hasRole mrr:ResourceData ;
            schema:additionalType odrl:Agreement ;
            schema:description "Demonstration ODRL Agreement interpretation linked from an ATNS agreement record" ;
            schema:name "ODRL Agreement Resource Data" ;
        ] ,
        [
            prof:hasArtifact
                "resources/demo/atns-24.ttl" ,
                "resources/demo/atns-27.ttl" ,
                "resources/demo/atns-30.ttl" ,
                "resources/demo/atns-37.ttl" ,
                "resources/demo/atns-1624.ttl" ;
            prof:hasRole mrr:ResourceData ;
            schema:additionalType atns:AgreementRecord ;
            schema:description "ATNS Agreement-category entity resource data in RDF (Turtle) files" ;
            schema:name "ATNS Agreement Record Resource Data" ;
        ] ,
        [
            prof:hasArtifact
                "resources/demo/atns-384.ttl" ,
                "resources/demo/atns-617.ttl" ,
                "resources/demo/atns-618.ttl" ,
                "resources/demo/atns-753.ttl" ,
                "resources/demo/atns-760.ttl" ,
                "resources/demo/atns-1845.ttl" ,
                "resources/demo/atns-3160.ttl" ;
            prof:hasRole mrr:ResourceData ;
            schema:additionalType atns:Entity ;
            schema:description "Other ATNS entity resource data in RDF (Turtle) files" ;
            schema:name "ATNS Entity Resource Data" ;
        ] ,
        [
            prof:hasArtifact "resources/demo/*atns-ref-*.ttl" ;
            prof:hasRole mrr:ResourceData ;
            schema:additionalType atns:Reference ;
            schema:description "ATNS reference resource data in RDF (Turtle) files" ;
            schema:name "ATNS Reference Resource Data" ;
        ] ,
        [
            prof:hasArtifact "resources/demo/*atns-rel-*.ttl" ;
            prof:hasRole mrr:ResourceData ;
            schema:additionalType atns:EntityRelationship ;
            schema:description "ATNS entity relationship resource data in RDF (Turtle) files" ;
            schema:name "ATNS Entity Relationship Resource Data" ;
            # dcterms:conformsTo <https://data.idnau.org/pid/cp> ;
        ] ,
        # manifest
        [
            prof:hasArtifact "https://raw.githubusercontent.com/RDFLib/prez/refs/heads/main/prez/reference_data/profiles/ogc_records_profile.ttl" ;
            prof:hasRole mrr:CatalogueAndResourceModel ;
            schema:description "The default Prez profile for Records API" ;
            schema:name "Profile Definition" ;
        ] ,
        [
            prof:hasArtifact "labels.ttl" ;
            prof:hasRole mrr:IncompleteCatalogueAndResourceLabels ;
            schema:description "An RDF file containing labels for catalogue's content, auto-extracted from KurrawongAI's Semantic Background" ;
            schema:name "Labels" ;
        ] ,
        [
            prof:hasArtifact "labels-manual.ttl" ;
            prof:hasRole mrr:IncompleteCatalogueAndResourceLabels ;
            schema:description "An RDF file containing labels for catalogue's content, manually created" ;
            schema:name "Manual Labels" ;
        ] ;
.