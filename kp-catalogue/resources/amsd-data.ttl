<https://data.idnau.org/pid/resource/041b30a8-f187-4846-9890-de2a200dbfc8>
    a schema:Dataset ;
    schema:additionalType <http://purl.org/spar/fabio/DataFile> ;
    schema:creator "Kelly, Piers, Junran Lei, Hans-Jörg Bibiko, and Lorina Barker" ;
    schema:dateCreated "2018"^^xsd:gYear ;
    schema:dateModified "2026-05-25"^^xsd:date ;
    schema:description "An online version control repository containing data files for the content of the Australian Message Stick Database" ;
    schema:distribution 
        [
            a schema:DataDownload ;
