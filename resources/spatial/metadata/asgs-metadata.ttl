PREFIX d: <https://linked.data.gov.au/dataset/asgsed3>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX void: <http://rdfs.org/ns/void#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

d:
    a schema:Dataset ;
    geo:hasBoundingBox
        [
            a geo:Geometry ;
            geo:asWKT "POLYGON ((167.99804 -43.740497, 167.99804 -9.142162, 96.816951 -9.142162, 96.816951 -43.740497, 167.99804 -43.740497))"^^geo:wktLiteral ;
        ] ;
    rdfs:member
        <https://linked.data.gov.au/dataset/asgsed3/SA2> ,
        <https://linked.data.gov.au/dataset/asgsed3/SA3> ;
    skos:editorialNote "2026-11: Aligned dataset names of ASGS datasets"@en ;
    schema:additionalType <https://data.idnau.org/pid/vocab/cat-obj-types/SpatialDataset> ;
    schema:citation "https://www.abs.gov.au/statistics/standards/australian-statistical-geography-standard-asgs/edition-3-july-2021-june-2026"^^xsd:anyURI ;
    schema:codeRepository "https://github.com/dcceew-bdr/asgs-etl"^^xsd:anyURI ;
    schema:creator <https://linked.data.gov.au/org/abs> ;
    schema:dateCreated "2021-07-20"^^xsd:date ;
    schema:dateModified "2026-11-28"^^xsd:date ;
    schema:description "Australian Statistical Geography Standard (ASGS) Edition 3, represented with reduced-resolution geometries for BDR reference-data discovery and display." ;
    schema:keywords
        <https://data.idnau.org/pid/vocab/idn-th/place> ,
        "Reference" ;
    schema:name "ASGS Ed. 3 - Main Structure" ;
    schema:publisher <https://linked.data.gov.au/org/abs> ;
    schema:version "4" ;
.

<https://linked.data.gov.au/dataset/asgsed3/SA2>
    a geo:FeatureCollection ;
    void:inDataset d: ;
    geo:hasBoundingBox
        [
            a geo:Geometry ;
            geo:asWKT "POLYGON ((167.99804 -43.740497, 167.99804 -9.142162, 96.816951 -9.142162, 96.816951 -43.740497, 167.99804 -43.740497))"^^geo:wktLiteral ;
        ] ;
    schema:description "Statistical Areas Level 2 in ASGS Edition 3." ;
    schema:name "Statistical Areas Level 2" ;
.

<https://linked.data.gov.au/dataset/asgsed3/SA3>
    a geo:FeatureCollection ;
    geo:hasBoundingBox
        [
            a geo:Geometry ;
            geo:asWKT "POLYGON ((167.99804 -43.740497, 167.99804 -9.142162, 96.816951 -9.142162, 96.816951 -43.740497, 167.99804 -43.740497))"^^geo:wktLiteral ;
        ] ;
    schema:description "Statistical Areas Level 3 in ASGS Edition 3." ;
    schema:name "Statistical Areas Level 3" ;
.
