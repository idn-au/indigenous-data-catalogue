idn-resource:f0c201de-d1f8-5e53-b813-851077ea0b53 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A005271"^^xsd:token ;
