idn-resource:49f47d1c-4309-5687-b6ad-d1d0a08a8c05 a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:3981f2eb-c33b-5aad-bb6a-e637c9797367 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
