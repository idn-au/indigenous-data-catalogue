idn-resource:ccfa154b-cf56-56dc-88ed-d224e1af1072 a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:7b928a0d-47c5-537a-9136-066ae7f542f4 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:244f6961-729f-5b21-8fc9-baff9dd9af7e ;
    atns:deleted false ;
    atns:eid "A002801"^^xsd:token ;
    atns:sourceEntityId "3186"^^xsd:token ;
    atns:subcategory atns-subcat:09f0a068-ce65-5c11-8dec-f081d1a81ec2 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """The Norforce – Borroloola Indigenous Land Use Agreement (ILUA) was agreed between the Northern Land Council, the Northern Territory of Australia, and Wendy Roper, Gordon Lansen, Phillip Timothy, Graham Friday, and Mavis Timothy for and on behalf of the Rrumburriya Borroloola Group.

The Rrumburriya Borroloola native title group gives permission for a ten-year lease to be granted over the ILUA area to the Commonwealth Department of Defence for the purpose of a Norforce Depot, in order to resolve a tenure issue over the area. Norforce is an Australian Defence Force military unit set up in 1942 that is made up of 60 percent Aboriginal soldiers.

The ILUA stipulates that it does not authorise any extensions to this lease, and that doing so would constitute an unauthorised ‘future act’."""@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:226851a5-4652-58c0-9a88-448bc922deed,
        atns-sub:c74e76ef-701f-5784-8223-5fcd87a7641c,
        "Demo" ;
    schema:location "Borroloola, Northern Territory, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=3186> ;
    schema:name "Norforce - Borroloola Indigenous Land Use Agreement (ILUA)"@en ;
    schema:startDate "2006-01-09"^^xsd:date ;
    schema:text "This ILUA includes agreement that the non-extinguishment principle applies to any 'future acts' that may be done. The parties also agree that the right to negotiate provisions of the Native Title Act 1993 (Cth) do not apply to future acts, as the alternative consultation provisions are to be followed instead. Under this Act any activity, such as a grant of land, that may affect native title rights is defined as a ‘future act’ and must comply with the future act provisions of the Act in order to be valid."@en .

idn-resource:ccfb422d-d77f-5c91-9f5d-01a341c534a3 a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:b32e715e-28bf-5aad-945e-fa89035e46a5,
        idn-resource:c05fc235-4fc5-55d3-af2b-0236cb0e335e ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:244f6961-729f-5b21-8fc9-baff9dd9af7e ;
    atns:deleted false ;
    atns:eid "A000451"^^xsd:token ;
    atns:sourceEntityId "862"^^xsd:token ;
    atns:subcategory atns-subcat:51e799aa-68a2-5df5-b3b6-ce3837c24612 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """A Conservation Agreement is a standard (template) agreement which it is proposed could be entered into between the Commonwealth Minister for the Environment and Heritage and Indigenous communities, Land Councils or other Indigenous bodies in relation to management of Aboriginal land under the Indigenous Protected Areas Program.

The Minister is empowered to enter into a Conservation Agreement under the Commonwealth Environmental Protection and Biodiversity Conservation Act No 91 of 1999 (the Act). Such an agreement could provide a mechanism for long-term land use agreements to be developed."""@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:17d993e0-d19e-5349-a48e-4de57b1dba59,
        atns-sub:7cc37d9a-fe3c-5fec-b115-d1bb8d72db9c,
        atns-sub:e52a2091-dcda-569c-aafb-6497428c615c,
        "Demo" ;
    schema:location "Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=862> ;
    schema:name "Conservation Template Agreement"@en ;
    schema:text """The Agreement is intended for use with land that has been declared an Indigenous Protected Area under the Indigenous Protected Areas Program. One of the purposes of the Agreement is that the parties work together to manage the land with the objective of enhancing the conservation of the land’s biodiversity and to protect its cultural heritage values.

Under the Agreement it is intended that Native Title rights will be protected and the land will be managed in accordance with a Plan of Management and in accordance with the World Conservation Union management categories, to which the land is assigned, as set out in the Act.

The Agreement provides for Commonwealth Government funding, although the funded organisation must look for additional funding sources. The Agreement also sets out requirements for financial accountability and reporting procedures."""@en .

