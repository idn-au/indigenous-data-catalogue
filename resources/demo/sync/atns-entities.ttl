idn-resource:f89213e4-a464-5041-86e7-59061816dae9 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:244f6961-729f-5b21-8fc9-baff9dd9af7e ;
    atns:deleted false ;
    atns:eid "A003431"^^xsd:token ;
    atns:sourceEntityId "223"^^xsd:token ;
    atns:subcategory atns-subcat:09f0a068-ce65-5c11-8dec-f081d1a81ec2 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """The Wedderburn Mining ILUA concerns the granting and use of exploration and mining licenses, and the conduct of cultural heritage management procedures.

It provides that the parties agree to the doing of certain Future Acts in respect of the ILUA area such as the grant by the State of mining and exploration Licenses required by the proponent (the mining company) and the use of licences and any associated consents by the proponent. The parties agree that any such Future Acts done within the ILUA area are valid.

The ILUA provides that the parties agree the right to negotiate provisions of the Native Title Act 1993 (Cth) are not intended to apply to any Future Acts which will be listed in Schedule 1 of the agreement."""@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
