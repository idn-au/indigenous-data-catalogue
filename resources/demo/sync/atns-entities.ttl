idn-resource:de44c20f-a3b0-5bfd-ad43-a5e69288cd0c a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:06025fcd-5500-5e41-af82-0c86a33189ac,
        idn-resource:8468d648-b749-5b24-afb7-fa533de18350,
        idn-resource:8f28e469-e368-5e58-81e1-f39f68e955a0,
        idn-resource:c09dd25a-c4a2-514c-8b38-0601055cc8a6,
        idn-resource:c13b2b9b-a78f-52bd-a6df-e3dc138c8775 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:244f6961-729f-5b21-8fc9-baff9dd9af7e ;
    atns:deleted false ;
    atns:eid "A002967"^^xsd:token ;
    atns:sourceEntityId "3343"^^xsd:token ;
    atns:subcategory atns-subcat:fce7d633-05fc-5e3e-8605-0cad9866c612 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """The Overarching Agreement on Indigenous Affairs between the Commonwealth of Australia and the State of South Australia (also known as the Bilateral Agreement on Service Delivery to Aboriginal and Torres Strait Islanders in South Australia) was signed by the Prime Minister, John Howard, and the Premier of South Australia, Mike Rann, on 17 April 2006. The five-year agreement aims to enhance health and welfare of Indigenous South Australians.

This is the third bilateral agreement to result from the Council of Australian Governments' (COAG) 'National Framework of Principles for Delivering Services to Indigenous Australians' endorsed in June 2004. The agreement is a response to issues identified in the Overcoming Indigenous Disadvantage Report."""@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:17d993e0-d19e-5349-a48e-4de57b1dba59,
        atns-sub:4f924c21-9e16-51f1-823e-8944b84c7142,
        atns-sub:51ca8813-b7bb-5a37-819e-afae35771fff,
        atns-sub:6a8815da-e29d-506f-85fd-c64c8807fea2,
        atns-sub:d15dd1de-4696-50c8-9f10-2e95eea88e6f,
        atns-sub:e52a2091-dcda-569c-aafb-6497428c615c,
        "Demo" ;
    schema:location "South Australia, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=3343> ;
    schema:name "Overarching Agreement on Indigenous Affairs between the Commonwealth of Australia and the State of South Australia"@en ;
    schema:startDate "2006-04-17"^^xsd:date ;
    schema:text """The agreement includes planned action in the areas of 'safer communities; housing and infrastructure; health and education; homelessness; economic development; land, environment and culture; and service delivery'.

It is to enhance cooperation between the two governments in service delivery, including through a streamlining of processes. The agreement is also designed to reduce bureaucratic overlap and service duplication in Indigenous communities."""@en ;
    schema:url "https://web.archive.org/web/20070607031409/http://www.oipc.gov.au/publications/PDF/SA_IndigAgreement.pdf"^^xsd:anyURI .

idn-resource:de5bbc15-f6c2-5c93-b45c-fcdeccb021a8 a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:2bde0a9a-e531-52d8-af98-8a01c86f57ef,
        idn-resource:c965f44a-cb07-5f82-9c35-7ec960b4852f ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:244f6961-729f-5b21-8fc9-baff9dd9af7e ;
    atns:deleted false ;
    atns:eid "A000435"^^xsd:token ;
    atns:sourceEntityId "846"^^xsd:token ;
    atns:subcategory atns-subcat:6ffe90c2-95c9-51b5-a083-8c7d83b975ef,
        atns-subcat:b7b5cd08-d283-583c-a41f-39a8ccf7f555 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description "In early 2002 the Aboriginal and Torres Strait Islander Commission (ATSIC) commissioned a consultancy to undertake research with a view to developing a Community Participation Agreement for the Mutitjulu Community Council and residents. The Agreement will be the first of its kind. The resultant Mutitjulu Community Participation and Partnership Agreement Report suggests that a '5-10 year commitment is necessary for the Community Participation Program model to make any inroads on the current situation. This would involve a 'planned transition to community control and management, within the existing legislative framework, and in a real partnership between the Mutitjulu Community Council, the Federal Government and other key stakeholders.'"@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:d15dd1de-4696-50c8-9f10-2e95eea88e6f,
        "Demo" ;
    schema:location "Mutitjulu (Ayers Rock), Northern Territory, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=846> ;
    schema:name "The Mutitjulu Community Participation and Partnership Agreement"@en ;
    schema:text """The Report identified as key issues: the lack of coordination, planning and service delivery by government, and intergenerational welfare dependency and the existence of a multiplicity of governance structures. It noted the potential substantial benefits that could arise from the Community’s location within a world renowned tourist area and as joint managers of the Uluru-Kata Tjuta National Park with Parks Australia, but despite this the Community had remained ‘marginal to many of the developments taking place on their lands’. According to the Social Justice Report, the key objectives of the model put forward are:
· A one-in all-in approach to participation;
· Recognising, through the development of a participation framework, the contribution of groups within the community;
· Identifying innovative approaches to money management within the community and encouraging improved budgeting and financial responsibility;
· Exploring alternative approaches to service delivery arrangements;
· Building the organisational and management capacity of the community; and
· Exploring opportunities of more effective partnering with the business sector and non government sector."""@en .

