idn-resource:4707b10d-1761-5f7d-851c-218698ed0860 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A005859"^^xsd:token ;
