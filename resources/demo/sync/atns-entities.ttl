idn-resource:58303b82-6402-5e83-9b24-bbd5a0c559c4 a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:7b928a0d-47c5-537a-9136-066ae7f542f4 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:244f6961-729f-5b21-8fc9-baff9dd9af7e ;
    atns:deleted false ;
    atns:eid "A000741"^^xsd:token ;
    atns:sourceEntityId "1218"^^xsd:token ;
    atns:subcategory atns-subcat:09f0a068-ce65-5c11-8dec-f081d1a81ec2 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """The Kalkadoon / MIM Indigenous Land Use Agreement (the ILUA) covers an area around Mount Isa of just over 50,000 square kilometres. Under the agreement the Kalkadoon People (the registered native title claimants in the area) agree to the grant of Exploration Permits (EPs) by the State of Queensland, subject to conditions. The right to negotiate provisions of the Native Title Act 1993 (Cth) do not apply to these grants. This will enable the backlog of applications for tenements in the agreement area made to the State by grantees, to be processed without requiring the longer timeframes of the right to negotiate process that would otherwise apply.

Under the agreement, EPs may be granted to an 'Explorer' for up to 5 years, subject to the Explorer signing an 'Exploration Deed' and a set of 'Native Title Conditions' defined in the ILUA and provided that the Explorer has executed the 'Ancilliary Agreement' required under the ILUA. On being granted an EP, the Explorers may conduct 'Work Activites' in the area. EPs granted under the ILUA may be renewed, provided they remain subject to the conditions of the agreement."""@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:17d993e0-d19e-5349-a48e-4de57b1dba59,
        atns-sub:29221ef9-81d0-59aa-a9c9-744b71ff8349,
        atns-sub:35e19906-2659-5157-8aee-b9d82eedbb1c,
        atns-sub:9c404ff9-19e6-5e64-a8bd-2e3b39773146,
        atns-sub:c74e76ef-701f-5784-8223-5fcd87a7641c,
        "Demo" ;
    schema:location "Vicinity of  Mount Isa, Queensland, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=1218> ;
    schema:name "Kalkadoon / MIM Indigenous Land Use Agreement (ILUA)"@en ;
    schema:startDate "2002-05-17"^^xsd:date .

