    schema:startDate "2003-06-27"^^xsd:date .

idn-resource:2f8cdd20-c274-56b7-8793-48b99ca0abb7 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:244f6961-729f-5b21-8fc9-baff9dd9af7e ;
    atns:deleted false ;
    atns:eid "A000553"^^xsd:token ;
    atns:sourceEntityId "964"^^xsd:token ;
    atns:subcategory atns-subcat:6ffe90c2-95c9-51b5-a083-8c7d83b975ef ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description "The Redland/Quandamooka Native Title Process Agreement was entered into between the Redland Shire Council and the Quandamooka Lands Council Aboriginal Corporation. The aims of the Agreement are to record the parties’ understanding in relation to a process leading to an Agreement on Native Title; the subject matters for negotiation in mediation discussions; and the principles underpinning the process."@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:06f9cf03-2d66-5dfe-807c-b7632b2ea564,
        atns-sub:5996de0c-8cc6-5f14-8901-d839af36a4d4,
        atns-sub:c74e76ef-701f-5784-8223-5fcd87a7641c,
        "Demo" ;
    schema:location "North Stradbroke Island (Minjerribah) and surround, Queensland, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=964> ;
    schema:name "The Redland/Quandamooka Native Title Process Agreement"@en ;
    schema:startDate "1997-08-14"^^xsd:date ;
    schema:text """In December 1994 Quandamooka Lands Council Aboriginal Corporation lodged a native title claim with the National Native Title Tribunal for an area of land and waters in Moreton Bay (Quandamooka). This led to discussions between the Redland Shire Council, as a party to the claim, and the claimants, which resulted in the formulation of the Agreement. The discussions also revealed that the Council and the claimants held similar views about the future of North Stradbroke Island including the need for a joint planning and management study.

The Agreement includes details in relation to:
· The background to the formulation of the agreement;
· The area to which the agreement applies;
· The processes to be followed in the preparation of an Agreement on Native Title;
· Subject matters for negotiation in the formulation of an Agreement on Native Title;
· The principles behind the negotiation process including ideas of good faith, consultation and respect;
· Sources of funding, technical assistance and other resourcing matters;
· Definition of confidentiality and relevant procedures;
· How third party interests shall be addressed throughout the process;
· The relevance of the agreement to the final determination of native title by the State Government or the Courts;
· Statement of the parties intent to support an Agreement on Native Title to be formulated by the parties notwithstanding any determination of the Quandamooka people’s native title rights and interests; and
· Termination procedures should parties wish to withdraw from the process or upon completion of execution of the Agreement on Native Title."""@en .

