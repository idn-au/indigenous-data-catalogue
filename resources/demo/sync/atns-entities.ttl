        atns-sub:9073e633-80a9-5ba7-8892-f556bd0a0612,
        atns-sub:dc50c698-80b0-5ef4-bd95-928f2be8da05,
        atns-sub:e52a2091-dcda-569c-aafb-6497428c615c,
        "Demo" ;
    schema:location "Cape Flattery, Cape York Peninsula, Queensland, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=1492> ;
    schema:name "Hope Vale Aboriginal Council and Cape Flattery Silica Mines Deeds of Compensation A & B"@en ;
    schema:startDate "1992-04-30"^^xsd:date .

