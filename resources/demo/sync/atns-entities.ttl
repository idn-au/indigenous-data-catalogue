idn-resource:3f0b44c3-baee-5c64-9c96-b362bfbb7368 a atns:Entity ;
    dcterms:references idn-resource:195e8c78-6ea0-5256-a004-0dc4244f2251,
        idn-resource:1e29437f-2a6a-58b7-a7a7-cb88f408ffbe,
