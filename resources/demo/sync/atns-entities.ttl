idn-resource:7415f35b-d0e2-5e12-b423-bda4bf54e3a0 a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:90a1f112-686c-5a3a-a0ea-25ad02093ebf,
        idn-resource:ceb5b155-938d-58a1-823e-6d17949bc057,
        idn-resource:f3fca981-26f8-5575-a9bf-fda942421cf2 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
