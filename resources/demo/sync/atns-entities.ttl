        atns-sub:9e5e8f61-69be-5e2a-a9cd-58fb000349bd,
        atns-sub:c74e76ef-701f-5784-8223-5fcd87a7641c,
        "Demo" ;
    schema:location "Tyarne, Northern Territory, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=1887> ;
    schema:name "Tyarne (Community Living Area) Indigenous Land Use Agreement (ILUA)"@en ;
    schema:startDate "2003-11-14"^^xsd:date .

