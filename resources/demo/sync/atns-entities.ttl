        atns-subcat:7dff9d75-8efe-5518-a99d-54546a46d417 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description "The Agreement Respecting the Implementation of the James Bay Northern Quebec Agreement between the Government of Canada and Makivik Corporation was signed on 12 September 1990. The Agreement establishes an ongoing federal organisation and structure to facilitate, consult and advise communications between various departments and agencies involved in the implementation of the James Bay and Northern Quebec Agreement (JBNQA). It establishes a mechanism for the ongoing implementation of Canada's obligations under the JBNQA; sets up the JBNQA Implementation Forum to review the progress of the implementation; provides a mechanism for dispute resolution; and establishes Working Groups to make recommendations on policy and procedures. The Agreement also includes a payment of around (CDN)$22 million to Makivik for the benefit of the Inuit of Quebec on the understanding that the payment fulfils whatever financial responsibility Canada may have under certain sections of the JBNQA."@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:078baf41-50e7-561d-9163-fb3b43a98261,
        atns-sub:5996de0c-8cc6-5f14-8901-d839af36a4d4,
        atns-sub:dc50c698-80b0-5ef4-bd95-928f2be8da05,
        "Demo" ;
    schema:location "James Bay Territory, Quebec, Canada"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=2027> ;
    schema:name "Agreement Respecting the Implementation of the James Bay and Northern Quebec Agreement"@en ;
    schema:startDate "1990-09-12"^^xsd:date .

