idn-resource:c227d980-be82-5f21-8bf2-38a1f87903a6 a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:f31e84fe-594a-5c96-a308-84ed99220660 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:709d65e9-b221-53f9-a7f6-0282c0956e36 ;
    atns:deleted false ;
    atns:eid "A001614"^^xsd:token ;
    atns:sourceEntityId "2059"^^xsd:token ;
    atns:subcategory atns-subcat:7b236814-e530-5bde-856c-b25535686470 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description "The Tlicho Intergovernmental Services Agreement is made between the Dogrib Treaty 11 Council, the Government of Canada and the Government of the Northwest Territories. It will come into effect when the Tlicho Land Claims and Self-Government Agreement (the Tlicho Agreement) comes into effect on the passing of legislation by both the Governments of Canada and the Northwest Territories."@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:5996de0c-8cc6-5f14-8901-d839af36a4d4,
        atns-sub:6a8815da-e29d-506f-85fd-c64c8807fea2,
        atns-sub:d15dd1de-4696-50c8-9f10-2e95eea88e6f,
        "Demo" ;
    schema:location "Northwest Territories, Canada"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=2059> ;
    schema:name "Tlicho Intergovernmental Services Agreement"@en ;
    schema:text """Chapter 7.10 of the Tlicho Agreement provides that there shall be an intergovernmental service agreement. The primary objective of the agreement is:
• ‘to provide for the management, administration and delivery of health, education, welfare, family or other social programs and services to persons other than Tlicho Citizens on Tlicho lands or in a Tlicho community and to Tlicho Citizens; and
• to be the instrument through which government and the Tlicho Government exercise their authorities over these types of programs and services and assume responsibility and accountability for their delivery […]
in a manner that respects and promotes the Tlicho language and the culture and way of life of the Tlicho First Nation.’"""@en .

