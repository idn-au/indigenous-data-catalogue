idn-resource:4c4475e4-9c70-54ab-95b2-22eccac20726 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A006728"^^xsd:token ;
