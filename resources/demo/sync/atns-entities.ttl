idn-resource:d533ad95-cee5-50f9-998b-212e7794e5a2 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A007350"^^xsd:token ;
