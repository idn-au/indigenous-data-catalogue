        "Demo" ;
    schema:location "Victoria, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=2149> ;
    schema:name "Pro forma Section 31 Deed for Mining Licences (Victoria)"@en ;
    schema:url "http://www.dpi.vic.gov.au/dpi/nrenmp.nsf/FID/-771FC61DA38AADE74A256A72001EF70E?OpenDocument"^^xsd:anyURI .

idn-resource:4a27775d-c87d-5ee7-acb0-c6619a2141ea a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
