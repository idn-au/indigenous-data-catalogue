idn-resource:dcaeffa0-a915-5e7a-99b6-e5811c76c613 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A007743"^^xsd:token ;
    atns:sourceEntityId "7743"^^xsd:token ;
    atns:subcategory atns-subcat:09f0a068-ce65-5c11-8dec-f081d1a81ec2,
        atns-subcat:177cef4d-1963-57e3-9b5c-508480daf336 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """The Dinah Island Indigenous Land Use Agreement (ILUA) was agreed between Harvest Home Holdings Pty Ltd and the Abm Elgoring Ambung Aboriginal Corporation.

The Agreement Area covers about 50 sq km, 144 km north east of Normanton.

The purpose of the Agreement is to provide consent for the Rolling Term Lease (0/206937) to include low key tourism purposes.

The Native Title Representative Body for this area is the Cape York Land Council Aboriginal Corporation."""@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:9335b2f1-4915-55cc-9736-2ded7c4a2008,
        atns-sub:c74e76ef-701f-5784-8223-5fcd87a7641c,
        atns-sub:f630e08a-ea9c-57e3-ab87-066e4b9ad57e,
        "Demo" ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=7743> ;
    schema:name "Dinah Island Indigenous Land Use Agreement (ILUA)"@en ;
    schema:spatialCoverage <https://data.idnau.org/pid/nntt/QI2016-050> ;
    schema:startDate "2016-10-24"^^xsd:date ;
    schema:text """Details of the Agreement:

Commencement:

This Agreement commences on 24 October 2016, except for clause 7 which concerns the Ministerial approval of low key tourism purposes and commences on the registration date, 24 January 2017.

Termination:

No end date is specified.

Native Title Provisions:

Right to negotiate

The parties agree that the right to negotiate provisions of the Native Title Act 1993 (Cth) do not apply to any of the agreed future acts of this Agreement.

Future act provisions

The parties consent to the Minister approving the addition of low key tourism purposes to the Rolling Term Lease 0/206937.

Native Title in the Area:

The Agreement is located within the native title determination area recognised by the Federal Court of Australia (FCA)in the proceeding Greenwool & Ors on behalf of the Kowanyama People v State of Queensland [2012] FCA 1377 (Kooyama Part B) (FCA File No.: QUD6119; NNTT No.: QCD2012/016)."""@en ;
    schema:url "http://www.nntt.gov.au/searchRegApps/NativeTitleRegisters/Pages/ILUA_details.aspx?NNTT_Fileno=QI2016/050"^^xsd:anyURI .

