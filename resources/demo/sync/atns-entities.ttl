        "Demo" ;
    schema:location "South of Cloncurry & Mount Isa, Queensland, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=1897> ;
    schema:name "Yulluna Indigenous Land Use Agreement (ILUA) for Backlog Exploration Permits"@en ;
    schema:startDate "2003-11-24"^^xsd:date .

