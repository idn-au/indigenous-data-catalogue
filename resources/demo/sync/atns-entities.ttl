idn-resource:be5d1d54-aef1-57f9-9d77-0bb1b3910f62 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A005019"^^xsd:token ;
