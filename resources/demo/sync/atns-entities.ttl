idn-resource:e56b16ca-a388-5965-9a76-11bb5a14072a a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A006422"^^xsd:token ;
