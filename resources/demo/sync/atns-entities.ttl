idn-resource:074a5b06-4a53-5449-a036-7305ba3a23d0 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A003722"^^xsd:token ;
    atns:sourceEntityId "3722"^^xsd:token ;
    atns:subcategory atns-subcat:1b340bb0-e40e-5938-a6a5-34a49cd07960 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """The Juru, Gia and Ngaro Turtle and Dugong Memorandum of Understanding (‘the MOU’) was signed on 5 July 2005 between the Queensland Environmental Protection Agency and the Juru, Gia and Ngaro, Traditional Owners from Ayr, Bowen and Proserpine.

The MOU concerns the suspension of dugong hunting in the North Queensland coastal waters of the Juru, Gia and Ngaro, formalising the groups’ self-imposed ban on dugong hunting. It also introduces a self-managed permit system for marine turtle hunting and use, so that the practice is better controlled and monitored, in accordance with traditional practice as agreed to by the community. For example, turtles used in some cultural ceremonies will not be killed but will instead be tagged and released."""@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:5996de0c-8cc6-5f14-8901-d839af36a4d4,
        atns-sub:b5868ee2-df76-5e62-ae92-ff325f5dbc01,
        atns-sub:e52a2091-dcda-569c-aafb-6497428c615c,
        "Demo" ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=3722> ;
    schema:name "Juru, Gia and Ngaro Turtle and Dugong Memorandum of Understanding"@en ;
    schema:startDate "2005-07-05"^^xsd:date ;
    schema:text "The agreement is described by the EPA as ‘historic’, being the first multi-clan agreement that has been reached with the organisation. The Queensland Government hopes that the MOU will be the ‘first of many multi-clan agreements with Traditional Owners along the Queensland coast’ (Department of Environment and Heritage). Wayne Butterworth, a Traditional Owner from the Juru People, said that the MOU 'does show that we can work together on issues such as this' (ABC Online)."@en .

