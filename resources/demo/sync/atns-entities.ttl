idn-resource:b4b0bb2d-ecfc-500f-9587-37d92f62bd6d a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:7b928a0d-47c5-537a-9136-066ae7f542f4,
        idn-resource:bf193876-404e-51c4-a316-951f40d4204a,
        idn-resource:c7b128eb-5a78-51e8-be1a-d0f2e1585e53 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:244f6961-729f-5b21-8fc9-baff9dd9af7e ;
    atns:deleted false ;
    atns:eid "A002219"^^xsd:token ;
