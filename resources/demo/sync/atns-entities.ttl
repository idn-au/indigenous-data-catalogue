        idn-resource:4a52d351-af0b-543c-bb34-fcf246e6390a,
        idn-resource:5a5a3f05-a2cf-5f17-9627-b12f768df84a,
        idn-resource:d94731f7-476f-5d02-87be-9a1fda93dcfa,
        idn-resource:eca93707-d987-5a1f-b8ef-21748262e765 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
