idn-resource:4e0f2851-d4ec-536c-bb87-882bd0124633 a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:273c4f33-9372-5049-b0fe-eea3ef6f4130 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:244f6961-729f-5b21-8fc9-baff9dd9af7e ;
    atns:deleted false ;
    atns:eid "A002375"^^xsd:token ;
    atns:sourceEntityId "2785"^^xsd:token ;
    atns:subcategory atns-subcat:1682bda6-86ad-57ab-b605-73fb7027939d ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """The NPY Women's Council 'Young women go to summer school' Shared Responsibility Agreement (SRAI is an initiatvie of the NPY (Ngaanyatjarra Pitjantjatjara Yankunytjatjara) Women's Council The Council wants young women on the NPY Lands to aspire to go to university.

Shared Responsibility Agreements are agreements between governments and Indigenous communities to provide discretionary funding in return for community obligations. The new arrangements developed from an initiative of the Council of Australian Governments and replace the previous ATSIC system of funding. For more information see ‘Shared Responsibility Agreement’ below."""@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:5996de0c-8cc6-5f14-8901-d839af36a4d4,
        atns-sub:6a8815da-e29d-506f-85fd-c64c8807fea2,
        atns-sub:99f93fc8-8a58-5ec5-a630-93b5790334b4,
        "Demo" ;
    schema:location "Ngaanyatjarra Pitjantjatjara Yankunytjatjara (NPY), NT, WA and SA, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=2785> ;
    schema:name "NPY Women's Council 'Young women go to summer school' Shared Responsibility Agreement (SRA)"@en ;
    schema:startDate "2005-01-01"^^xsd:date ;
    schema:text """Purpose

The SRA aims to foster young women's desire to further their education by exposing them to univesity life. The SRA provides a summer school whereby women can attend the University of Melbourne, stay on campus and experience city life.

Shared Responsibilities

The Commonwealth government provided $41,000 to fund travel to and from Melbourne. The government also funded a mentor to accompany the women.

The University of Melbourne arranged an intensive education program, which included the opportunity to meet future mentors. The women attended a first year law lecture, and met the Hon Justice Eames of the Court of Appeal, Legal Aid solicitor Paula King, and current indigenous students.

On return from Melbourne, the women who were selected to attend the summer school shared their experiences with other NPY women. The women discussed their experiences at settings such as the Women's Council, local schools and community radio. In line with the SRA, the women will also address the NPY Women's Council careers conference.

The NPY Women's Council 'Young women go to summer school' SRA was facilitated by the Alice Springs Indigenous Coordination Centre."""@en ;
    schema:url "http://www.indigenous.gov.au/sra/nt/fact_sheets/nt08.pdf"^^xsd:anyURI .

