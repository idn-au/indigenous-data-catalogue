        atns-sub:9e5e8f61-69be-5e2a-a9cd-58fb000349bd,
        "Demo" ;
    schema:location "Salte Ste. Marie, Canada"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=1949> ;
    schema:name "Robinson Treaties"@en ;
    schema:startDate "1850-09-07"^^xsd:date .

