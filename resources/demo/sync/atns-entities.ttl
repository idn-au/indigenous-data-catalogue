idn-resource:fd48c4b5-df0f-5b12-b7ef-66abc876d599 a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:1d8316a1-7080-5dfa-9e3e-ad8cdb3cb6e2 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
