idn-resource:b286f457-1c44-5b47-a6a5-bed7e2a9766c a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:3ca0ddb0-fb6e-5ac7-842e-abe8168af98a,
        idn-resource:5e21e784-fd7e-55b2-95bf-9871b867b413,
        idn-resource:fa6ad420-443e-51e3-bbe3-121d939ec876 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
