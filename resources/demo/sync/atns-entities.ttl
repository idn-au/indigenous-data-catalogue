idn-resource:f3e4443b-3d3c-569c-806b-c132315e99af a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A005735"^^xsd:token ;
    atns:sourceEntityId "5735"^^xsd:token ;
    atns:subcategory atns-subcat:caa3eeb7-4d71-505c-9ee9-19b8c5338435 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """Roberts on behalf of the Najig and the Guyanggan Nganawirdbird Groups v Northern Territory of Australia (No 3) [2012] FCA 255 is a consent determination

between:

Jessie Roberts (for and on behalf of the Najig and the Guyanggan Nganawirdbird Groups) (APPLICANT)

AND

Northern Territory of Australia (FIRST RESPONDENT)

Cave Creek Station Pty Ltd (SECOND RESPONDENT)

Judge: Finn J

Where made: Darwin

Determination:
Native title does not exist in any part of the Determination Area."""@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:c74e76ef-701f-5784-8223-5fcd87a7641c,
        atns-sub:dbff1607-a2a3-5baf-995d-8c9bb0552665,
        "Demo" ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=5735> ;
    schema:name "Roberts on behalf of the Najig and the Guyanggan Nganawirdbird Groups v Northern Territory of Australia [2012] FCA 255 (Mataranka)"@en ;
    schema:startDate "2012-03-20"^^xsd:date ;
    schema:text """The parties reached an agreement for the making of consent orders for a determination that native title does not exist over the Determination Area. As the parties reached this agreement themselves, the court found it unncessary to make their own inquiry as to the merits of the claims made.

The court held that it was appropriate to make the orders sought because:
- the Parties were legally represented
- the Northern Territory determined the extent of 'other interests' within the Determination Area and made these available to the Parties
- there are no other proceedings before the court concerning the area the subject of the Application
- the Northern Territory, in acting on behalf of the community generally, had regard to the requirements of the Act and conducted a thorough assessment process, and was satisfied that the determination is just in all the circumstances"""@en ;
    schema:url "http://www.austlii.edu.au/au/cases/cth/FCA/2012/255.html"^^xsd:anyURI .

idn-resource:f3e4e155-0ca1-57ff-9a8b-17e7288c1b8d a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:0d810569-899c-59c1-ae04-3309c06762e9 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
