        "Demo" ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=3923> ;
    schema:name "Alexkor - Richtersveld Joint Mining Venture"@en ;
    schema:startDate "2007-08-08"^^xsd:date .

