idn-resource:d89e1687-7770-56ec-9fe4-04408b4ed35a a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:61ae3aaa-0101-5ee9-a03b-41aa47929b6a,
        idn-resource:7b928a0d-47c5-537a-9136-066ae7f542f4 ;
