idn-resource:24c33c9b-2c6b-53db-9093-7c9fc6621e2f a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:638168bb-2586-5c5c-a29c-c2895fa02136,
        idn-resource:982596b4-297a-5a7a-b1c6-e84592224e9b ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
