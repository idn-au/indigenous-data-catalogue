idn-resource:f455863e-b9ca-5983-b29e-878c4f5ff314 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A005664"^^xsd:token ;
