idn-resource:e7744984-1679-5b9d-98aa-0185f889a1a8 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:244f6961-729f-5b21-8fc9-baff9dd9af7e ;
    atns:deleted false ;
    atns:eid "A001260"^^xsd:token ;
    atns:sourceEntityId "1716"^^xsd:token ;
    atns:subcategory atns-subcat:27bf4e20-d996-5e23-bbd6-03284f4b24e4 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description "The Ranger Uranium Project: Deed of Assignment (the Agreement) of the 12 September 1980 was entered into between the Commonwealth of Australia (the Commonwealth), Australian Atomic Energy Commission (AAEC) and Energy Resources of Australia Ltd (ERA). The Agreement gives effect to the sale and assignment by the Commonwealth of its share of concentrates of Ranger uranium ore and other mineral products and certain other rights and entitlements under the Government Agreement of 9 January 1979, to ERA. It also gives effect to the sale and assignment by AAEC of the whole of its enterprise under the Government Agreement, its rights, obligations and duties in and under the Management Agreement and the whole of its interest in the Authority (under Section 41 of the Atomic Energy Act 1953), to the ERA."@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:3302d162-15ce-5b7d-ad89-1f11c3cb6e0d,
        "Demo" ;
    schema:location "Ranger Project Area, Northern Territory, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=1716> ;
    schema:name "Ranger Uranium Project: Deed of Assignment (12 September 1980)"@en ;
    schema:startDate "1980-09-12"^^xsd:date ;
    schema:text """The Agreement was entered into at the same date as other Agreements entered into by the Commonwealth of Australia (the Commonwealth), Peko-Wallsend Operations Ltd (Peko), Electrolytic Zinc Company of Australasia Limited (EZ), the Australian Atomic Energy Commission (AAEC), Energy Resources of Australia Ltd (ERA) and Ranger Uranium Mines Pty Ltd (RUM) whereby some of the parties waived certain provisions under the Government Agreement of 9 January 1979, ERA undertook to perform and be bound by the terms of the Management Agreement of 9 January 1979 and RUM released and discharged some of the parties under the terms of that Management Agreement.

Under the Agreement ERA paid:

· To the Commonwealth - the sum of $125,000,000, with interest, for the sale and assignment to ERA of the Commonwealth’s entitlement to all concentrates of Ranger uranium ore and other rights and entitlements pursuant to the Government Agreement;
· To AAEC - a total amount of $104,306,767.70 together with interest, for the sale and assignment to ERA of, amongst other things, its rights, interests and obligations under the Government Agreement and the Management Agreement."""@en .

