        atns-sub:d15dd1de-4696-50c8-9f10-2e95eea88e6f,
        atns-sub:ef36130b-f525-5200-b398-93681fdc865b,
        "Demo" ;
    schema:location "South Australia, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=832> ;
    schema:name "Martirendi Agreement"@en ;
    schema:text "The Agreement covers issues relating to reconciliation, recognition, communication and participation, arts, culture and heritage, sport and recreation, employment, social services and national and regional links. It acknowledges that both Councils will work together to identify strategies to improve the well-being of the Aboriginal community."@en .

