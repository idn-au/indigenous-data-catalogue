idn-resource:d7cbd92b-2d27-54f9-87b3-62d09b3a1b7a a atns:Entity ;
    atns:category atns-cat:2d179b15-6fdb-5df4-ada6-b9214e6ed5e4 ;
    atns:deleted false ;
    atns:eid "A007452"^^xsd:token ;
