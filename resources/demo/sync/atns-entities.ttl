idn-resource:c8b9e579-618a-5125-8046-e843cdd90e2e a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A004462"^^xsd:token ;
    atns:sourceEntityId "4462"^^xsd:token ;
    atns:subcategory atns-subcat:09f0a068-ce65-5c11-8dec-f081d1a81ec2 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description "The Tagalaka - Croydon Area Indigenous Land Use Agreement #2 ('the ILUA') was agreed between the Croydon Shire Council (APPLICANT) and Billy Fortune, Johnny Miles, Joseph Callope, Alma Douglas, Beverly Bowyang, Gertie Douglas, Gladys Callope, Janet Busch, Clara Booth, Janette Owens, Maureen Douglas, the Tagalaka People and the North Queensland Land Council Native Title Representative Body Aboriginal Corporation on 11 February 2008. The purpose of the ILUA is to establish the process for dealing with future council works and activities in the area covered by the ILUA. The ILUA was registered on 11 February 2008 and does not have a stipulated period of operation."@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:9335b2f1-4915-55cc-9736-2ded7c4a2008,
        atns-sub:9c404ff9-19e6-5e64-a8bd-2e3b39773146,
        atns-sub:c74e76ef-701f-5784-8223-5fcd87a7641c,
        atns-sub:ffe61b3b-8b29-5264-89ac-758a03928ea5,
        "Demo" ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=4462> ;
    schema:name "Tagalaka - Croydon Area Indigenous Land Use Agreement (ILUA) #2"@en ;
    schema:startDate "2008-02-11"^^xsd:date ;
    schema:text """The parties to the ILUA consent to:

- no claims of compensation being made by the Native Title Parties in respect of the extinguishment or impairment of native title rights and interests by the construction or establishment of infrastructure as defined in the schedules to the agreement;
- the continued operation, use and maintenance of the non-extinguishing infrastructure, as well as the continued use of the land and waters on which the infrastructure is located or is adjacent and used in the operation and maintenance of the non-extinguishing infrastructure; and
- the operation, maintenance, use and dedication by the Minister of Roads within the ILUA area as at the commencement of the agreement.

The parties also agree that any future council works and activities will follow the process outlined in the ILUA."""@en .

