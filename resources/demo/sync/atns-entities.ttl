idn-resource:45ab922f-7fa2-5542-b9eb-5337f907a3e7 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A006305"^^xsd:token ;
