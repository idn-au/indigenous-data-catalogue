idn-resource:d702c38f-ab62-5907-9207-88e0078567f6 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A005928"^^xsd:token ;
