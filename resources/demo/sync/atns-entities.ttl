        "Demo" ;
    schema:location "Cooper Basin, Queensland, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=3444> ;
    schema:name "South-West Queensland Cooper Basin Exploration Agreement (Native Title Act) June 2005"@en ;
    schema:startDate "2005-06-01"^^xsd:date .

