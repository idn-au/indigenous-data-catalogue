    schema:location "West Cape York, Queensland, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=3392> ;
    schema:name "Nanum Tawap Timber Joint Venture Agreement"@en ;
    schema:startDate "2004-01-01"^^xsd:date .

