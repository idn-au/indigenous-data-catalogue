idn-resource:ce2f99e3-8dff-52bc-8582-1554c5107ecc a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A007039"^^xsd:token ;
