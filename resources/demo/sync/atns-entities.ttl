idn-resource:ca1aca68-ec80-52a1-8066-085a4d8a7db3 a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:8687d0bd-e6e6-59d2-a23c-a5fd3eff5653 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:244f6961-729f-5b21-8fc9-baff9dd9af7e ;
    atns:deleted false ;
    atns:eid "A002643"^^xsd:token ;
    atns:sourceEntityId "3033"^^xsd:token ;
    atns:subcategory atns-subcat:1682bda6-86ad-57ab-b605-73fb7027939d ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """The Mungullah Indigenous Community have established four priority goals to revitalise their community. These are:
- to improve living conditions;
- to promote healthy activities;
- to gain access to training programs;
- to access better employment opportunities.
As a means to reaching these goals, the Community has signed a Shared Responsibility Agreement (SRA) with the Commonwealth Government. The SRA provides new infrastructure for Mungullah.

Shared Responsibility Agreements are agreements between governments and Indigenous communities to provide discretionary funding in return for community obligations. The new arrangements developed from an initiative of the Council of Australian Governments and replace the previous ATSIC system of funding. For more information see ‘Shared Responsibility Agreement’ below."""@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:5996de0c-8cc6-5f14-8901-d839af36a4d4,
        atns-sub:d15dd1de-4696-50c8-9f10-2e95eea88e6f,
        atns-sub:ef36130b-f525-5200-b398-93681fdc865b,
        atns-sub:ffe61b3b-8b29-5264-89ac-758a03928ea5,
        "Demo" ;
    schema:location "Carnarvon, Western Australia, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=3033> ;
    schema:name "Mungullah 'Community Revitalisation' Shared Responsibility Agreement (SRA)"@en ;
    schema:startDate "2005-01-01"^^xsd:date ;
    schema:text """Purpose

The Mungullah SRA will improve local cultural, sport and recreation facilities by providing a Community Hall and sporting oval. The new facilities will be used for training programs and social events such as after-school programs, men's and women's groups, open air films, sporting competitions and leadership and governance programs.

Shared Responsibilities

The Commonwealth Government has committed between $657,300 (Factsheet 2005) and $627,310 (Indigenous Portal, 2007) towards the planning and construction of the new facilities. This funding will also be used to manage the hall in the future.

The Mungullah community will be involved in the construction of the Community Hall, where local Community Development Employment Projects (CDEP) participants will provide labour. A 'no school, no play' policy will be enforced by the community to encourage school attendance. The community will conduct monthly events to promote healthy lifestyles, and agree to support the events held at the facilities.

The Mungulla SRA is admistered by the Geraldton Indigenous Coordination Centre."""@en ;
    schema:url "https://apps.indigenous.gov.au/sra/search/DisplayDocuments.aspx?id=186&name=(Mungullah&title=Community%20Revitalisation&signDate=10-Jun-2005"^^xsd:anyURI .

