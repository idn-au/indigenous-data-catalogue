idn-resource:4147164c-902c-5ec5-8b53-1d352bd71aac a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:cc1eeeec-6bca-57ec-8012-b4d62d7c8ee7 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:244f6961-729f-5b21-8fc9-baff9dd9af7e ;
    atns:deleted false ;
    atns:eid "A002651"^^xsd:token ;
    atns:sourceEntityId "3041"^^xsd:token ;
    atns:subcategory atns-subcat:1682bda6-86ad-57ab-b605-73fb7027939d ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """The Ninga Mia Indigenous Community and the Commonwealth Government signed a Shared Responsibility Agreement in 2005 to improve local recreational facilities.

Shared Responsibility Agreements are agreements between governments and Indigenous communities to provide discretionary funding in return for community obligations. The new arrangements developed from an initiative of the Council of Australian Governments and replace the previous ATSIC system of funding. For more information see ‘Shared Responsibility Agreement’ below."""@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:5996de0c-8cc6-5f14-8901-d839af36a4d4,
        atns-sub:99f93fc8-8a58-5ec5-a630-93b5790334b4,
        atns-sub:ef36130b-f525-5200-b398-93681fdc865b,
        atns-sub:ffe61b3b-8b29-5264-89ac-758a03928ea5,
        "Demo" ;
    schema:location "Near Kalgoorlie, Western Australia, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=3041> ;
    schema:name "Ninga Mia 'Sport and Recreational Activities for Young People' Shared Responsibility Agreement (SRA)"@en ;
    schema:startDate "2005-01-01"^^xsd:date ;
    schema:text """Purpose

The SRA focuses on facilities for young people. Under the SRA, the basketball court will be renovated for use during warmer months, and ensures that young people have access to sporting and musical equipment.

Shared Responsibilities

The Commonwealth Government will provide $100,000 for the facilities upgrade and the new equipment.

The community at Ninga Mia will participate in the renovation and will maintain the facilities. Under the SRA, only children who attend school will be able to use the facilities; the community will enforce this 'no school, no play' policy. Coaching clinics, barbeques and music lessions will be organised by the community.

The Ninga Mia SRA is administered by the Kalgoorlie Indigenous Coordination Centre."""@en ;
    schema:url "http://www.indigenous.gov.au/sra/search/document.aspx?id=8171"^^xsd:anyURI .

