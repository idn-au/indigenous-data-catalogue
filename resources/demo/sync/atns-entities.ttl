        "Demo" ;
    schema:location "Vicinity of Mount Surprise, Queensland, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=1892> ;
    schema:name "Ewamian People Exploration Permit Backlog Project #2 Indigenous Land Use Agreement (ILUA)"@en ;
    schema:startDate "2003-10-07"^^xsd:date .

