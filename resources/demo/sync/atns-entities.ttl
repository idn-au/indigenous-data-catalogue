idn-resource:63eaff43-f172-5aef-8bb1-d1701f305c84 a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:46f7a5ae-63b9-5b45-b449-924646261be1,
        idn-resource:5eede912-f3fc-5334-b37b-c2ec3323169e ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A009179"^^xsd:token ;
