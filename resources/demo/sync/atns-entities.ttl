        atns-sub:c74e76ef-701f-5784-8223-5fcd87a7641c,
        "Demo" ;
    schema:location "Near Laverton, eastern goldfields, Western Australia, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=2638> ;
    schema:name "Crescent Gold Wongatha Land Access Agreement"@en ;
    schema:startDate "2005-03-01"^^xsd:date .

