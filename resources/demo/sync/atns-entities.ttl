    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:keywords atns-sub:b39d3bcb-b425-5b5d-b1f1-9735a7a6a23b,
        atns-sub:ffe61b3b-8b29-5264-89ac-758a03928ea5,
        "Demo" ;
    schema:name "Young and Conway v Chief Executive Officer, Housing [2020] NTSC 59"@en ;
