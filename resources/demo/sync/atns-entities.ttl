idn-resource:0c23d43e-24ee-5176-ae67-3e19ea6bfe12 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A007092"^^xsd:token ;
