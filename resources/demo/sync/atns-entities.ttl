idn-resource:bf5e43d2-f6ca-5af3-b440-b7b46bdbb716 a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:1c04dcc3-ea4f-5541-8758-922e3ffb4ef2,
        idn-resource:4b2aa137-ca81-5d14-ac6f-94ad796a8eca,
        idn-resource:6a5594e9-1b1f-55a5-9c28-ebe1374b03a4,
        idn-resource:6f8b65b3-a1a2-5a1f-b38c-583534410a12,
        idn-resource:8c091d8a-fac1-5fbc-b99a-c889488b8d1b ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
