idn-resource:7d61f2c6-b2d3-563a-bcf6-3f97d16503cb a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A008450"^^xsd:token ;
