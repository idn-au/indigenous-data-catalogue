idn-resource:dfdb34e5-136d-5512-aafc-ddc20e72bd9c a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:7b928a0d-47c5-537a-9136-066ae7f542f4 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:244f6961-729f-5b21-8fc9-baff9dd9af7e ;
    atns:deleted false ;
    atns:eid "A000697"^^xsd:token ;
    atns:sourceEntityId "1174"^^xsd:token ;
    atns:subcategory atns-subcat:09f0a068-ce65-5c11-8dec-f081d1a81ec2 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """The Dauan Island Indigenous Land Use Agreement (the ILUA) deals with the interests of Telstra Corporation on Dauan Island in the Torres Strait.

The native title holders have agreed that Telstra can conduct work on existing Telstra sites on the island, without notifying them. However, the ILUA states that '[t]his is not intended to affect Telstra's obligation to notify the Native Title Holders of its intention to enter the land or waters adjacent to any Existing Site if required to do so by Law'. Consent is also given for the grant or regrant of 'any Occupancy Agreement' to Telstra for the existing sites or for proposed '[c]onstruction of a Future Telecommunication Facility'."""@en ;
