idn-resource:ebaf51d0-cecc-5db5-9162-35fd9abf16c3 a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:05d02d3c-9c80-5367-8e05-902eb654f1c4 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
