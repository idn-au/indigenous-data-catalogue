idn-resource:a5a5d008-10f8-590d-8433-d218aa7e398f a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:7b928a0d-47c5-537a-9136-066ae7f542f4 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:244f6961-729f-5b21-8fc9-baff9dd9af7e ;
    atns:deleted false ;
    atns:eid "A002790"^^xsd:token ;
    atns:sourceEntityId "3175"^^xsd:token ;
    atns:subcategory atns-subcat:09f0a068-ce65-5c11-8dec-f081d1a81ec2 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """The Victorian Mining Licence 5435 Dja Dja Wurrung Indigenous Land Use Agreement (ILUA) was agreed between Mr Gary John Murray, Mr Robert Herbet Nicholls, Mr Rodney John Carter, Mr Graham John Atkinson, Ms Carmel Priscilla Barry, Ms Connie Harrison-Edwards on behalf on the Dja Dja Wurrung Native Title Group, Andrew Herbert Ayers and William Alexander Weetman on 23 December 2005.

The purpose of the ILUA is to validate the grant of Victorian Mining Licence 5435 to Andrew Herbert Ayers and William Alexander Weetman so as to allow small mining to take place on the ILUA area. The ILUA states that it will operate for the duration of the mining licence, unless the parties agree in writing that it should be terminated."""@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:3302d162-15ce-5b7d-ad89-1f11c3cb6e0d,
        atns-sub:c74e76ef-701f-5784-8223-5fcd87a7641c,
        "Demo" ;
    schema:location "Bendigo area, Victoria, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=3175> ;
    schema:name "Victorian Mining Licence 5435 Dja Dja Wurrung Indigenous Land Use Agreement (ILUA)"@en ;
    schema:startDate "2005-12-23"^^xsd:date ;
    schema:text """This ILUA includes agreement that 'future acts' may be done. The parties also agree that the right to negotiate provisions of the Native Title Act 1993 (Cth) do not apply to future acts, as the alternative consultation provisions are to be followed instead. Under this Act any activity, such as a grant of land, that may affect native title rights is defined as a ‘future act’ and must comply with the future act provisions of the Act in order to be valid.

The parties to the ILUA consent to the grant and use of the mining licence, and the doing of any act pursuant to that licence."""@en .

