idn-resource:97e0328b-4bdf-510b-bdbe-35fecb2ffbeb a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A005158"^^xsd:token ;
    atns:sourceEntityId "5158"^^xsd:token ;
    atns:subcategory atns-subcat:09f0a068-ce65-5c11-8dec-f081d1a81ec2 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description "This Indigenous Land Use Agreement (ILUA) was agreed between the Northern Territory of Australia Department of Lands and Planning, the Central Land Council and Bernard Pontiari Japalyi on behalf of the Jiyil and Yilyilimawu Gurindji Aboriginal people. The purpose of this ILUA is to confirm the extinguishment of native title rights over the ILUA area."@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:710c226b-1fba-5eba-86c9-5087f506ac80,
        atns-sub:dbff1607-a2a3-5baf-995d-8c9bb0552665,
        "Demo" ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=5158> ;
    schema:name "Lot 87 Town of Kalkarindji Indigenous Land Use Agreement (ILUA)"@en ;
    schema:startDate "2010-07-08"^^xsd:date ;
    schema:text """Pursuant to this ILUA, the parties agree that any native title rights over Lot 87 (the ILUA area) will be surrendered for extinguishment.

Furthermore, on behalf of the Jiyil and Yilyilimawu Gurindji Aboriginal people, Bernard Pontiari Japalyi agrees to grant a Crown Lease Term over Lot 87 to the Katherine West Health Board Aboriginal Corporation, with the lease being potentially convertible to freehold title over the land.

Right to negotiate

The parties also agree that the right to negotiate provisions in Subdivision P, Division 3, Part 2 of the Native Title Act 1993 (Cth) do not apply to any of the abovementioned acts."""@en ;
    schema:url "http://www.nntt.gov.au/Indigenous-Land-Use-Agreements/Search-Registered-ILUAs/ILUA%20Register/2010/DI2010.001/ILUARegisterExport.pdf"^^xsd:anyURI .

