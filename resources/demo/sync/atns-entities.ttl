        "Demo" ;
    schema:location "North of Meekatharra, Western Australia, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=432> ;
    schema:name "Nharnuwangga, Wajarri and Ngarlawangga Indigenous Land Use Agreement (ILUA)"@en ;
    schema:startDate "2001-07-05"^^xsd:date .

