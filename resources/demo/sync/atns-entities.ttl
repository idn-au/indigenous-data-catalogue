        atns-sub:c74e76ef-701f-5784-8223-5fcd87a7641c,
        atns-sub:e52a2091-dcda-569c-aafb-6497428c615c,
        "Demo" ;
    schema:location "Wickam Point, Darwin, Northern Territory, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=1614> ;
    schema:name "Larrakia and Phillips Oil Company Australia Agreement"@en ;
    schema:startDate "1999-01-01"^^xsd:date .

