idn-resource:d2e23597-c83e-5ae9-b8c6-f3cc0d8f3f0b a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
