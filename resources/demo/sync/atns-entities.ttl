idn-resource:d7616f41-4aa1-5d22-b215-eb65a9676cdc a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:fe81fd93-4219-53d3-a567-f80cb117404a ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
