idn-resource:623a1c3d-5c0a-5fc2-85a1-3377237ce8d9 a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:7b928a0d-47c5-537a-9136-066ae7f542f4 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:244f6961-729f-5b21-8fc9-baff9dd9af7e ;
    atns:deleted false ;
    atns:eid "A002852"^^xsd:token ;
    atns:sourceEntityId "3228"^^xsd:token ;
    atns:subcategory atns-subcat:09f0a068-ce65-5c11-8dec-f081d1a81ec2 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """The Mitakoodi Castlereagh Station Indigenous Land Use Agreement (ILUA) was agreed between Pearl Joyce Connelly on behalf of herself and the Mitakoodi people; and Ross John Kiernan and Adele Winsome Kiernan on 9 March 2006.

The purpose of the ILUA is to provide consent for the continuation of all activities which constitute the running of Castlereagh Station, including grazing, agriculture and irrigation. The ILUA consents to the doing of these acts whether or not they are ‘future acts’."""@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:bda82010-54a4-5bac-8bf5-4b5341822974,
        atns-sub:c74e76ef-701f-5784-8223-5fcd87a7641c,
        "Demo" ;
    schema:location "Cloncurry, Queensland, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=3228> ;
    schema:name "Mitakoodi Castlereagh Station Indigenous Land Use Agreement (ILUA)"@en ;
    schema:startDate "2006-03-09"^^xsd:date ;
    schema:text """The ILUA provides for the doing of all acts which are “substantially the same” as those already being done to run Castlereagh Station. This includes any future decision or recommendation changing, issuing or extending any non-freehold land tenure, or any licence, permit, authority or approval. The ILUA also provides for the Mitakoodi People to access and use the agreement area for traditional activities.

The ILUA includes agreement that 'future acts' may be done. The parties also agree that the right to negotiate provisions of the Native Title Act 1993 (Cth) do not apply, as the alternative consultation provisions are to be followed instead. Under this Act any activity, such as a grant of land, that may affect native title rights is defined as a ‘future act’ and must comply with the future act provisions of the Act in order to be valid."""@en .

