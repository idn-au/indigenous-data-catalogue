idn-resource:6cfad761-a25a-577f-ac03-7c8445239fa3 a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:4be1244b-2872-5199-8ba6-8c25fb02095d,
        idn-resource:f5f5c72d-1528-5eaf-9d34-2f09e6eea622 ;
