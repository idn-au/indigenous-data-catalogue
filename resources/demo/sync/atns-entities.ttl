        atns-sub:9c404ff9-19e6-5e64-a8bd-2e3b39773146,
        atns-sub:c74e76ef-701f-5784-8223-5fcd87a7641c,
        "Demo" ;
    schema:location "Victoria, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=2151> ;
    schema:name "Pro forma section 31 Deed for Petroleum Production Licences (Victoria)"@en ;
    schema:url "http://www.dpi.vic.gov.au/dpi/nrenmp.nsf/FID/-771FC61DA38AADE74A256A72001EF70E?OpenDocument"^^xsd:anyURI .

