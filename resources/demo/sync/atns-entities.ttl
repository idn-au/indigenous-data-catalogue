        atns-sub:bda82010-54a4-5bac-8bf5-4b5341822974,
        atns-sub:c74e76ef-701f-5784-8223-5fcd87a7641c,
        "Demo" ;
    schema:location "Queensland, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=1972> ;
    schema:name "Ewamian People Pastoral Memoranda of Understanding (MoU)"@en ;
    schema:startDate "2004-01-01"^^xsd:date .

