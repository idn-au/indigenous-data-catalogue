        idn-resource:1fd317fa-464d-5e63-9011-5035064a311d,
        idn-resource:2c75a9d7-a016-5ea1-b703-821b79ccf8b2,
        idn-resource:323e9c01-0c1c-5895-a7fc-b731652f7dfc,
        idn-resource:6d54e5bb-d8bc-53ec-b3c5-aa16776ebf0d,
        idn-resource:a1b59920-9631-5202-8b5f-67357ba6212e,
        idn-resource:a5a1be48-3fc7-5db8-9b78-14779b90d4f0,
        idn-resource:ce5c2d1e-1e1e-59a0-ad51-5b0f8e463cdd,
        idn-resource:d2ad0b15-f258-5f1e-a58e-46b04166ae4a,
        idn-resource:ddd5f481-e8ab-50fb-8a1c-493099e4dbba,
        idn-resource:e2a68b4c-34f2-57bf-ad7b-9f385cde5652 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
