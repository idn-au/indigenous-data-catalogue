idn-resource:2bca6bc8-745b-5e3a-b374-8ac06dec0f4b a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:4e0d3dd4-8ff7-59ac-b398-1fd1ae8ef48c,
        idn-resource:b44a65bd-b07b-5b71-8e7e-5a79e1b2c0ec ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:244f6961-729f-5b21-8fc9-baff9dd9af7e ;
    atns:deleted false ;
    atns:eid "A002901"^^xsd:token ;
    atns:sourceEntityId "3277"^^xsd:token ;
    atns:subcategory atns-subcat:09f0a068-ce65-5c11-8dec-f081d1a81ec2 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """The Nyikina Mangala and Shire of Derby-West Kimberley Indigenous Land Use Agreement (ILUA) was signed after three years of negotiations between local government and the Nyikina Mangala people, assisted by the Kimberley Land Council (Talking Native Title 2005). Since March 2004, these negotiations were conducted through the Nyikina Mangala and Shire of Derby-West Kimberley Native Title Process Agreement. The purpose of the ILUA is to provide long-term social and economic benefits for the Nyikina and Mangala people through cooperation in relation to land usage and community issues (National Native Title Tribunal 2005). Kimberley Land Council Chairman Tom Birch stated that '[t]his ILUA is the first between Indigenous people and a local government authority in the Kimberley, and it marks a significant step towards much better relationships.'

This ILUA is registered on the National Native Title Tribunal Register of Indigenous Land Use Agreements."""@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:17d993e0-d19e-5349-a48e-4de57b1dba59,
        atns-sub:29221ef9-81d0-59aa-a9c9-744b71ff8349,
        atns-sub:5996de0c-8cc6-5f14-8901-d839af36a4d4,
        atns-sub:d15dd1de-4696-50c8-9f10-2e95eea88e6f,
        "Demo" ;
    schema:location "Shire of Derby, Western Australia, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=3277> ;
    schema:name "Nyikina Mangala and Shire of Derby-West Kimberley Indigenous Land Use Agreement (ILUA) (19 October 2005)"@en ;
    schema:startDate "2005-10-19"^^xsd:date ;
    schema:text """The ILUA deals with land usage issues, such as "town and district planning schemes, capital works and infrastructure and management of reserves" (Talking Native Title 2005). It sets out processes for the Shire to follow when, for example, carrying out road works within the Nyikina Mangala people's claim area (National Native Title Tribunal 2005). These include protocols for Aboriginal cultural heritage management.

Shire President Cr Elsia Archer stated that the ILUA "forms the basis for cooperative working relationships about cultural and community matters, including the delivery of services to Indigenous communities"."""@en .

