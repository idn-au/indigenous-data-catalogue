idn-resource:090223ec-287a-54c0-9e60-03a8862e4fee a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A004385"^^xsd:token ;
