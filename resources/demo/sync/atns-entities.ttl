idn-resource:20ffd5a9-3072-5ad8-a0ed-aedee59ee06b a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A006475"^^xsd:token ;
