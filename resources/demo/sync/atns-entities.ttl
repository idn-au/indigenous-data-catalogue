idn-resource:2801d8ae-11c5-507e-b066-ddc576bb30f1 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A004724"^^xsd:token ;
    atns:sourceEntityId "4724"^^xsd:token ;
    atns:subcategory atns-subcat:09f0a068-ce65-5c11-8dec-f081d1a81ec2 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """The Kalkadoon Industrial Estate Indigenous Land Use Agreement (ILUA) was concluded between the State of Queensland (APPLICANT) and William Doyle, Noelene Dempsey, Ilona Parter, Sonny Codren, Hazel Munro, Sue Samardin Jr, Pat Kyle, Connie Cragie and Doug Bruce on their own behalf and on behalf of the Kalkadoon People. The agreement was registered with the National Native Title Tribunal (NNTT) on 13 June 2008.

The purpose of the agreement is to extinguish native title over the surrender area for the purpose of industrial development within three areas of the Mount Isa region."""@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:29221ef9-81d0-59aa-a9c9-744b71ff8349,
        atns-sub:4f924c21-9e16-51f1-823e-8944b84c7142,
        atns-sub:c74e76ef-701f-5784-8223-5fcd87a7641c,
        atns-sub:dbff1607-a2a3-5baf-995d-8c9bb0552665,
        "Demo" ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=4724> ;
    schema:name "Kalkadoon Industrial Estate Indigenous Land Use Agreement (ILUA)"@en ;
    schema:startDate "2008-06-13"^^xsd:date ;
    schema:text """The Areas covered by the Kalkadoon Industrial Estate ILUA include the Kalkadoon, Nordale and Mica Creek Areas as defined within the agreement.

The parties agreed to the surrender of any negotiation rights and any native title regarding the surrender area. However, the non-extinguishment principle applies to future acts so that any act that would extinguish native title will only temporarily suspend it."""@en .

