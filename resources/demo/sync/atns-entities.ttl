idn-resource:e91c276e-afa1-5bc1-9330-5216da4a6387 a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:78cb973d-0e69-5ebc-a978-a7ee480e9080,
        idn-resource:fa841eb8-e7a6-5988-9e4e-66a4988f9ab7 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:244f6961-729f-5b21-8fc9-baff9dd9af7e ;
