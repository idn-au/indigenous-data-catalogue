idn-resource:da387dde-e4e1-5b88-9acb-51c2b87f070c a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A007179"^^xsd:token ;
    atns:sourceEntityId "7179"^^xsd:token ;
    atns:subcategory atns-subcat:c97ff061-87de-5580-9efc-4dd4eb83f378 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """The Agreement on South Australian Aboriginal Health and Wellbeing 2010-2015 ('the Agreement') was agreed in 2010 expiring 30 June 2015 to work collaboratively to improve health outcomes for Aboriginal and Torres Strait Islander people in South Australia. This Agreement continues on from agreements initially agreed in 1996 and renewed in 2001 and 2005.

Signatories:
- State of South Australia
- Australian Government
- Aboriginal Health Council of South Australia"""@en ;
    schema:endDate "2015-06-30"^^xsd:date ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:d15dd1de-4696-50c8-9f10-2e95eea88e6f,
        "Demo" ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=7179> ;
    schema:name "Agreement on South Australian Aboriginal Health and Wellbeing 2010-2015"@en ;
    schema:text """Acknowledging the health inequality between Aboriginal and non-Aboriginal people and the community-controlled sector’s experience and capability in delivering primary health care to Aboriginal and Torres Strait Islander people, the State and Commonwealth Governments agree to work together with the Aboriginal Health Council of South Australia.

The areas parties agree to work collaboratively include:
- Improving access to health services for Aboriginal and Torres Strait Islander people;
- Addressing the emerging health issues of the Aboriginal and Torres Strait Islander community; and
- Identifying pertinent issues and response areas.

The parties share the responsibility for meeting the health and wellbeing improvement objectives of the Agreement, while maintaining their existing individual roles and responsibilities.

Annual reporting is required by all parties to the South Australian Aboriginal Health Partnership, with the SAAHP reporting annually to the Australian Health Ministers’ Conference."""@en ;
    schema:url "http://www.sahealth.sa.gov.au/wps/wcm/connect/9bf20380434beac79a37deba9c78a5ba/Agreement+on+SAAHW.pdf?MOD=AJPERES&CACHEID=9bf20380434beac79a37deba9c78a5ba"^^xsd:anyURI .

