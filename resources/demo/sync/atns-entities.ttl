idn-resource:8e93da74-f341-50e5-8caf-a40e12f2dc98 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A004472"^^xsd:token ;
    atns:sourceEntityId "4472"^^xsd:token ;
    atns:subcategory atns-subcat:51e799aa-68a2-5df5-b3b6-ce3837c24612 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description "The Umbrella Final Agreement between the Government of Canada (represented by the Minister of Indian Affairs and Northern Development), the Government of the Yukon (represented by the Government Leader), and the Yukon First Nations (represented by the Chairperson of the Council for Yukon Indians) was signed on 29 May 1993. The Agreement provides a framework for the negotiation of agreements between the Government of Canada, the Government of the Yukon and each of the Yukon First Nations and signifies their mutual intention to negotiate Yukon First Nation Final Agreements in accordance with the Umbrella Final Agreement. It contains a commitment by all parties to recognise and protect the way of life of the first nations of the Yukon and to encourage and protect the cultural distinctiveness and social well-being of the First Nations peoples."@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:17d993e0-d19e-5349-a48e-4de57b1dba59,
        atns-sub:1ec05be0-16ac-52de-bf3b-54bec0211332,
        atns-sub:29221ef9-81d0-59aa-a9c9-744b71ff8349,
        atns-sub:3302d162-15ce-5b7d-ad89-1f11c3cb6e0d,
        atns-sub:51637aba-8d5a-5309-abd9-b42fbe3ec733,
        atns-sub:51ca8813-b7bb-5a37-819e-afae35771fff,
        atns-sub:5996de0c-8cc6-5f14-8901-d839af36a4d4,
        atns-sub:6dbc2651-9cf2-58ba-a929-248a3b0b9e86,
        atns-sub:7cc37d9a-fe3c-5fec-b115-d1bb8d72db9c,
        atns-sub:81edd075-cb8e-5a7e-a65d-a47cec815898,
        atns-sub:8afa6040-57f6-5faf-a4f9-863bd8f4f470,
        atns-sub:9468ab8c-2b3a-54c2-b5e8-88e552bdd046,
        atns-sub:b39d3bcb-b425-5b5d-b1f1-9735a7a6a23b,
        atns-sub:b5868ee2-df76-5e62-ae92-ff325f5dbc01,
        atns-sub:dc50c698-80b0-5ef4-bd95-928f2be8da05,
        atns-sub:f630e08a-ea9c-57e3-ab87-066e4b9ad57e,
        atns-sub:ff4e6e61-8ae5-5b37-b306-00502be1d9d6,
        "Demo" ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=4472> ;
    schema:name "Umbrella Final Agreement between the Government of Canada, The Council for Yukon Indians and the Government of the Yukon"@en ;
    schema:startDate "1993-05-29"^^xsd:date ;
    schema:text """The Agreement states that all Final Agreements in the Yukon will contain provisions over the following:
o General Provisions relating to the Agreement
o Eligibility and Enrolment in the First Nation
o Reserves and Land Set Aside for the First Nation
o Tenure and Management of Settlement Land
o Access to land
o Expropriation of land
o Surface Rights
o Settlement Land Amount
o Special Management Areas
o Land Use Planning
o Development Assessment
o Heritage
o Water Management
o Definition of Boundaries and Measurement of Areas of Settlement Land
o Fish and Wildlife
o Forest Resources
o Non-Renewable Resources
o Financial Compensation
o Taxation
o Taxation of Settlement Land
o Economic Development Measures
o Resource Royalty Sharing
o Yukon Indian Self-Government
o Transboundary Agreements
o Dispute Resolution
o Yukon Fish and Wildlife Enhancement Trust
o Implementation and Training for Settlement Implementation

Each final Agreement therefore tailors these provisions to the particular agreed terms reached during negotiations."""@en ;
    schema:url "http://www.ainc-inac.gc.ca/pr/agr/umb/index_e.html"^^xsd:anyURI .

idn-resource:8e940fa5-61d0-5f2b-a53d-366b30a8e880 a atns:Entity ;
    atns:category atns-cat:2d179b15-6fdb-5df4-ada6-b9214e6ed5e4 ;
