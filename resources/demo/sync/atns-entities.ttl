idn-resource:97493400-85c1-51cf-bfba-f560a0b6dd9e a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A004592"^^xsd:token ;
    atns:sourceEntityId "4592"^^xsd:token ;
    atns:subcategory atns-subcat:09f0a068-ce65-5c11-8dec-f081d1a81ec2 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """The Ewamian-Etheridge Shire Area Indigenous Land Use Agreement (ILUA) No. 3 was agreed between the Etheridge Shire Council (APPLICANT) and Barry Fisher, David Hudson, Noel Lacey and Ron Richards on 25 February 2008.

The purpose of the ILUA is to detail the relationship between native title rights and interests and the interests of the Etheridge Shire Council in the area covered by the ILUA, and includes provisions for the implementation of cultural heritage clearance protocol.

The ILUA was registered on 25 February 2008, and does not have a stipulated period of operation."""@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:06f9cf03-2d66-5dfe-807c-b7632b2ea564,
        atns-sub:17d993e0-d19e-5349-a48e-4de57b1dba59,
        atns-sub:9c404ff9-19e6-5e64-a8bd-2e3b39773146,
        atns-sub:c74e76ef-701f-5784-8223-5fcd87a7641c,
        atns-sub:ffe61b3b-8b29-5264-89ac-758a03928ea5,
        "Demo" ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=4592> ;
    schema:name "Ewamian - Etheridge Shire Area Indigenous Land Use Agreement (ILUA) No. 3"@en ;
    schema:startDate "2008-02-25"^^xsd:date ;
    schema:text """The parties to the ILUA consent to:

• the continued operation, use and maintenance of specific infrastructure and Council Roads;
• no compensation claims by the Native Title Parties put to the Council in respect to the extinguishment, diminishment or impairment of native title rights or interests by the construction of infrastructure or the operation, maintenance and use of roads in the area covered by the Agreement; and
• the dedication of a community purpose reserve under the Land Act 1994 (Qld) for sport and recreation purposes over the Forsayth Trucking Reserve, with the Etheridge Council appointed as trustee."""@en ;
    schema:url "http://www.nntt.gov.au/Indigenous-Land-Use-Agreements/Search-Registered-ILUAs/Pages/Ewamian-Etheridge_Shire_Area_ILUA_No_3_Q.aspx"^^xsd:anyURI .

