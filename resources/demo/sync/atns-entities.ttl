idn-resource:c26fbff2-d859-5bfd-b5ff-fcbf2032bc59 a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:dcb0ffe6-ead8-5160-bbb4-9016b96fde0a ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:244f6961-729f-5b21-8fc9-baff9dd9af7e ;
    atns:deleted false ;
    atns:eid "A001722"^^xsd:token ;
    atns:sourceEntityId "2158"^^xsd:token ;
    atns:subcategory atns-subcat:51e799aa-68a2-5df5-b3b6-ce3837c24612,
        atns-subcat:e25306cd-559a-5d5a-8a28-e66ca2c2323a ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description "The Model Exploration and Mining Agreement is a template agreement intended to be entered into between De Beers Australia Exploration Ltd, Local Aboriginal Groups (being those Aboriginals who have or claim Native Title in the area subject to the Application for Exploration) and the Northern Land Council. The objectives of the Agreement are to enable grant to De Beers of Exploration Licences in a manner not inconsistent with the rights and interests of the Local Aboriginal Groups. The Agreement is intended to ensure that exploration is undertaken in such a way that it accords understanding and respect according to Aboriginal tradition for the interests of the Local Aboriginal Groups and their members affected by the exploration; minimises the deleterious impact upon the Local Aboriginal Groups, their members and the environment; and contributes to the social and economic well-being of the Local Aboriginal Groups."@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:17d993e0-d19e-5349-a48e-4de57b1dba59,
        atns-sub:3302d162-15ce-5b7d-ad89-1f11c3cb6e0d,
        atns-sub:35e19906-2659-5157-8aee-b9d82eedbb1c,
        atns-sub:51ca8813-b7bb-5a37-819e-afae35771fff,
        atns-sub:9c404ff9-19e6-5e64-a8bd-2e3b39773146,
        atns-sub:b9cb4d2e-5a5b-57ae-a2ac-5450c37a61d8,
        atns-sub:e52a2091-dcda-569c-aafb-6497428c615c,
        "Demo" ;
    schema:location "Northern Territory, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=2158> ;
    schema:name "Model Exploration Agreement between De Beers Australia Exploration Ltd and Northern Land Council"@en ;
    schema:startDate "2002-05-22"^^xsd:date ;
    schema:text """The template agreement establishes a procedure for dealing with ELAs on 57 of De Beers' tenement applications covering 82,833 square kilometres.

The template agreement ‘provides for protection of sacred sites and cultural areas; protection for the environment; consultation with traditional owners; compensation in the form of community benefits regarding exploration; and parameters for any future mining agreement should exploration prove successful’ (Northern Land Council, ‘MOUs smooth explorers’ path in Top End’ (Media Release, 5 June 2002)).

If they so desire, native title holders have the right to negotiate agreements outside the terms and conditions of the template agreement."""@en .

