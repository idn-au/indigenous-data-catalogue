idn-resource:c296034e-c770-5c39-b0ce-fb8165b0810a a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A005306"^^xsd:token ;
