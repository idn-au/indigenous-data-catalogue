idn-resource:08d4e101-63ba-5df3-a7d9-48b5ca55bd1b a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A007110"^^xsd:token ;
