    atns:eid "A001025"^^xsd:token ;
    atns:sourceEntityId "1492"^^xsd:token ;
    atns:subcategory atns-subcat:107a111f-ec77-5bc3-8410-8bc0fade0403,
        atns-subcat:27bf4e20-d996-5e23-bbd6-03284f4b24e4,
