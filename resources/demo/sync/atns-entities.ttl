idn-resource:436a2008-3a92-5bdd-b39a-545a0588cb06 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A006459"^^xsd:token ;
