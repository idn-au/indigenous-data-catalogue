idn-resource:c9492446-6485-58c9-9bf4-787cd73f341a a atns:Entity ;
    dcterms:references idn-resource:3d4afede-759a-5fd3-85e4-445d2bbc7875,
        idn-resource:50e580ea-9f3b-54ed-ba31-d39a810f2217,
        idn-resource:8065c3e2-2847-595d-b96b-4b39c5ab0d7c ;
