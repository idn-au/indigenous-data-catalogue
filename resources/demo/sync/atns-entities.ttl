        "Demo" ;
    schema:location "Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=1659> ;
    schema:name "Agreement on National Indigenous Housing Information"@en ;
    schema:startDate "1999-12-01"^^xsd:date ;
    schema:url "http://www.aihw.gov.au/publications/hou/anihi/anihi.pdf"^^xsd:anyURI .

