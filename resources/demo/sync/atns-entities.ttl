idn-resource:bce3755c-0420-5084-bf30-73300164993b a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A005572"^^xsd:token ;
    atns:sourceEntityId "5572"^^xsd:token ;
    atns:subcategory atns-subcat:09f0a068-ce65-5c11-8dec-f081d1a81ec2 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """This agreement is between the State of Queensland and Gordon James Jacko on behalf of the Junnyjuwarra People.

The purpose of the agreement is to provide consent to a number of future acts."""@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:29221ef9-81d0-59aa-a9c9-744b71ff8349,
        atns-sub:9c404ff9-19e6-5e64-a8bd-2e3b39773146,
        "Demo" ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=5572> ;
    schema:name "Munburra Indigenous Land Use Agreement (ILUA)"@en ;
    schema:startDate "2011-03-16"^^xsd:date ;
    schema:text """Content of the ILUA
The majority of the agreement has not been released by the National Native Title Tribunal. The information that has been released relates to future acts.

The parties have consented to the doing of the following future acts:
- the grant of the Proposed Area as Aboriginal Land to the Juunyjuwarra Aboriginal Corporation Land Trust;
- the grant of any Mining Lease Areas and any Mining Application Areas as Aboriginal Land to the Juunyjuwarra Aboriginal Corporation Land Trust or Juunyjuwarra Aboriginal Corporation;
- entering into an access route agreement;
- Juunyjuwarra Aboriginal Corporation Land Trust and Murray Pringle Hoy entering into the Airstrip Agreement.

Background to the ILUA
The Juunyjuwarra People filed their Application for native title in the Federal Court of Australia in 1999. The connection report was filed in 2007 and the parties are now in mediation.

The Juunyjuwarra Aboriginal Corporation was formed in 2010 and Gordon James Jacko is a member of that corporation."""@en ;
    schema:url "http://www.nntt.gov.au/Indigenous-Land-Use-Agreements/Search-Registered-ILUAs/ILUA%20Register/2011/QI2011.018/ILUARegisterExport.pdf"^^xsd:anyURI .

idn-resource:bceb7619-929d-5d20-8117-d843476b5d7a a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A007126"^^xsd:token ;
    atns:sourceEntityId "7126"^^xsd:token ;
