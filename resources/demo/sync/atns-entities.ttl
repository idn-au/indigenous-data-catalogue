        atns-sub:c74e76ef-701f-5784-8223-5fcd87a7641c,
        atns-sub:e52a2091-dcda-569c-aafb-6497428c615c,
        "Demo" ;
    schema:location "Victoria, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=2145> ;
    schema:name "Pro forma Project Consent Deed for Mining Licences (Victoria)"@en ;
    schema:url "http://www.dpi.vic.gov.au/dpi/nrenmp.nsf/FID/-771FC61DA38AADE74A256A72001EF70E?OpenDocument"^^xsd:anyURI .

idn-resource:eb10ad9e-0e28-5cd1-83a3-793b68d6f89b a atns:Entity,
        schema:CreativeWork ;
