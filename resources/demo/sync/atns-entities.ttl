idn-resource:f9cc1446-14c3-5848-9f58-73f578438073 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A006189"^^xsd:token ;
