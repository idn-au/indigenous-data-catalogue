idn-resource:90605747-5b80-582b-81e9-05eb8dc7d2ac a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A006749"^^xsd:token ;
