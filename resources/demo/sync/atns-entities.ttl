idn-resource:01216b30-9767-5045-9b39-e5eed910fd60 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A007284"^^xsd:token ;
    atns:sourceEntityId "7284"^^xsd:token ;
    atns:subcategory atns-subcat:09f0a068-ce65-5c11-8dec-f081d1a81ec2 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """This is an Agreement between the Banjima People and BHP Billiton. This ILUA was registered on 8 February 2018. The purpose of the ILUA is to provide consent for acts, whether or not they are 'future acts', related to exploration and mining activities and interests in the area. The agreement area is within the external boundary of the claim area for the Banjima People.

The Yamatji Marlpa Aboriginal Corporation is the native title provider for this ILUA."""@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:3302d162-15ce-5b7d-ad89-1f11c3cb6e0d,
        atns-sub:9335b2f1-4915-55cc-9736-2ded7c4a2008,
        atns-sub:c74e76ef-701f-5784-8223-5fcd87a7641c,
        "Demo" ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=7284> ;
    schema:name "Initial Indigenous Land Use Agreement - Banjima and BHP Billiton Comprehensive Agreement (Body Corporate Agreement) ILUA"@en ;
    schema:spatialCoverage <https://data.idnau.org/pid/nntt/WI2015-021> ;
    schema:startDate "2016-02-08"^^xsd:date ;
    schema:text """Details of the Agreement: The ILUA covers about 8049 sq kilometres, approximately 74 kilometres northwest of Newman. The local governments associated with this ILUA are the Shires of Ashburton and East Pilbara and the Town of Port Hedland.

Commencement: The ILUA commenced on 28 October 2015 and registered with the National Native Title Tribunal on 8 February 2016. The agreement ends when the parties agree or the agreement is removed from the Register of ILUAs.

Native Title Provisions: The ILUA has statements that reference subsection 24EB(1) or 24EBA(1) or (4) of the Native Title Act 1993 (Cth).

Native Title in the ILUA Area: The ILUA is in the native title claim area which includes the land and waters the subject of Banjima People v State of Western Australia (No 3) [2014] FCA 201."""@en ;
    schema:url "http://www.nntt.gov.au/searchRegApps/NativeTitleRegisters/Pages/ILUA_details.aspx?NNTT_Fileno=WI2015/021"^^xsd:anyURI .

