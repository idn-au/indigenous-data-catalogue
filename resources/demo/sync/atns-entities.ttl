idn-resource:05eeeae5-8906-5b73-9514-3f76767f39ca a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:14996496-34f5-5ee5-9c20-492a47c35d60 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A004625"^^xsd:token ;
    atns:sourceEntityId "4625"^^xsd:token ;
    atns:subcategory atns-subcat:1b340bb0-e40e-5938-a6a5-34a49cd07960 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """The Memorandum of Understanding to Establish the Building Solid Families (BSF) Program ('the MOU') was signed on 5 July 2000 by the Western Australian Department of Health and the Aboriginal Torres Strait Islander Commission (ATSIC).

On 1 July 2004, following the dissolution of ATSIC, the BSF Program was transferred to the Commonwealth Office of Aboriginal Torres Strait Islander Health (Department of Health and Ageing)."""@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:5996de0c-8cc6-5f14-8901-d839af36a4d4,
        atns-sub:d15dd1de-4696-50c8-9f10-2e95eea88e6f,
        "Demo" ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=4625> ;
    schema:name "Memorandum of Understanding to Establish the Building Solid Families Program"@en ;
    schema:startDate "2000-07-05"^^xsd:date ;
    schema:text """The purpose of the MOU is to create a 'one stop shop that provides a comprehensive information and support service to support mental health, social and emotional well-being for Aboriginal and Torres Strait Islander individuals, families and communities' (Department of Health, WA, 2007). The BSF Program aims to target persons affected by family separation, mental health problems and those at risk of self harm (especially youth). It is one of a range of measures seeking to address recommendations from the Bringing Them Home Report.

The Program’s services will include:

• Counselling, referrals, and longer-term case management;
• Coordination of family reunions and related support;
• Providing assistance with the retrieval of family information from Department of Indigenous Affairs and other government and non-government agencies; and,
• Raising awareness of BSF."""@en ;
    schema:url "http://www.aboriginal.health.wa.gov.au/docs/Building_Solid_Families_Program.pdf"^^xsd:anyURI .

