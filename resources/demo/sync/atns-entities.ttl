idn-resource:ee721308-d82c-5271-bec8-b6a20a7377d2 a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:2a967f62-98de-5c61-a293-817c4de5408d,
        idn-resource:35918041-4bc5-5530-a455-9d63bf1dd660,
        idn-resource:3e1d155e-82ca-5e33-b2a7-4f094ff464eb,
        idn-resource:75adba56-f248-5541-b85e-8ac71d3f4055,
        idn-resource:de63cd81-e373-56df-94f9-eb8e353c722e ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:244f6961-729f-5b21-8fc9-baff9dd9af7e ;
    atns:deleted false ;
    atns:eid "A003125"^^xsd:token ;
    atns:sourceEntityId "3501"^^xsd:token ;
    atns:subcategory atns-subcat:1b340bb0-e40e-5938-a6a5-34a49cd07960 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """Raukkan Community Council and the Coorong District Council Alliance (‘the Alliance’) was finalised and endorsed in mid 2005. The agreement is made between Trish Barrett on behalf of the Raukkan Community Council, and Mayor Neville Jaensch on behalf of the Coorong District Council.

The Alliance does not represent a legally binding agreement but instead intends to build on ‘the existing cooperative working relationship between the Councils on matters of shared interest.’

The purpose of the Alliance is to:

• Encourage ‘dialogue and…promote mutual respect between the parties’;
• Provide a mechanism through which the parties can discuss options for flexible local government service delivery; and
• Emphasise coordinated planning strategies, with the aim of fostering regional economic development.

The Alliance is based on numerous principles, including respect for and recognition of ‘cross cultural differences and aspirations’; and ‘mutual recognition of the varying roles and functions of the [parties]... in both service delivery and accountabilities.’ In particular, the areas that the Alliance targets are: representation and decision making; strategic planning; services and infrastructure; leadership; economic development; and culture.

The Alliance is to be implemented by a joint Working Group, made up of members of both parties, who will meet regularly and report to their respective councils. The Alliance’s Schedule of Priorities for 2005/2006 includes:

• Opportunities for leadership and economic development, which includes securing long term local employment opportunities;
• Special occasions and events, including celebrating cultural heritage and joint naming of places; and
• Services and infrastructure, including the sealing of Poltalloch Road."""@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:06f9cf03-2d66-5dfe-807c-b7632b2ea564,
        atns-sub:17d993e0-d19e-5349-a48e-4de57b1dba59,
        atns-sub:5996de0c-8cc6-5f14-8901-d839af36a4d4,
        atns-sub:9073e633-80a9-5ba7-8892-f556bd0a0612,
        "Demo" ;
    schema:location "South Australia, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=3501> ;
    schema:name "Raukkan Community Council and Coorong District Council Agreement"@en ;
    schema:startDate "2005-07-01"^^xsd:date ;
    schema:text """The Alliance was negotiated by a working party made up of members of both the Raukkan Community Council and the Coorong District Council;- it represents a pilot model for the Local Government Services Agreement Project, an initiative of the Department for Aboriginal Affairs and Reconciliation and the Office of Local Government.

The two parties have put out a document titled ‘The Story of Our Journey’ in order to assist other Councils and Indigenous communities in similar negotiations. They have also allowed working documents to be accessed, including:

• Terms of Reference for the Alliance Agreement
• Model Framework and Process Guidelines
• Project Workshop Outcomes – Developing the Strategy

These documents can be accessed under the ‘Published Resources’ link below."""@en .

idn-resource:ee7876fd-04b4-59f9-8347-221f9a3d1615 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A004725"^^xsd:token ;
    atns:sourceEntityId "4725"^^xsd:token ;
    atns:subcategory atns-subcat:09f0a068-ce65-5c11-8dec-f081d1a81ec2 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """The Pilbara Iron - Eastern Guruma Body Corporate Indigenous Land Use Agreement was concluded between Hamersley Iron Pty Ltd (APPLICANT), Robe River Mining Company, the State of Western Australia, the Wintawari Guruma Aboriginal Corporation and Nelson Hughes, Eva Connors, Kenzie Smith, Tanya Stevens, Edna Hughes, Judith Hughes, Jocelyn Hicks, Dennis Hicks, Samantha Gonnors, Wayne Stevens, Gladys Walker and Sue Boyd (Eastern Guruma Representatives: Guruma Mali Wartu Aboriginal Corporation). It was registered with the National Native Title Tribunal (NNTT) on 23 June 2008.

The purpose of the ILUA is to allow exploration and mining to occur on Eastern Guruma land in exchange for compensation and protection of native title rights and interests."""@en ;
    schema:endDate "2050-01-01"^^xsd:date ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:3302d162-15ce-5b7d-ad89-1f11c3cb6e0d,
        atns-sub:35e19906-2659-5157-8aee-b9d82eedbb1c,
        atns-sub:9c404ff9-19e6-5e64-a8bd-2e3b39773146,
        "Demo" ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=4725> ;
    schema:name "Pilbara Iron - Eastern Guruma Body Corporate Indigenous Land Use Agreement (ILUA)"@en ;
    schema:startDate "2008-06-23"^^xsd:date ;
    schema:text """On 1 March 2007, a determination was made by Justice Bennett of the Federal Court recognising the Eastern Guruma's native title rights [Hughes (on behalf of the Eastern Guruma People) v State of Western Australia [2007] FCA 365 (see link below)]. This agreement covers that same area.

The ILUA provides for the validation of all past acts and the doing of all future acts over the agreement area by the applicant for an iron ore mining purpose including the grant of any interest in the land."""@en .

