idn-resource:031de913-7260-5830-95ee-0a1845afab14 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A003752"^^xsd:token ;
