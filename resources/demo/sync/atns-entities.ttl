idn-resource:474256e6-405a-599d-9130-1ab604e248c3 a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:084f8732-05ee-5b51-8260-8e311cd3d285,
        idn-resource:7b928a0d-47c5-537a-9136-066ae7f542f4 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
