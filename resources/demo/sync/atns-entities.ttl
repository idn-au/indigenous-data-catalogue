    schema:startDate "2013-10-29"^^xsd:date ;
    schema:url "http://www.nntt.gov.au/searchRegApps/NativeTitleRegisters/Pages/NNTR_details.aspx?NNTT_Fileno=DCD2013/006"^^xsd:anyURI .

idn-resource:6d8665f1-80da-5d40-98fc-b2cc47c71e07 a atns:Entity,
        schema:Organization ;
