    atns:subcategory atns-subcat:f0427812-61d1-5004-b577-ac236a9c5c18 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description "The Oyster Cove Financial Assistance Agreement is an agreement in relation to the provision of funding by the Commonwealth Department of Environment and Heritage for the planning and management of the Oyster Cove Indigenous Protected Area."@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
