idn-resource:d7cd0cd8-f050-5a7d-8c84-5c618e4959c9 a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:7b928a0d-47c5-537a-9136-066ae7f542f4 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A003857"^^xsd:token ;
    atns:sourceEntityId "3857"^^xsd:token ;
    atns:subcategory atns-subcat:09f0a068-ce65-5c11-8dec-f081d1a81ec2 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """The Muluridji People Small Scale Mining & Exploration Activities Indigenous Land Use Agreement (ILUA) was agreed between the State of Queensland (APPLICANT) and Keith Mathieson Snr; Keith Mathieson Jnr; Ian Connolly; Clancy Baker; Clem Riley; Mervyn Riley; North Queensland Land Council; and North Queensland Miners Association on 23 February 2007. The purpose of the ILUA is to give consent for the granting of a prospecting and exploration permit, as well as a mineral development licence.

The ILUA states that it will operate until 29 March 2011."""@en ;
    schema:endDate "2011-03-29"^^xsd:date ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:3302d162-15ce-5b7d-ad89-1f11c3cb6e0d,
        atns-sub:35e19906-2659-5157-8aee-b9d82eedbb1c,
        atns-sub:c74e76ef-701f-5784-8223-5fcd87a7641c,
        "Demo" ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=3857> ;
    schema:name "Muluridji People Small Scale Mining & Exploration Activities Indigenous Land Use Agreement (ILUA)"@en ;
    schema:startDate "2007-02-23"^^xsd:date ;
    schema:text """The parties agree that the exploration permit and mineral development licences may only be granted if they are for an area of land less than 50 sub-blocks of land, and stipulate that the holder cannot hold other Queensland permits or licences for areas over 150 sub-blocks of land. Other requirements pertaining to restricting the mining activities to those of a small scale nature are also included.

This ILUA includes agreement that 'future acts' may be done. The parties also agree that the right to negotiate provisions of the Native Title Act 1993 (Cth) do not apply to future acts, as the alternative consultation provisions are to be followed instead. Under this Act any activity, such as a grant of land, that may affect native title rights is defined as a ‘future act’ and must comply with the future act provisions of the Act in order to be valid."""@en .

