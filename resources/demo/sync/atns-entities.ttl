idn-resource:8cafdff5-b0be-5287-b06f-53ebc09221f9 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:244f6961-729f-5b21-8fc9-baff9dd9af7e ;
    atns:deleted false ;
    atns:eid "A000679"^^xsd:token ;
    atns:sourceEntityId "1156"^^xsd:token ;
    atns:subcategory atns-subcat:27bf4e20-d996-5e23-bbd6-03284f4b24e4 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description "Murwangi Community Aboriginal Corporation (MCAC) tourist ventures involved buffalo, feral bull and pig hunting and limited sport fishing. Safari hunters paid a daily fee to MCAC for hunting and paid a trophy fee per animal, with the exception of feral pigs. Sport fishing also attracted a daily fee. The motivation for the safari operations was to secure a ‘premium return from a small but well paying client group’. The tourist operations were assisted by regular air flights to and from Ramingining, 30 kilometres to the north of Murwangi pastoral station, the centre of the tourist operations. A 15 minute flight took tourists from Raminginging to the Station."@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:51637aba-8d5a-5309-abd9-b42fbe3ec733,
        atns-sub:ef36130b-f525-5200-b398-93681fdc865b,
        atns-sub:f630e08a-ea9c-57e3-ab87-066e4b9ad57e,
        "Demo" ;
    schema:location "North east Arnhem Land, Northern Territory, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=1156> ;
    schema:name "Murwangi Community Aboriginal Corporation tourist venture"@en ;
    schema:text """MCAC operates over an area of 3,000 square kilometres of savannah woodland and wetlands. Clients were predominantly groups of male businessmen who stayed in self-contained tourist accommodation. Forty per cent were Australian, the rest international tourists. MCAC conducted five to six hunts per year. There was also the potential for safari crocodile hunting.

Some tension had been felt between the interests of the commercial hunting venture and the rights of the Traditional Owners to hunt their own resources in their country, even though some traditional owners supported the commercial enterprise.

After the MCAC manager left at the end of 2000 the tourist venture eventually collapsed and ceased operation."""@en .

idn-resource:8cc701e5-5e5b-51e6-b94d-c8c155784c2e a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:7b928a0d-47c5-537a-9136-066ae7f542f4 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:244f6961-729f-5b21-8fc9-baff9dd9af7e ;
    atns:deleted false ;
    atns:eid "A003011"^^xsd:token ;
    atns:sourceEntityId "3387"^^xsd:token ;
    atns:subcategory atns-subcat:09f0a068-ce65-5c11-8dec-f081d1a81ec2 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description "The Western Yalanji and Mareeba Shire Council Indigenous Land Use Agreement (ILUA) was agreed between Mareeba Shire Council, Mr Rodney Riley, Mr Desmond Brickie, Mr Thomas James Mitchell, Mr Dell Riley, Mr Graham Brady and Mr William Steven Brady on 18 May 2006. The purpose of the ILUA is to resolve certain issues in the interaction between the Western Yalanji’s native title rights and interests and the Mareeba Shire Council’s infrastructure interests."@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:c74e76ef-701f-5784-8223-5fcd87a7641c,
        atns-sub:ffe61b3b-8b29-5264-89ac-758a03928ea5,
        "Demo" ;
    schema:location "Far North Queensland, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=3387> ;
    schema:name "Western Yalanji and Mareeba Shire Council Indigenous Land Use Agreement (ILUA)"@en ;
    schema:startDate "2006-05-18"^^xsd:date ;
    schema:text """The Western Yalanji people consent to the continued operation, use and maintenance of all Non-Extinguishing Infrastructure, being infrastructure that is not Extinguishing and was constructed in the ILUA area before its commencement date, as well as all acts necessary for the operation of that infrastructure. This includes consent that certain future acts may be done.

The parties also agree that the right to negotiate provisions of the Native Title Act 1993 (Cth) do not apply, as the alternative consultation provisions are to be followed instead. Under this Act any activity, such as a grant of land, that may affect native title rights is defined as a ‘future act’ and must comply with the future act provisions of the Act in order to be valid."""@en ;
    schema:url "http://www.nntt.gov.au/Indigenous-Land-Use-Agreements/Search-Registered-ILUAs/ILUA%20Register/2005/QI2005.007/ILUARegisterExport.pdf"^^xsd:anyURI .

