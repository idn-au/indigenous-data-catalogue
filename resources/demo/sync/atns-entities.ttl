        "Demo" ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=4403> ;
    schema:name "Desert Knowledge Indigenous Land Use Agreement (ILUA)"@en ;
    schema:startDate "2007-12-13"^^xsd:date .

