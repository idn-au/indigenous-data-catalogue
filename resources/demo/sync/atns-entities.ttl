        "Demo" ;
    schema:location "Northwest Territories, Canada"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=1098> ;
    schema:name "Snap Lake Diamond Project Environmental Agreement 2004"@en .

