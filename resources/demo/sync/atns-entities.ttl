idn-resource:a14a1593-eca9-54d2-b6dc-5a1122de5e16 a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:0ee62889-07c7-5e4d-a1dd-e46d8154c450,
        idn-resource:7b928a0d-47c5-537a-9136-066ae7f542f4 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:244f6961-729f-5b21-8fc9-baff9dd9af7e ;
    atns:deleted false ;
    atns:eid "A001424"^^xsd:token ;
    atns:sourceEntityId "1880"^^xsd:token ;
    atns:subcategory atns-subcat:09f0a068-ce65-5c11-8dec-f081d1a81ec2 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """The Barrow Creek Central Land Council (CLC) Indigenous Land Use Agreement marks the one hundredth ILUA to be registered with the National Native Title Tribunal. The ILUA was made between the CLC on behalf of the native title holders and two mining companies, Newmont Gold Exploration Pty Ltd and Normandy NFM Limited. It allows for exploration and mining by Newmont/Normandy in an area north-west of Barrow Creek in the Northern Territory.

The ILUA specifies that the parties agree to the granting and use of all current and future Exploration Licences (ELs) and Mineral Leases (MLs) within the area of the agreement. Use of the ELs and MLs includes the construction, operation, repair and maintenance of associated requirements such as water resources, pipelines, roads or airstrips.

The native title holders also agree to allow Newmont/Normandy to carry out other activities regarding environmental and cultural protection. These include:
- activities 'to minimise the environmental impact of exploration and mining and to promote the rehabilitation of any part of the Area which has been subjected to exploration and mining';
- activities for 'the protection of any Native Title rights and interests including the protection of sacred sites';
- the manner in which native title rights and interests will be exercised by the native title holders; and
- arrangements for compensation."""@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
