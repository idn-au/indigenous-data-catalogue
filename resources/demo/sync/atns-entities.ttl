idn-resource:5f3781ed-d0fb-54ba-8635-0c6f4e5e8887 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A005875"^^xsd:token ;
