idn-resource:e3e12cd4-170b-5fff-9f0f-442516b50cf7 a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:6db9f9f5-47b1-55eb-8743-a6c63d74553a,
        idn-resource:7b928a0d-47c5-537a-9136-066ae7f542f4 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:244f6961-729f-5b21-8fc9-baff9dd9af7e ;
    atns:deleted false ;
    atns:eid "A002232"^^xsd:token ;
    atns:sourceEntityId "2625"^^xsd:token ;
    atns:subcategory atns-subcat:09f0a068-ce65-5c11-8dec-f081d1a81ec2 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """The Strathburn Holding Native Title Indigenous Land Use Agreement (ILUA) was signed to establish an arrangement of 'working co-existence' between native title parties, pastoral lessees and the government. It provides guidelines for the parties to conduct activities under their respective title, rights and interests in the ILUA area.

This ILUA has been registered in conjuction with the Wik & Wik-Way and Cook Shire Council ILUA and the Southwell Holding and Holroyd River Holding Native Title Agreement ILUAs to bring into effect the Wik Peoples v State of Queensland [2004] FCA 1306 consent determination."""@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:078baf41-50e7-561d-9163-fb3b43a98261,
        atns-sub:29221ef9-81d0-59aa-a9c9-744b71ff8349,
        atns-sub:746b3b59-88ea-5685-81f7-1558875d7c47,
        atns-sub:9e5e8f61-69be-5e2a-a9cd-58fb000349bd,
        atns-sub:bda82010-54a4-5bac-8bf5-4b5341822974,
        atns-sub:c74e76ef-701f-5784-8223-5fcd87a7641c,
        "Demo" ;
    schema:location "Cape York Peninsula, Queensland, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=2625> ;
    schema:name "Strathburn Holding Native Title Indigenous Land Use Agreement (ILUA)"@en ;
    schema:startDate "2005-03-24"^^xsd:date ;
    schema:text """The objective of this ILUA is to record an arrangement between the Lessee and the Native Title Holders that:
- develops good and enduring relationships with respect to use and enjoyment of the area;
- actively develops and maintains good communication, awareness, understanding and respect for the above purpose; and
- reduces the possibility of disharmony between them.

The ILUA will expire if any of the following events occur:
- the Lease is surrendered, resumed, expires or is determined (other than in accordance with the Native Title Act 1993 (Cth) or the Land Act 1994 (Qld)) in circumstances where the whole of the Agreement Area is intended to not be subject to interests which permit the use of the area for Pastoral purposes;
- a transfer of the Lease is registered such that s 47 or s 47A of the Native Title Act 1993 (Cth) could, in the absence of a determination in the area, be relied on for the whole agreement area; or
- all native title rights and interests are subject to valid compulsory acquisition."""@en .

idn-resource:e3e6a84e-c6b1-53db-bf41-cd29ac30de97 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A007695"^^xsd:token ;
    atns:sourceEntityId "7695"^^xsd:token ;
    atns:subcategory atns-subcat:09f0a068-ce65-5c11-8dec-f081d1a81ec2 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """The PKKP and Glenforrie Indigenous Land Use Agreement (ILUA) was made between Peter Robert Grey and Susan Jean Greyt and the PKKP Aboriginal Corporation Registered Native Title Body Corporate (RNTBC).

The Agreement covers an area of about 228 sq km, located about 190 sq km approximately 190 km west of Tom Price.

The purpose of the Agreement is to consent to access, pastoral activities and low impact tourism.

The Native Title Representative Body for this area is the Yamatji Marlpa Aboriginal Corporation."""@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:9335b2f1-4915-55cc-9736-2ded7c4a2008,
        atns-sub:bda82010-54a4-5bac-8bf5-4b5341822974,
        atns-sub:c74e76ef-701f-5784-8223-5fcd87a7641c,
        atns-sub:f630e08a-ea9c-57e3-ab87-066e4b9ad57e,
        "Demo" ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=7695> ;
    schema:name "PKKP and Glenflorrie Indigenous Land Use Agreement (ILUA)"@en ;
    schema:spatialCoverage <https://data.idnau.org/pid/nntt/WI2016-008> ;
    schema:startDate "2017-01-04"^^xsd:date ;
    schema:text """Details of the Agreement:

Commencement:

The Agreement commences in full on the date of registration, 4 January 2017.

Termination:

The Agreement, except for Clause 21 and obligations accured before termination, terminates automatically upon the end of the Pastoral Lease or by written agreement of all the Parties.

Native Title Provisions:

Right to negotiate:

The parties agree that the right to negotiate provisions of the Native Title Act 1993 (Cth)will not apply with respect to the agreed future acts in the ILUA.

Future Act Provisions:

The Extract notes that there are statements within the Agreement of the kind which are mentioned in ss 24EB(1) or 24EBA(1) or (4) of the Native Title Act 1993 (Cth), and so the consequences set out under those sections are triggered by this Agreement. This means that the Agreement provides consent for the doing of certain acts by non-native title parties. Specifically, this ILUA provides consent for the doing of the following future acts:

• the renewal, re-making, extension, remaking or re-grant of the Pastoral Lease from time to time;

• the grant of licence, permit, or authorisation from time to time, including any amendment or renewal, re-making or re-granting of the Pastoral Lease, to conduct activities for agricultural purposes (including the diversification and intensification of pastoral related activities) on the Pastoral Lease;

• the grant of leases, licences and permits from time to time to conduct Low Impact Tourism activity in the Pastoral Lease; and

• the grant of the Pastoral Lease from time to time in relation to all or part of any Stock Route or Reserve, to the extent and in the terms of clause 12 of this ILUA.

Native Title in the Area:

The Agreement is located within the area of native title recognised by the Federal Court of Australiia in the consent determination Puutu Kunti Kurrama and Pinikura 2 (FCA File No.: WAD126/2005; NNTT File No.: WC2005/004)."""@en ;
    schema:url "http://www.nntt.gov.au/searchRegApps/NativeTitleRegisters/Pages/ILUA_details.aspx?NNTT_Fileno=WI2016/008"^^xsd:anyURI .

