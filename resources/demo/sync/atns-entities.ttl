idn-resource:f7c6df0d-1803-59c3-b11b-5a83c57accd0 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A006841"^^xsd:token ;
