idn-resource:51098917-914f-5137-a913-cea6c8b81724 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A006700"^^xsd:token ;
