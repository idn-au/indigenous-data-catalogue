        idn-resource:b1d3ddbe-8b86-5da9-971e-55411da5615e ;
    prov:qualifiedAttribution [ a prov:Attribution ;
            schema:agent <https://data.idnau.org/pid/organization/15d8de7f-b05a-5fb4-98b1-d278e5a9ae17> ;
