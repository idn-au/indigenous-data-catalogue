    atns:subcategory atns-subcat:1b340bb0-e40e-5938-a6a5-34a49cd07960 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """The Memorandum of Understanding signed between the National Aboriginal Community Controlled Health Organisation (NACCHO) and SIDS and Kids represents a collaboration to reduce perinatal and infant mortality in the Aboriginal and Torres Strait Islander communities.

As a result of the partnership an active SIDS and Kids Aboriginal and Torres Strait Islander Advisory Committee has been established to advise SIDS and Kids nationally on the broad range of infant mortality issues from an Aboriginal perspective.

The collaboration will ensure that vital information and training on SIDS reaches the 125 community controlled Aboriginal health services around Australia."""@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:5996de0c-8cc6-5f14-8901-d839af36a4d4,
        atns-sub:d15dd1de-4696-50c8-9f10-2e95eea88e6f,
        "Demo" ;
    schema:location "Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=1793> ;
