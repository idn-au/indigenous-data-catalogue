        idn-resource:4452e306-18aa-52b5-97d2-37569f1e0a28,
        idn-resource:4b9a3569-f850-53e0-aaf4-62866a995a5d,
        idn-resource:53524088-dd8b-5efc-97f0-cc6340050e2d,
        idn-resource:59bf5605-06f0-599b-864e-0f4375ecb8e9,
        idn-resource:72929089-fe48-5730-94c0-8281039a4fad,
        idn-resource:86c0ab1a-34f4-58cb-bfb5-b93f7f12137d,
        idn-resource:bda2960f-b46f-535f-8388-4323d90c23a4 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:709d65e9-b221-53f9-a7f6-0282c0956e36 ;
