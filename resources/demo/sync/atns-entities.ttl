idn-resource:446f8f9c-bcf3-52e6-a5ae-d8b2ea01216a a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A006317"^^xsd:token ;
