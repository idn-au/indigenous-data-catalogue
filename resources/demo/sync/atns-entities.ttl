idn-resource:c4011c17-46af-5223-b18f-02303427595f a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:3b48b5e8-3c9b-55b5-8ac5-a62e2215ae05 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A005045"^^xsd:token ;
    atns:sourceEntityId "5045"^^xsd:token ;
    atns:subcategory atns-subcat:09f0a068-ce65-5c11-8dec-f081d1a81ec2 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """The ILUA was agreed between Suart Gladstone Pipeline Pty Ltd and Selwyn James Appo, Leigh Anthony Blackman, Lynette Yvonne Booth, Stephen Joseph Collins, Maureen Joyce Eggmolesse, Rayleen Evelyn Goltz, Tony Edward Johnson, Dean Sarra, Neola Marie Savage, Michelle Lydia Smith, Maxine Victoria Ann Thompson, Netta Margaret Tyson, Malcolm Alfred Walker and Michael John Williams registered native title claimants for Native Title
Determination Application QUD6026/01 (Port Curtis Coral Coast People).

This ILUA allows the construction of a pipeline, which is part of a 660 mm diameter buried high-pressure steel gas transmission pipeline that will deliver coal seam gas (CSG) from the Surat Basin near Dalby in south-eastern Queensland, to a proposed liquefied natural gas (LNG) plant in Gladstone."""@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:81edd075-cb8e-5a7e-a65d-a47cec815898,
        "Demo" ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=5045> ;
    schema:name "Surat Gladstone Pipeline Pty Ltd and Port Curtis Coral Coast Indigenous Land Use Agreement (ILUA)"@en ;
    schema:startDate "2010-11-02"^^xsd:date ;
    schema:text """The 'Initial ILUA Area' described in the ILUA includes all the land and waters within the external boundaries of the Claim Area. Once an easement is registered for the pipeline route, the ILUA Area will be reduced to the area covered by the easement.

The parties consent to any Pipeline Related future act in the ILUA area. Pipeline Related Acts include:
- the granting of an easement for the project.
- construction and operations associated with the project.

Future acts also include 'Looping Projects' which are activities which permit or require the construction, operation, maintenance, use or repair of any future gas pipelines with augment the capacity of the current Project Pipeline or is located parallel to the current pipeline."""@en .

idn-resource:c40227d9-bb76-506c-a27f-f38a113103e7 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
