        atns-sub:9c404ff9-19e6-5e64-a8bd-2e3b39773146,
        atns-sub:c74e76ef-701f-5784-8223-5fcd87a7641c,
        "Demo" ;
    schema:location "North west of Emerald, Queensland, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=1228> ;
    schema:name "Kangoulu People and AusQuest Limited Indigenous Land Use Agreement (ILUA)"@en ;
    schema:startDate "2001-06-29"^^xsd:date .

