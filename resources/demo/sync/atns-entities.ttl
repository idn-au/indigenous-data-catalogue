    atns:subcategory atns-subcat:c97ff061-87de-5580-9efc-4dd4eb83f378 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """The Memorandum of Understanding entered into between NACCHO and the RACGP formalises a longstanding collaborative effort to improve health outcomes for Aboriginal and Torres Strait Islander communities.

Signatories:&#8239;
- National Aboriginal Community Controlled Health Organisation ('NACCHO')
- Royal College of General Practitioners ('RACGP')"""@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:d15dd1de-4696-50c8-9f10-2e95eea88e6f,
        "Demo" ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=7183> ;
    schema:name "Memorandum of Understanding between the National Aboriginal Community Controlled Health Organisation and The Royal College of General Practitioners"@en ;
    schema:startDate "2014-11-27"^^xsd:date ;
    schema:text "The parties have a shared commitment to advocating for community control and self-determination, and culturally safe and clinically appropriate healthcare. In particular, NACCHO and the RACGP agreed to work collaboratively to advocate for an effective and appropriate healthcare system for Aboriginal and Torres Strait Islander communities; develop standards, funding models and resources to aid healthcare providers improve health outcomes; further pursue partnerships; and create initiatives to foster and develop a skilled workforce in the Aboriginal Community Controlled Sector."@en ;
    schema:url "http://www.naccho.org.au/wp-content/uploads/047.pdf"^^xsd:anyURI .

