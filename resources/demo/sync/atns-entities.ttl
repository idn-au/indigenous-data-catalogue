idn-resource:3cf3b0a6-b7cc-591e-93a8-07223147af46 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A003062"^^xsd:token ;
    atns:sourceEntityId "3438"^^xsd:token ;
    atns:subcategory atns-subcat:51e799aa-68a2-5df5-b3b6-ce3837c24612 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """The Negotiating Framework Agreement – Land is a template Negotiating Framework Agreement provided by the National Native Title Tribunal (NNTT).

It is envisaged by the NNTT that these agreements will be used to assist Indigenous Australians and non-Indigenous Australians to negotiate Negotiating Framework Agreements that can be tailored to their specific needs and circumstances.

The Negotiating Framework Agreement – Land is designed to be made between registered native title applicants, government and other interested parties, in order to provide clarity as to the respective rights and interests over the land in question.

The template agreement details the ‘approach to and process for negotiations, identifies the scope of negotiations, and establishes an agenda and a timetable for the negotiations.’ The agreement includes a code of conduct for interacting parties on pastoral leases; native title rights that can be exercised, including access, burials and camping; and land joint/co-management issues."""@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:7cc37d9a-fe3c-5fec-b115-d1bb8d72db9c,
        atns-sub:9e5e8f61-69be-5e2a-a9cd-58fb000349bd,
        atns-sub:bda82010-54a4-5bac-8bf5-4b5341822974,
        atns-sub:c74e76ef-701f-5784-8223-5fcd87a7641c,
        "Demo" ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=3438> ;
    schema:name "Negotiating Framework Agreement – Land"@en ;
    schema:text """The NNTT has issued template agreements covering six categories, being:
1. Future Act Agreements
2. Intra-Aboriginal Agreements
3. Mediation Withdrawal Agreements
4. Negotiating Framework Agreements
5. Pastoral Agreements
6. Reconciliation Agreements Principals.

Please see the ‘Template Agreement’ link at the bottom of this page for further information.

Please also see the National Native Title Tribunal's DISCLAIMER in relation to these agreements."""@en ;
    schema:url "http://www.nntt.gov.au/agreements/templates.html"^^xsd:anyURI .

