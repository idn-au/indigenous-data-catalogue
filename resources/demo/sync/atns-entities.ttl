idn-resource:c8122728-6e9f-597c-b4d9-68b8858e66c7 a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:617b9fa2-767d-571a-a517-3f2858fc2fd4,
        idn-resource:933f14f6-50ca-501c-9681-cb6847ee73a1 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
