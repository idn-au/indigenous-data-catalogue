idn-resource:6473f61b-505d-55aa-81b3-cba20c67e12d a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A005497"^^xsd:token ;
