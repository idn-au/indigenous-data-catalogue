idn-resource:6189845c-d613-53d2-95ee-3c54e6a37254 a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:24480232-708d-5389-8dfc-9ae2c7e2c743,
        idn-resource:4b3db1ce-491c-58ee-9a43-8ae9697faacd,
        idn-resource:93ef95f3-1ae1-59ee-9262-e92daa343ce5,
        idn-resource:e4ef02de-a89c-5d22-a6a4-59878f5d5583 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:b497b3a3-422a-5e37-b101-e1ee7f91c4a5 ;
    atns:deleted false ;
    atns:eid "A002028"^^xsd:token ;
    atns:sourceEntityId "712"^^xsd:token ;
    atns:subcategory atns-subcat:e76f87e0-b8e3-5926-84b7-228c7fad9c7c ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description "The Treaty between the Government of Australia and the Government of the Republic of Indonesia establishing an Exclusive Economic Zone Boundary and Certain Seabed Boundaries was signed on the 14 March 1997. Based on international law set out in the United Nations Convention on the Law of the Sea (December 1982) Australia and Indonesia agreed upon an exclusive economic zone and water column boundary that includes parts of the Timor Sea. Basically they agreed to adopt a median line between the two coasts (Brennan, 2004:28). However, the Treaty, based on the median line principle, does not affect the position adopted in the 1972 and 1989 Treaties, respectively, based on the continental shelf principle of the 1958 Geneva Convention."@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:51ca8813-b7bb-5a37-819e-afae35771fff,
        "Demo" ;
    schema:location "Timor Sea between East Timor and Australia, East Timor and Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=712> ;
    schema:name "Treaty between the Government of Australia and the Government of the Republic of Indonesia establishing  an Exclusive Economic Zone Boundary and Certain Seabed Boundaries"@en ;
    schema:startDate "1997-03-14"^^xsd:date ;
    schema:text "Both parties agreed that this 1997 water column boundary and exclusive economic zone treaty has no effect on the 1972 Permanent Seabed Boundary Treaty and on the 1989 Zone of Cooperation Treaty known as the Timor Gap Treaty (sea map). This 1997 treaty allowed both parties to exercise their respective fishing rights and maritime scientific research rights within the agreed water column boundaries with a mutual obligation to respect the rights of each party. The treaty did not enter into force due to (1) the downfall of the Suharto’s regime in May 1998, (2) the separation of East Timor from the Republic of Indonesia in 1999 and (3) East Timor being under the Transitional Administration of the United Nations from 25 October 1999 to 20 May 2002."@en .

