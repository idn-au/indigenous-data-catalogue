idn-resource:833fca54-38c2-585b-a6bb-07c2221ec25f a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:7b928a0d-47c5-537a-9136-066ae7f542f4,
        idn-resource:819f92d8-cbf9-5293-90f0-b1141dca8d94,
        idn-resource:fec6ec28-55a6-5556-9541-b71f4cc65b9b ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:244f6961-729f-5b21-8fc9-baff9dd9af7e ;
    atns:deleted false ;
    atns:eid "A002476"^^xsd:token ;
    atns:sourceEntityId "2886"^^xsd:token ;
    atns:subcategory atns-subcat:09f0a068-ce65-5c11-8dec-f081d1a81ec2 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description "The Barron Gorge National Park Indigenous Land Use Agreement (ILUA) brings into effect the Djabugay People’s native title determination handed down by the Federal Court in 2004. The ILUA is a voluntary agreement made between the Djabugay People, the State of Queensland and Djabugay Native Title Aboriginal Corporation, which relates to the exercise of native title rights and interests within the area of the Barron Gorge National Park."@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:746b3b59-88ea-5685-81f7-1558875d7c47,
        atns-sub:9e5e8f61-69be-5e2a-a9cd-58fb000349bd,
        atns-sub:c74e76ef-701f-5784-8223-5fcd87a7641c,
        "Demo" ;
    schema:location "Barron Gorge National Park, Queensland, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=2886> ;
    schema:name "Barron Gorge National Park Indigenous Land Use Agreement (ILUA)"@en ;
    schema:startDate "2005-07-25"^^xsd:date ;
    schema:text """Duration of the ILUA
The ILUA commenced on 10 December 2004. It expires on the earlier of:
a) a regulation giving effect to the management plan in accordance with section 69 of the Nature Conservation Act 1992 (Qld); or
b) 31 December 2010; or
c) a Determination by the Federal Court that native title does not exist in the ILUA area.

Content of the ILUA
The ILUA concerns the terms of access, in particular the exercise of native title rights and interests in the ILUA area. The agreement was signed to ensure the good management of the Barron Gorge National Park.

In a summary of the Djabugay native title determination, the National Native Title Tribunal details the content of the ILUA in the following way:

'The ILUA says that the Djabugay People will:
- carry out any hunting in the Barron Gorge National Park in a manner consistent with the public enjoyment of the park and with the management principles of National Parks
- not use firearms in the Barron Gorge National Park, except as expressly authorised by Queensland Parks and Wildlife Service
- not take or interfere with rare, endangered or vulnerable species in the Barron Gorge National Park
- not, without the further agreement of Queensland Parks and Wildlife Service, camp in the Barron Gorge National Park for periods of longer than four weeks at a time.'
(National Native Title Tribunal, 2005, 'Djabugay Determination: Background Information 17 December 2004')."""@en .

idn-resource:8340ac46-7c45-5393-8d27-7dc197d3b86f a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:1b671933-35a0-58e1-b828-2f88e5736211,
        idn-resource:f2590680-2f63-5549-a6b3-1ecc6a7905ce ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:709d65e9-b221-53f9-a7f6-0282c0956e36 ;
    atns:deleted false ;
    atns:eid "A001745"^^xsd:token ;
    atns:sourceEntityId "2181"^^xsd:token ;
    atns:subcategory atns-subcat:23587163-67a7-5fa1-8812-c75f795d32df,
        atns-subcat:7dff9d75-8efe-5518-a99d-54546a46d417 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description "The Kluane First Nation Final Agreement Implementation Plan was developed by the Kluane First Nation, the Government of Yukon and the Government of Canada. It was signed on 18 October 2003. Chapter 28 of the Kluane First Nation Final Agreement (The Kluane Final Agreement) requires the establishment of a detailed Implementation Plan which is to guide and monitor the implementation of the Kluane Final Agreement. The Implementation Plan sets out the obligations and activities of each of the parties to the Kluane Final Agreement. The Implementation Plan represents an agreement as to the implementation of the Kluane Final Agreement but does not create legal obligations beyond those contained in that Agreement."@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:078baf41-50e7-561d-9163-fb3b43a98261,
        atns-sub:17d993e0-d19e-5349-a48e-4de57b1dba59,
        atns-sub:51ca8813-b7bb-5a37-819e-afae35771fff,
        atns-sub:7cc37d9a-fe3c-5fec-b115-d1bb8d72db9c,
        atns-sub:9073e633-80a9-5ba7-8892-f556bd0a0612,
        atns-sub:9468ab8c-2b3a-54c2-b5e8-88e552bdd046,
        atns-sub:e52a2091-dcda-569c-aafb-6497428c615c,
        "Demo" ;
    schema:location "Yukon, Northwest Territories, Canada"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=2181> ;
    schema:name "Kluane First Nation Final Agreement Implementation Plan 2003"@en ;
    schema:text """The Implementation Plan takes effect upon the commencement of the operation of the Kluane Final Agreement itself signed 18 October 2003. The Implementation Plan identifies the following:

• The obligations, activities, projects and measures required to implement the Kluane Final Agreement;
• The party responsible for each particular obligation or activity;
• The manner in which activities are to be carried out;
• The time frame in which activities are to be carried out;
• Responsibility for funding the activities;
• Training and economic opportunities for the Kluane people;
• The obligations, activities, time frames and funding are detailed extensively in Activity Sheets which are annexed to the Implementation Plan (Annexure A);
• Details regarding Commissions, Councils and Committees, Information Strategy, Economic Planning, Co-ordination of Implementation, Reporting and Communication requirements are also annexed to the Implementation Plan (Annexures B-G)."""@en .

