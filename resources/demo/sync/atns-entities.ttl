idn-resource:4aa61210-633b-527e-baf5-276d9d42a1ad a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A006402"^^xsd:token ;
