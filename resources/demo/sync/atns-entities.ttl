idn-resource:fe13fb27-19a8-56f7-b5de-b957241131ab a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:6643fbe0-66bf-5e19-ae00-c56f37387cc2,
        idn-resource:819f92d8-cbf9-5293-90f0-b1141dca8d94,
        idn-resource:bb930b12-7879-563d-a090-8c5e2416861c,
        idn-resource:fec6ec28-55a6-5556-9541-b71f4cc65b9b ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:244f6961-729f-5b21-8fc9-baff9dd9af7e ;
    atns:deleted false ;
    atns:eid "A002259"^^xsd:token ;
