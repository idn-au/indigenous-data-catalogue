        atns-sub:c74e76ef-701f-5784-8223-5fcd87a7641c,
        "Demo" ;
    schema:location "Victoria, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=2148> ;
    schema:name "Pro forma section 31 Deed for Exploration Licences (Victoria)"@en ;
    schema:url "http://www.dpi.vic.gov.au/dpi/nrenmp.nsf/FID/-771FC61DA38AADE74A256A72001EF70E?OpenDocument"^^xsd:anyURI .

