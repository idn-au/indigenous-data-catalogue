        atns-sub:9c404ff9-19e6-5e64-a8bd-2e3b39773146,
        atns-sub:c74e76ef-701f-5784-8223-5fcd87a7641c,
        "Demo" ;
    schema:location "Approximately 55 kms south-west of Bowen, Queensland, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=1888> ;
    schema:name "Birri Indigenous Land Use Agreement (ILUA) for Backlog Exploration Permits"@en ;
    schema:startDate "2003-12-11"^^xsd:date .

idn-resource:4de09d54-7118-5aac-ae4e-260d937d9ab1 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
