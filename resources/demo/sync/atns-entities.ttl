    schema:location "Ranger Project Area, Northern Territory, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=1701> ;
    schema:name "Ranger Uranium Project: Deed to Amend the Government Agreement (12 September 1980)"@en ;
    schema:startDate "1980-09-12"^^xsd:date .

