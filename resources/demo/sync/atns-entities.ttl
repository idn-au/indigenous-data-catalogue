idn-resource:a115894d-8a4d-585f-8431-e594d93e051d a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A007908"^^xsd:token ;
