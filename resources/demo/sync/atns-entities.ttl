idn-resource:5c4b9f23-ecd6-57fd-924a-a9537a171006 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A006378"^^xsd:token ;
