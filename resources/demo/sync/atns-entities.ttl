        "Demo" ;
    schema:location "Jingaloo, Northern Territory, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=720> ;
    schema:name "Jingaloo (Community Living Area) Indigenous Land Use Agreement (ILUA)"@en ;
    schema:startDate "2004-12-23"^^xsd:date .

