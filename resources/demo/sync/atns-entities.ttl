    schema:name "Powercoal Pty Ltd, Victor Perry, Stephen Seiver & NSW ALC ILUA Area Agreement Indigenous Land Use Agreement (ILUA)"@en ;
    schema:startDate "2001-08-29"^^xsd:date .

