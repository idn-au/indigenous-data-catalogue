idn-resource:1f0b91e2-c9b2-53ca-a4d3-3d147963d0af a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:7b928a0d-47c5-537a-9136-066ae7f542f4 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:244f6961-729f-5b21-8fc9-baff9dd9af7e ;
    atns:deleted false ;
    atns:eid "A002145"^^xsd:token ;
    atns:sourceEntityId "2538"^^xsd:token ;
    atns:subcategory atns-subcat:09f0a068-ce65-5c11-8dec-f081d1a81ec2 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """The Indigenous Land Use Agreement (ILUA) for ML90127 allows the grant of a mining licence (ML) to Joseph Sandham Rogers Snr and Joseph Sandham Rogers Jnr by the Queensland government.

The ILUA acknowledges the consent of the parties to the granting of the ML90127. The parties agree that the right to negotiate provisions of the Native Title Act 1993 (Cth) do not apply, as the alternative consultation provisions are to be followed instead. Without this agreement, the grant would have been invalid and the right to negotiate provisions of the Native Title Act 1993 (Cth) would apply. Under this act any activity, such as a grant of land, that may affect native title rights is defined as a "future act" and must comply with the future act provisions of the act in order to be valid.

The ILUA relates only to ML90127 and continues until the end of the term of the licence, which may be renewed. Any ML created to replace ML90127 is also covered by the ILUA."""@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:29221ef9-81d0-59aa-a9c9-744b71ff8349,
