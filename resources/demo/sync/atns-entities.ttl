        idn-resource:c8d36a66-c1a7-53e5-b50e-d351fb73f292,
        idn-resource:de8c5e7f-445a-57eb-b6cc-18c65ecec721 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
