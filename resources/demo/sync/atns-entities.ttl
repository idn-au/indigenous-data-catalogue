idn-resource:9fbdc1ba-7423-535d-8537-4ca27db2be0b a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:7b928a0d-47c5-537a-9136-066ae7f542f4 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:244f6961-729f-5b21-8fc9-baff9dd9af7e ;
    atns:deleted false ;
    atns:eid "A002787"^^xsd:token ;
    atns:sourceEntityId "3172"^^xsd:token ;
    atns:subcategory atns-subcat:09f0a068-ce65-5c11-8dec-f081d1a81ec2 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """The Cox Peninsula Water Supply Indigenous Land Use Agreement (ILUA) was agreed between the Northern Territory Power and Water Corporation, the Northern Land Council and the Native Title Parties on 12 January 2006.

The purpose of the ILUA is to provide consent for the construction of a water pipeline on the Cox Peninsula in order to upgrade the supply of water to residents. To achieve this, the ILUA consents to the construction of various infrastructures on the Charles Point Road Reserve, including bores and a water-rising main."""@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:8afa6040-57f6-5faf-a4f9-863bd8f4f470,
        atns-sub:c74e76ef-701f-5784-8223-5fcd87a7641c,
        atns-sub:ffe61b3b-8b29-5264-89ac-758a03928ea5,
        "Demo" ;
    schema:location "Cox Peninsula, Northern Territory, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=3172> ;
    schema:name "Cox Peninsula Water Supply Indigenous Land Use Agreement (ILUA)"@en ;
    schema:startDate "2006-01-12"^^xsd:date ;
    schema:text """The Native Title parties agree that the Power and Water Corporation may do certain acts in order to further the construction of the water pipeline. This includes agreement that 'future acts' may be done. The parties also agree that the right to negotiate provisions of the Native Title Act 1993 (Cth) do not apply, as the alternative consultation provisions are to be followed instead. Under this Act any activity, such as a grant of land, that may affect native title rights is defined as a 'future act' and must comply with the future act provisions of the Act in order to be valid.

The parties to the ILUA also consent to the doing of all actions needed to ensure the water pipeline's maintenance, operation, repair, removal, replacement and upgrade. In addition, the ILUA allows for the granting of an Easement in Gross over the land that is 5 metres in width and approximately 705 metres in length."""@en .

