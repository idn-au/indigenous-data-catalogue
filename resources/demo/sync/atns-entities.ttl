        atns-sub:ffe61b3b-8b29-5264-89ac-758a03928ea5,
        "Demo" ;
    schema:location "Duaringa Shire Council and Fitzroy Shire Council l, Queensland, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=242> ;
    schema:name "Enertrade - Jetimarala CQGP Indigenous Land Use Agreement (ILUA)"@en ;
    schema:startDate "2006-10-31"^^xsd:date .

