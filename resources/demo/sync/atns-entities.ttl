idn-resource:e1e87656-c009-5376-aec4-ba9ec105160f a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:21a46f27-2f98-5038-a6aa-890424497050 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
