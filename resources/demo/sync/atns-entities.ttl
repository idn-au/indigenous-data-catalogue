idn-resource:2c15b2c4-6c3b-5447-8700-af62ccfb078f a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:6eb98024-6967-50a5-8f26-2ab604774400 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:244f6961-729f-5b21-8fc9-baff9dd9af7e ;
    atns:deleted false ;
    atns:eid "A001403"^^xsd:token ;
    atns:sourceEntityId "1859"^^xsd:token ;
    atns:subcategory atns-subcat:6ffe90c2-95c9-51b5-a083-8c7d83b975ef ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description "The Australian Capital Territory (ACT) Chief Minister and the Board of the Aboriginal and Torres Strait Islander Commission (ATSIC) signed the Statement of Intent with the aim to further strengthen and give effect to commitments to jointly improve public policy and program outcomes for Aboriginal and Torres Strait Islander peoples in the ACT."@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:5996de0c-8cc6-5f14-8901-d839af36a4d4,
        "Demo" ;
    schema:location "Australian Capital Territory, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=1859> ;
    schema:name "Australian Capital Territory Government and the Aboriginal and Torres Strait Islander Commission Statement of Intent"@en ;
    schema:startDate "2002-02-20"^^xsd:date ;
    schema:text """ATSIC and the ACT Government are committed to developing a partnering agreement (the Regional Agreement) aimed at improving outcomes in priority areas within the ACT. These include improving access to services; increasing involvement of Aboriginal and Torres Strait Islanders in decision-making processes; building partnerships between Aboriginal and Torres Strait Islanders and Government agencies; and committing to an improved social, cultural and economic status for Aboriginal and Torres Strait Islanders. The parties also recognise the need to coordinate cross border activity between Commonwealth, State and Territory Government agencies and endorse policies, which derive from national reports and Royal Commissions, that have an impact on Aboriginal and Torres Strait Islander Affairs.

To ensure greater effectiveness in achieving outcomes, ATSIC and the ACT Government agree to a planning process for service delivery leading to the development of a Regional Agreement. Planning will involve the Queanbeyan Regional Council and all relevant ACT Government agencies and advisory bodies.

The parties also commit to developing a steering committee to progress the Regional Agreement and to continue developing a cooperative working relationship in order to meet the needs of the community and reduce the relative disadvantage of the Aboriginal and Torres Strait Islander community in the ACT.

The agreement also reaffirms a commitment to:
(a) the 'National Commitment to Improved Outcomes in the Delivery of Programs and Services for Aboriginal Peoples and Torres Strait Islanders 1992'; and
(b) the outcomes of the November 2000, Council of Australian Governments’ 'Communiqué on the Matter of Aboriginal Reconciliation'."""@en .

