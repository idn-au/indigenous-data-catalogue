idn-resource:1ff39d8c-8341-5d67-95d5-6a5f4f35b2c8 a atns:Entity,
        schema:CreativeWork ;
    prov:qualifiedAttribution [ a prov:Attribution ;
            schema:agent <https://data.idnau.org/pid/organization/fc8ca7c0-b52b-5930-ae46-86099596fab1> ;
