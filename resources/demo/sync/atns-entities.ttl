idn-resource:03ad2ec7-a85e-5959-8239-f16ab9086a5e a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:ff719771-0682-5b8d-8900-d0d3bfcc15c7 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:244f6961-729f-5b21-8fc9-baff9dd9af7e ;
