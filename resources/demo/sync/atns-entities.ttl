        atns-sub:d15dd1de-4696-50c8-9f10-2e95eea88e6f,
        atns-sub:f373baa1-6611-5aae-a140-c2cd1c548f13,
        "Demo" ;
    schema:location "Western Australia, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=1398> ;
    schema:name "Statement of Commitment to a New and Just Relationship between the Government of Western Australia and Aboriginal Western Australians"@en ;
    schema:startDate "2001-10-10"^^xsd:date ;
    schema:url "https://web.archive.org/web/20060228053539/http://www.dia.wa.gov.au/Policies/StateStrategy/Files/StatementOfCommitment.pdf"^^xsd:anyURI .

