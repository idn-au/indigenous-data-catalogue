    atns:subcategory atns-subcat:1b340bb0-e40e-5938-a6a5-34a49cd07960,
        atns-subcat:496640c9-a0b8-580b-9bba-459fe5fcc345 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description "The establishment of the Torngat Mountains National Park Reserve is provided for by Chapter 9 of the Labrador Inuit Land Claims Agreement (the Final Agreement) and is to come into effect on the Effective Date of that agreement. The park is to cover approximately 9,600 square kilometres of land in the Labrador Inuit Settlement Area outside of Labrador Inuit Lands. Labrador Inuit will have rights to hunt, fish, trap and maintain subsistence activities within the Reserve. No commercial fishing or hunting operations will be permitted. The Final Agreement requires the negotiation of two bilateral agreements which will permit the park to be established – a Park Impacts and Benefits Agreement and a Land Transfer Agreement. The Park Impacts and Benefit Agreement provides benefits and compensation to the Inuit for impacts associated with the establishment of the park, while the Land Transfer Agreement allows the Province to transfer administration and control of land in the park to Canada. This agreement will address federal/provincial matters and will include the resolution of any outstanding mineral claims. The Memorandum of Understanding (MOU) negotiated between the provincial government and the Labrador Inuit Association protects the land proposed for the park until the Final Agreement is concluded. The park will extend from Saglek Bay to Killinek Island at the Northern tip of Labrador."@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:e52a2091-dcda-569c-aafb-6497428c615c,
        "Demo" ;
    schema:location "Labrador, Newfoundland and Labrador, Canada"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=2260> ;
    schema:name "Memorandum of Understanding on Interim Measures Related to the Proposed Torngat Mountains National Park Reserve 2000"@en ;
    schema:startDate "2000-01-01"^^xsd:date .

