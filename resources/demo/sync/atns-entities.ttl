idn-resource:3c2b10f8-eb83-5de4-b54d-28f7ed058109 a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:180b6fcc-dcc6-5592-a390-5179366066fd,
        idn-resource:97dd3be9-f4ca-586a-971a-594015bbfcc4 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:244f6961-729f-5b21-8fc9-baff9dd9af7e ;
    atns:deleted false ;
    atns:eid "A003265"^^xsd:token ;
    atns:sourceEntityId "30"^^xsd:token ;
    atns:subcategory atns-subcat:6ffe90c2-95c9-51b5-a083-8c7d83b975ef,
        atns-subcat:f0427812-61d1-5004-b577-ac236a9c5c18 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description "Public ATNS summary describes a 2005-2008 agreement between Australian Government and ACT Government parties for Indigenous housing provision."@en,
        """The Agreement between the Australian Government and the Australian Capital Territory (ACT) Government for the Provision of Housing for Indigenous People was signed by John Hargraves, ACT Minister for Disability Housing and Community Services, and the Hon Kay Patterson, Commonwealth Minister for Family and Community Services, to commence on 1 October 2005.

The Agreement is one of the Indigenous housing agreements required by the Commonwealth State Housing Agreement 2003-2008 (CSHA). The Commonwealth Government had negotiated Indigenous Housing and Infrastructure Agreements (IHIAs) for 2005-2008 with each state and territory government by May 2006 (see Community Affairs Legislation Committee 2006, 76).

Policies that were at issue for the Australian Government during negotiation of the Agreement are set out in the letter by Senator Patterson to John Hargreaves (2005)."""@en ;
    schema:endDate "2008-06-30"^^xsd:date ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:ffe61b3b-8b29-5264-89ac-758a03928ea5,
        "Demo" ;
    schema:location "Australian Capital Territory, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=30> ;
    schema:name "Agreement for the Provision of Housing for Indigenous People (ACT)"@en ;
    schema:startDate "2005-10-01"^^xsd:date ;
    schema:text """Principles

The principles of the Agreement include COAG's National Framework of Principles for Delivering Services to Indigenous Australians, the national policy, Building a Better Future: Indigenous Housing to 2010 and the National Commitment to Improved Outcomes in the Delivery of Programs and Services for Aboriginal and Torres Strait Islanders (1992- ).

Funding arrangements

The Agreement provides for the pooling of Commonwealth and ACT government funds. From 2006-2007, the ACT Government will be responsible for disbursing all Commonwealth funding provided under the Agreement (DHCS 2006).

Territory Advisory Committee

The Agreement establishes the Territory Advisory Committee on Indigenous Housing."""@en ;
    schema:url "http://www.legislation.act.gov.au/ni/2005-433/current/pdf/2005-433.pdf"^^xsd:anyURI .

