idn-resource:3447d20c-712a-5290-b123-40d9eb8029b4 a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:51d36122-4d37-59ed-9aec-513b3ca40227 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:244f6961-729f-5b21-8fc9-baff9dd9af7e ;
    atns:deleted false ;
    atns:eid "A001387"^^xsd:token ;
    atns:sourceEntityId "1843"^^xsd:token ;
    atns:subcategory atns-subcat:89615198-37f5-5e14-91e6-a2ba2eb0af09 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """The Agreement between the Australian Capital Territory and ACT Native Title Claimants was negotiated with a view to the withdrawal of the native title determination application.
Under the agreement, the Territory offered to grant a Namadgi Special Aboriginal Lease over Namadgi National Park for a period of 99 years, on the condition that all native title claims be either fully determined or withdrawn.
Upon the withdrawal of the native title claim and until the Special Lease commences, the parties agreed to implement interim arrangements for the involvement of the Aboriginal Parties in the management of Namadgi National Park.

An interim Namadgi Advisory Board will be established comprising five Aboriginal members and five non-Aboriginal members who will be appointed by the Minister.
The management arrangement to apply under the Namadgi Special Aboriginal Lease will be negotiated between the parties, and will include a statutory Board of Management made up of six Aboriginal members and six non-Aboriginal members for a period of three years. The Board will have responsibility for preparing and overseeing the implementation of a Plan of Management for the Park."""@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:7cc37d9a-fe3c-5fec-b115-d1bb8d72db9c,
        atns-sub:9e5e8f61-69be-5e2a-a9cd-58fb000349bd,
        atns-sub:c74e76ef-701f-5784-8223-5fcd87a7641c,
        "Demo" ;
    schema:location "Australian Capital Territory, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=1843> ;
    schema:name "Agreement between the Australian Capital Territory and ACT Native Title Claim Groups"@en ;
    schema:startDate "2001-01-01"^^xsd:date .

