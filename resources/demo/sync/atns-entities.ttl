        atns-sub:c74e76ef-701f-5784-8223-5fcd87a7641c,
        "Demo" ;
    schema:location "Central Victoria, Victoria, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=717> ;
    schema:name "Victoria Mining Licence 5333 Indigenous Land Use Agreement (ILUA)"@en ;
    schema:startDate "2005-01-12"^^xsd:date .

