        "Demo" ;
    schema:location "Faraway Hills Pastoral Station, South Australia, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=3183> ;
    schema:name "Ngadjuri Faraway Hills Pastoral Indigenous Land Use Agreement (ILUA)"@en ;
    schema:startDate "2006-02-20"^^xsd:date ;
    schema:text "This ILUA does not provide for 'future acts'. Under the Native Title Act 1993 (Cth) any activity, such as a grant of land, that may affect native title rights is defined as a ‘future act’ and must comply with the future act provisions of the Act in order to be valid."@en .

