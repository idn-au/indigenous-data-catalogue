        atns-sub:ffe61b3b-8b29-5264-89ac-758a03928ea5,
        "Demo" ;
    schema:location "North west of Moranbah, Queensland, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=1895> ;
    schema:name "North Queensland Gas Pipeline Southern Indigenous Land Use Agreement (ILUA)"@en ;
    schema:startDate "2003-12-15"^^xsd:date .

idn-resource:b2e7caa7-9e33-5030-b509-85f63b7888ca a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A006470"^^xsd:token ;
