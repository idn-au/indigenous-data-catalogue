    atns:deleted false ;
    atns:eid "A006695"^^xsd:token ;
    atns:sourceEntityId "6695"^^xsd:token ;
    atns:subcategory atns-subcat:09f0a068-ce65-5c11-8dec-f081d1a81ec2 ;
