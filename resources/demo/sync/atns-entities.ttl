idn-resource:2d6c735d-6acf-5787-bcc7-2a3abdc9e3d6 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:244f6961-729f-5b21-8fc9-baff9dd9af7e ;
    atns:deleted false ;
    atns:eid "A003027"^^xsd:token ;
    atns:sourceEntityId "3403"^^xsd:token ;
    atns:subcategory atns-subcat:177cef4d-1963-57e3-9b5c-508480daf336,
        atns-subcat:51e799aa-68a2-5df5-b3b6-ce3837c24612 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """The Access Clearance and Native Title Mining Agreement is a template Future Act Agreement provided by the National Native Title Tribunal (NNTT).

It is envisaged by the NNTT that these agreements will be used to assist Indigenous and non-Indigenous Australians to negotiate Future Act Agreements that can be tailored to their specific needs and circumstances.

The Access Clearance and Native Title Mining Agreement is designed to be used for negotiations between a mining operations explorer (‘explorer’) and native title claimant groups (‘claimants’). The template agreement outlines preliminary matters, including:
(a) stipulating the relevant Native Title Representative Body;
(b) prescribing that the explorer’s obligations under the Agreement are not dependant on the native title claimant groups establishing native title; and
(c) outlining the relevant authorisations and obligations under various state and commonwealth mining operations legislation, including in relation to the protection of Aboriginal Heritage under the Aboriginal and Torres Strait Islander Heritage Protection Act 1984 (Cth).

The template agreement covers areas including:

(a) the period that the Agreement operates for;
(b) the explorer’s Access Clearance to enter the agreement area, including that a ‘clearance officer’ should be appointed to liaise between the claimants and the explorer on the issue relating to that access;
(c) that a Scouting Team, containing traditional owners, must be appointed to carry out an Access Clearance survey;
(d) that after the Access Clearance survey is complete, the explorer must lodge for registration as a native title mining agreement for mineral exploration a copy of the Agreement;
(e) undertakings by the explorer on the conduct of their mining exploration operations;
(f) that there is no obligation on the part of the claimants to disclose any cultural information;
(g) payments made to the claimants; and
(h) confidentiality provisions."""@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:3302d162-15ce-5b7d-ad89-1f11c3cb6e0d,
        atns-sub:35e19906-2659-5157-8aee-b9d82eedbb1c,
        atns-sub:9335b2f1-4915-55cc-9736-2ded7c4a2008,
        atns-sub:9c404ff9-19e6-5e64-a8bd-2e3b39773146,
        atns-sub:dc50c698-80b0-5ef4-bd95-928f2be8da05,
        "Demo" ;
    schema:location "Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=3403> ;
    schema:name "Access Clearance and Native Title Mining Agreement"@en ;
    schema:text """The NNTT has issued template agreements covering six categories, being:
1. Future Act Agreements
2. Intra-Aboriginal Agreements
3. Mediation Withdrawal Agreements
4. Negotiating Framework Agreements
5. Pastoral Agreements
6. Reconciliation Agreements Principles.

Please see the ‘Template Agreement’ link at the bottom of this page for further information.

Please see the National Native Title Tribunal's DISCLAIMER in relation to these agreements."""@en ;
    schema:url "http://www.nntt.gov.au/agreements/files/TemplateAccessClearFAA/"^^xsd:anyURI .

idn-resource:2d75bc97-816e-587c-b764-40672ef9ae38 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A003606"^^xsd:token ;
    atns:sourceEntityId "3606"^^xsd:token ;
    atns:subcategory atns-subcat:b7b5cd08-d283-583c-a41f-39a8ccf7f555 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:17d993e0-d19e-5349-a48e-4de57b1dba59,
        atns-sub:51ca8813-b7bb-5a37-819e-afae35771fff,
        atns-sub:5996de0c-8cc6-5f14-8901-d839af36a4d4,
        "Demo" ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=3606> ;
    schema:name "Ngaanyatjarra Pitjantjatjara Yankunytjatjara Women's Bushfood Enterprise"@en ;
    schema:text """The ‘Only One! – Aboriginal Women Developing Natural Resources Industries Based on Traditional Knowledge’ is a bush foods gathering enterprise run by the Ngaanyatjarra Pitjantjatjara Yankunytjatjara (NPY) Women’s Council Aboriginal Corporation, who operate out of Alice Springs.

The project had start-up funding from Bushcare, a program of the Natural Heritage Trust, who contributed an initial $40,000. The project’s goals are to establish a viable ‘indigenous-controlled, ecologically sustainable, economic industry’ in central Australia.

The project also seeks to:
• monitor the effects of traditional harvesting techniques on native species;
• help in the transfer of traditional knowledge to younger generations;
• increase industry management skills and training opportunities; and
• aid trial planting of traditional bush seeds in local Aboriginal nurseries.

The project’s partners include Outback Bushfood, who has arranged to be supplied with seeds gathered by the women, and who assists in the transport of the project’s participants to harvest locations.

The bush foods being gathered include acacia and wattle seeds, used in bread and damper, and bush tomatoes, popular in community stores. The women traverse great distances to gather these seeds – over several months the members of the project travelled 6300 km and visited eight communities in South Australia, Northern Territory and Western Australia."""@en .

