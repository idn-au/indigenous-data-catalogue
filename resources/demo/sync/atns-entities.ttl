idn-resource:b4278e5a-b61a-5c4d-9b91-3bcfdd546164 a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:0a87baf8-543c-5a5e-af32-471fc87d662f,
        idn-resource:10301b51-af2c-55b8-8238-2bfce7df6bf8,
        idn-resource:dbdb8241-68cf-55fc-85d5-228859cf742e ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:244f6961-729f-5b21-8fc9-baff9dd9af7e ;
