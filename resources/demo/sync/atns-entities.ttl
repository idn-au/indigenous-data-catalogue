idn-resource:34524ede-2abc-50f1-af30-8493753c928e a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:ca68a358-3931-5011-adfd-0a695adc4812 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:244f6961-729f-5b21-8fc9-baff9dd9af7e ;
    atns:deleted false ;
    atns:eid "A003259"^^xsd:token ;
    atns:sourceEntityId "24"^^xsd:token ;
    atns:subcategory atns-subcat:6ffe90c2-95c9-51b5-a083-8c7d83b975ef ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description "Public ATNS summary describes a 2002 health agreement between Queensland, Commonwealth, ATSIC and Queensland Aboriginal and Islander Health Forum parties."@en,
        "The Agreement on Queensland Aboriginal and Torres Strait Islander Health ('the Agreement') was made between the State of Queensland (through Queensland Health), the Commonwealth (through the Department of Health and Ageing), the Aboriginal and Torres Strait Islander Commission (ATSIC) and the Queensland Aboriginal and Islander Health Forum (QAIHF) on 12 June 2002."@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:5996de0c-8cc6-5f14-8901-d839af36a4d4,
        atns-sub:d15dd1de-4696-50c8-9f10-2e95eea88e6f,
        "Demo" ;
    schema:location "Queensland, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=24> ;
    schema:name "Agreement on Queensland Aboriginal and Torres Strait Islander Health"@en ;
    schema:startDate "2002-06-12"^^xsd:date ;
    schema:text """The aim of the Agreement 'is to improve the health status and wellbeing of Aboriginal and Torres Strait Islander peoples at least commensurate to that of the wider Australian community'. This is to be accomplished through:
a) improving access to health programs;
b) increasing resource allocation and having transparent reporting regarding services and programs;
c) joint planning processes; and
d) acknowledgement that the Agreement will not affect funding to Community Controlled Health Services.

The Agreement is to remain effective until an agreed termination by the parties or until a further agreement is executed."""@en ;
    schema:url "https://web.archive.org/web/20060910054347/http://foodsafetymatters.gov.au/phs/documents/ihu/16894.pdf"^^xsd:anyURI .

