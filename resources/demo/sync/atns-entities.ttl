idn-resource:081d2b92-18b6-57c1-b57c-2cff3d7c5186 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A006534"^^xsd:token ;
