    atns:eid "A001168"^^xsd:token ;
    atns:sourceEntityId "1624"^^xsd:token ;
    atns:subcategory atns-subcat:6ffe90c2-95c9-51b5-a083-8c7d83b975ef,
        atns-subcat:f0427812-61d1-5004-b577-ac236a9c5c18 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """The Commonwealth State Housing Agreement is an agreement, authorised under the Housing Assistance Act 1996 (Cth), between the Commonwealth and the States and Territories. The purpose of the Agreement is to provide funding to assist those whose needs for appropriate housing cannot be met by the private market.

The Agreement is designed to provide strategic direction and funding certainty for the provision of housing assistance across Australia over a four year period from 1 July 1999 to 30 June 2003. It will provide more than (AUD) $4 billion for housing assistance such as public and community housing, Indigenous housing, crisis accommodation, home purchase assistance and private rental assistance."""@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:d15dd1de-4696-50c8-9f10-2e95eea88e6f,
        atns-sub:ffe61b3b-8b29-5264-89ac-758a03928ea5,
        "Demo" ;
    schema:location "Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=1624> ;
    schema:name "Commonwealth State Housing Agreement 1999-2003"@en ;
    schema:startDate "1999-07-08"^^xsd:date ;
    schema:text "The Agreement acknowledges that the States and Territories will have different priorities for housing assistance under the Agreement and accordingly provides for the entering into of Bilateral Agreements between the Commonwealth and each State and Territory."@en ;
    schema:url "https://web.archive.org/web/20001007060331/http://www.facs.gov.au/internet/facsinternet.nsf/b919d06b2c7d99e3ca256807001393b2/4d969e9b49e065d9ca2567f8008287a2/$FILE/csha.pdf"^^xsd:anyURI .

