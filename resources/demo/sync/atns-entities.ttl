        "Demo" ;
    schema:location "South of Gladstone, Queensland, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=1249> ;
    schema:name "The Raising of Awoonga Dam Indigenous Land Use Agreement (ILUA)"@en ;
    schema:startDate "2001-03-16"^^xsd:date .

