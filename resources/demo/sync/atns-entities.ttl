    schema:name "State of Western Australia v Earnest Damien Manado & Ors; State of Western Australia v Rita Augustine & Ors; Commonwealth of Australia v Rita Augustine & Ors; Commonwealth of Australia v Earnest Damien Manado & Ors [2020] HCA 9"@en ;
