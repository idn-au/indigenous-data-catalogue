    schema:description "The Protocol Agreement signed on the 8 October 2002 by the Alexandrina Council and Ngarrindjeri People is an agreement whereby both parties have agreed to collaborate on any future developments involving traditional lands within the council area."@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
