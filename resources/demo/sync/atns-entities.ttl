idn-resource:6c4324e9-bd48-599b-8c2e-2ddb5da1773c a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:29b02e21-49b7-5626-9de0-9245016b1a72 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:244f6961-729f-5b21-8fc9-baff9dd9af7e ;
    atns:deleted false ;
    atns:eid "A000884"^^xsd:token ;
    atns:sourceEntityId "1361"^^xsd:token ;
    atns:subcategory atns-subcat:5701ef5e-fe49-5289-b4da-3345efa1ce89 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """The Giant Reefs Exploration Pty Ltd Edna Beryl Agreement is an agreement between Giants Reef Exploration Pty Ltd (a wholly owned subsidiary of Giants Reef Mining N.L.), the Warumungu People (the Traditional Owners in the Tennant Creek region), and the Central Land Council. It was entered into under section 46 of the Aboriginal Land Rights (Northern Territory) Act 1976 (Cth).

The Agreement was signed in Tennant Creek on 28 November 1998 and consented to by the Federal Minister for Aboriginal affairs on 7 January 1999, thereby enabling the grant of Mineral Lease C705 which contains the Edna Beryl gold deposit. The agreement is historic as it is the first agreement under the Land Rights Act between the Warumungu People and a mining company. Mineral Lease C705 was granted on 6 August 1999.

An all-weather access road of 3 kilometres is required from the Stuart Highway to the mine site and discussions with the Northern Territory Government are well advanced towards funding and construction."""@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:17d993e0-d19e-5349-a48e-4de57b1dba59,
        atns-sub:3302d162-15ce-5b7d-ad89-1f11c3cb6e0d,
        atns-sub:51ca8813-b7bb-5a37-819e-afae35771fff,
        atns-sub:9073e633-80a9-5ba7-8892-f556bd0a0612,
        atns-sub:e52a2091-dcda-569c-aafb-6497428c615c,
        "Demo" ;
    schema:location "Northern Territory, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=1361> ;
    schema:name "Giants Reef Exploration Pty Ltd Edna Beryl Agreement"@en ;
    schema:startDate "1998-11-28"^^xsd:date ;
    schema:text "The new Agreement will allow the Company to develop the mine at Edna Beryl and to process the ore at Warrego Processing works which closed down in 1999. As at March 2002, the Company has started rehabilitation work on earlier mine shafts at Edna Beryl, which last operated in the 1950s. The Agreement has strong provisions covering protection of sacred sites and employment and training of local Aboriginal people."@en .

