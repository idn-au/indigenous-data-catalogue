idn-resource:df70939d-adf9-525c-87b0-83d32d175189 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A003792"^^xsd:token ;
    atns:sourceEntityId "3792"^^xsd:token ;
    atns:subcategory atns-subcat:076d3b9a-6064-528c-a4f2-cd910bad69f5 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """The Agreement, signed 18 November 2004, involved the formal handing back of custodial care of the Walga Rock to the Wajarri Elders.

Parties present at the signing of the Agreement include the Yamatji Land and Sea Council (representing the Wajarri Elders); committee members of the Wajarri Yamatji Corporation; the Department of Indigenous Affairs; Cue Shire Council and the local Aboriginal group, Thoo Thoo Wanhina (Yamatji Land and Sea Council, 2004)."""@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:710c226b-1fba-5eba-86c9-5087f506ac80,
        atns-sub:746b3b59-88ea-5685-81f7-1558875d7c47,
        atns-sub:9e5e8f61-69be-5e2a-a9cd-58fb000349bd,
        "Demo" ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=3792> ;
    schema:name "Agreement to return Walga Rock to the custodial care of its traditional owners"@en ;
    schema:startDate "2004-11-18"^^xsd:date ;
    schema:text """Walga Rock is a granite monolith which has profound cultural significance not only to the traditional owners, the Wajarri, but also to the Aboriginal people throughout the mid-west and across the western desert regions of Western Australia (Yamatji Land and Sea Council, 2004).

The Agreement acknowledges the Wajarri elders as traditional owners of the sites, supports vesting of Walga Rock in the Wajarri Elders and recognises that their permission is required for any future development of the sites (Yamatji Marlpa Barna Baba Maaja Aboriginal Corporation, 2004).

The site will now be managed by a joint stakeholder's committee, which will assist in the care, maintenance and control of access to the area (National Indigenous Times, 2004)."""@en .

