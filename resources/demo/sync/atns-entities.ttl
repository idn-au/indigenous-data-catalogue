idn-resource:492eacf5-7cc9-54ee-a8ce-df968e99c332 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:244f6961-729f-5b21-8fc9-baff9dd9af7e ;
    atns:deleted false ;
    atns:eid "A002650"^^xsd:token ;
    atns:sourceEntityId "3040"^^xsd:token ;
    atns:subcategory atns-subcat:1682bda6-86ad-57ab-b605-73fb7027939d ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """The Wangkatjungka 'Recreation and Cultural Facilities' Shared Responsibility Agreement (SRA) was signed to improve the sport, recreation and cultural facilities in Wangkatjungka. Under the SRA, the community's basketball court will be fitted with lights, a shade cover for the playground will be constructed, and the Community Hall will be renovated. The '50 cent house', currently used for cultural activities, will be relocated to Wangkatjungka's cultural grounds. The SRA was signed in 2005 between community members and the Commonwealth Government.

Shared Responsibility Agreements are agreements between governments and Indigenous communities to provide discretionary funding in return for community obligations. The new arrangements developed from an initiative of the Council of Australian Governments and replace the previous ATSIC system of funding. For more information see ‘Shared Responsibility Agreement’ below."""@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:17d993e0-d19e-5349-a48e-4de57b1dba59,
        atns-sub:5996de0c-8cc6-5f14-8901-d839af36a4d4,
        atns-sub:ef36130b-f525-5200-b398-93681fdc865b,
        atns-sub:ffe61b3b-8b29-5264-89ac-758a03928ea5,
        "Demo" ;
    schema:location "Western Kimberley, Western Australia, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=3040> ;
    schema:name "Wangkatjungka 'Recreation and Cultural Facilities' Shared Responsibility Agreement (SRA)"@en ;
    schema:startDate "2005-01-01"^^xsd:date ;
    schema:text """Purpose

The Wangkatjungka community want to give young people more opportunities to grow and develop. The redevelopment of facilities means they can be used more regularly, particularly during summer when high temperatures can deter community involvement in sporting activities.

Shared Responsibilities

The community has agreed to run a 'clean up day' to improve their home. The residents will also help to develop the new facilities, and will encourage participation.

Under the SRA, the Commonwealth Government will provide $124,200 towards the upgrading of facilities.

The Wangkatjungka SRA is administered by the Derby Indigenous Coordination Centre."""@en ;
    schema:url "http://www.indigenous.gov.au/sra/search/document.aspx?id=8173"^^xsd:anyURI .

