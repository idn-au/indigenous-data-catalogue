idn-resource:fc23cb36-dff9-5ea1-a434-86117e354971 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A006060"^^xsd:token ;
