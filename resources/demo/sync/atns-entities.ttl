idn-resource:f8c7655f-649d-5859-bcd9-7aa0e9b5a395 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:244f6961-729f-5b21-8fc9-baff9dd9af7e ;
    atns:deleted false ;
    atns:eid "A001522"^^xsd:token ;
    atns:sourceEntityId "1974"^^xsd:token ;
    atns:subcategory atns-subcat:09f0a068-ce65-5c11-8dec-f081d1a81ec2 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description "The Central Queensland Gemfields ILUA aims to facilitate the processing of applications for Prospecting Permits, Mining Claims and Mining Leases in the area of the ILUA. Registered native title claimants, the Kangoulu People, and members of the Queensland Sapphire Producers Association agreed to a set of conditions for the granting of these types of mining tenements for the mining of sapphire, zircon, gold or diamond. The conditions provide recognition of native title rights and interests and protect cultural heritage. The ILUA enabled immediate granting of approximately 250 Mining Claims and 50 Mining Leases. Mining Claims may only be granted for an initial term of five (5) years, however the ILUA does allow for the renewal and assignment of the mining tenements. Mining tenements within the ILUA area that are totally covered by a 'Scheduled Interest' are not subject to the conditions of the ILUA. There is no end date specified for the ILUA, however the agreement states that 'The Agreement will end if the Federal Court determines that Native Title does not exist in relation to the ILUA Area' and that '[i]f the Federal Court determines that Native Title does not exist in relation to any part(s) of the ILUA Area the Agreement will not apply to any such area.'"@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:17d993e0-d19e-5349-a48e-4de57b1dba59,
        atns-sub:29221ef9-81d0-59aa-a9c9-744b71ff8349,
        atns-sub:3302d162-15ce-5b7d-ad89-1f11c3cb6e0d,
        atns-sub:c74e76ef-701f-5784-8223-5fcd87a7641c,
        "Demo" ;
    schema:location "West of Emerald, Queensland, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=1974> ;
    schema:name "Central Queensland Gemfields Indigenous Land Use Agreement (ILUA)"@en ;
    schema:startDate "2004-02-24"^^xsd:date .

