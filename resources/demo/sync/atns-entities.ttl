        atns-sub:e52a2091-dcda-569c-aafb-6497428c615c,
        "Demo" ;
    schema:location "South Australia, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=2390> ;
    schema:name "Breakaways / Moon Plain Filming Agreement"@en ;
    schema:startDate "1998-01-01"^^xsd:date .

