        atns-sub:dc50c698-80b0-5ef4-bd95-928f2be8da05,
        "Demo" ;
    schema:location "North east of Camooweal, Queensland, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=2103> ;
    schema:name "Waanyi ILUA for Backlog Exploration Permits Indigenous Land Use Agreement (ILUA)"@en ;
    schema:startDate "2004-06-15"^^xsd:date .

idn-resource:794e7f40-2711-502c-84a4-90d8fd8d6c66 a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:2df81c96-4484-5677-89ef-8a27318e582a,
        idn-resource:4aa34d85-0079-59cf-bacb-b0b5e23189d3,
        idn-resource:7b928a0d-47c5-537a-9136-066ae7f542f4,
        idn-resource:b353c05d-9979-503d-bc5c-8176dd5eda27 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:244f6961-729f-5b21-8fc9-baff9dd9af7e ;
    atns:deleted false ;
    atns:eid "A002421"^^xsd:token ;
    atns:sourceEntityId "2831"^^xsd:token ;
    atns:subcategory atns-subcat:09f0a068-ce65-5c11-8dec-f081d1a81ec2 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """The Simpson's Gap National Park Extension Indigenous Land Use Agreement (ILUA) was made between the Central Land Council, the Northern Territoy of Australia and the Lhere Artepe Aboriginal Corporation to clarify the future title and management of the Simpson's Gap National Park Extension.

This ILUA is one of 31 agreements signed over parks and reserves in the Northern Territory. The agreements were developed following the High Court’s decision in Western Australia v Ward, which found that the Keep River National Park had not been properly established. In response, the Northern Territory government pursued ILUAs and joint management agreements to resolve tenure disputes and management of the parks. These agreements were negotiated from 2002 to 2005, during which time the Parks and Reserves (Framework for the Future) Act 2003 (NT) was also passed. These arrangements aim to settle all native title issues in Northern Territory national park areas."""@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:17d993e0-d19e-5349-a48e-4de57b1dba59,
        atns-sub:1ec05be0-16ac-52de-bf3b-54bec0211332,
        atns-sub:710c226b-1fba-5eba-86c9-5087f506ac80,
        atns-sub:7cc37d9a-fe3c-5fec-b115-d1bb8d72db9c,
        atns-sub:9e5e8f61-69be-5e2a-a9cd-58fb000349bd,
        atns-sub:c74e76ef-701f-5784-8223-5fcd87a7641c,
        atns-sub:e52a2091-dcda-569c-aafb-6497428c615c,
        atns-sub:f630e08a-ea9c-57e3-ab87-066e4b9ad57e,
        "Demo" ;
    schema:location "West of Alice Springs, Northern Territory, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=2831> ;
    schema:name "Simpson's Gap National Park Extension Indigenous Land Use Agreement (ILUA)"@en ;
    schema:startDate "2005-06-23"^^xsd:date ;
    schema:text """Under the ILUA, the parties consent to the Simpson's Gap National Park Extension being granted as Aboriginal Land under the Aboriginal Land Rights (Northern Territory) Act 1976 (Cth). They also agree to facilitate future development of the Park in compliance with this Act.

The Simpson's Gap National Park Extension is also listed under Schedule 1 of the Parks and Reserves (Framework for the Future) Act 2003 (NT). This means that the even though the land is returned to the Lhere Artepe Aboriginal Corporation, the land will be leased back to the Northern Territory Government to be used for parks. Agreements outlining joint management of the park by Indigenous groups and government will be developed."""@en .

