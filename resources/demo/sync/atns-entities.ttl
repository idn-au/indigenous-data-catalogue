idn-resource:6a5e7b3a-5186-5d39-a0e5-5a3eaac59360 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A005162"^^xsd:token ;
    atns:sourceEntityId "5162"^^xsd:token ;
    atns:subcategory atns-subcat:09f0a068-ce65-5c11-8dec-f081d1a81ec2 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description "This Indigenous Land Use Agreement (ILUA) was agreed between FMG Pilbara Pty Ltd (Fortescue Metals Group) and the Wintawari Guruma Aboriginal Corporation RNTBC. The purpose of this ILUA is to provide consent for the grant and renewal of four mining tenements to FMG Pilbara Pty Ltd within the ILUA area."@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:29221ef9-81d0-59aa-a9c9-744b71ff8349,
        atns-sub:3302d162-15ce-5b7d-ad89-1f11c3cb6e0d,
        "Demo" ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=5162> ;
    schema:name "FMG Pilbara Pty Ltd and Wintawari Guruma Aboriginal Corporation RNTBC Indigenous Land Use Agreement (ILUA)"@en ;
    schema:startDate "2010-07-14"^^xsd:date ;
    schema:text """Pursuant to this ILUA, the parties consent to the grant and renewal to each of the four mining tenements with respect to which FMG Pilbara Pty Ltd has made application under the Mining Act
1978 (WA).

Right to negotiate provisions

The parties also agree that the right to negotiate provisions in Subdivision P, Division 3, Part 2 of the Native Title Act 1993 (Cth) are not intended to apply to the grant or renewal of any such tenements.

Background on native title in the ILUA area

In the proceeding WAD 6208 of 1998, the Federal Court of Australia made a consent determination finding that the Eastern Guruma People had non-exclusive native title rights and interests over land that included the area covered by this ILUA. The Eastern Guruma People's native title rights included the right to possession, occupation and use of the 8,700 square kilometres of land that made up the Determination Area. This determination was the first native title claim to be negotiated in the Pilbara region.

The Wintawari Guruma Aboriginal Corporation RNTBC, which is one of the signatories to this ILUA, is the body administering the Eastern Guruma People's native title rights in land. It also administers the Eastern Guruma Pastoral Indigenous Land Use Agreement (ILUA) (National Native Title Tribunal File No. WI2006/004)."""@en ;
    schema:url "http://www.nntt.gov.au/Indigenous-Land-Use-Agreements/Search-Registered-ILUAs/ILUA%20Register/2010/WI2010.005/ILUARegisterExport.pdf"^^xsd:anyURI .

