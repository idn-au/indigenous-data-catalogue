    schema:name "Napranum, Mapoon and Aurukun Timber Joint Venture Agreement"@en ;
    schema:startDate "2004-01-01"^^xsd:date .

idn-resource:609a1c62-a7c3-54e4-8f97-f70dd4374a34 a atns:Entity,
        schema:CreativeWork ;
