idn-resource:73e45817-65c6-5a9f-a758-c7042535edd0 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A007216"^^xsd:token ;
    atns:sourceEntityId "7216"^^xsd:token ;
    atns:subcategory atns-subcat:123a2199-09c1-53e0-9c4d-6ae2033ea91c ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """The Project Agreement on Improving Trachoma Control Indigenous Western Australia 2012-13 ('the Agreement') has been superseded by the Project Agreement on Improving Trachoma Control Services for Indigenous Australians 2014-2017.

The aim of this Agreement is to support the delivery of additional trachoma control services as well as any additional activities to facilitate the improvement of the identification, screening, treatment, management and prevention of trachoma and trichiasis for Indigenous Australians. Improving Eye and Ear Health Services for Indigenous Australians for Better Education and Employment Outcomes"""@en ;
    schema:endDate "2013-06-30"^^xsd:date ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:d15dd1de-4696-50c8-9f10-2e95eea88e6f,
        "Demo" ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=7216> ;
    schema:name "Project Agreement on Improving Trachoma Control Indigenous Western Australia 2012-13"@en ;
    schema:startDate "2012-06-05"^^xsd:date ;
    schema:text """Outputs

The outputs of the agreement included a comprehensive and systematic trachoma and trichiasis screening and treatment programs in communities where trachoma and/or trichiasis is prevalent or at risk of trachoma, and report on results; and a submission of required relevant data to the National Trachoma Surveillance and Reporting Unit which is located within the Kirby Institute of Infection and Immunity in Society in the University of New South Wales.

The role of the Commonwealth involves monitoring and assessing milestone achievements and ensuring outputs are delivered within an agreed timeframe, as well as providing consequent financial contributions to ensure the implementation of the agreement.

The responsibility of Western Australia includes all aspects of delivering the outputs of the project and reporting on the delivery outputs."""@en ;
    schema:url "http://www.federalfinancialrelations.gov.au/content/npa/health/_archive/trachoma-control-services/WA.pdf"^^xsd:anyURI .

idn-resource:73e8b6f7-889e-5a50-ae73-02de2373a7c1 a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:482019f5-3c4a-5908-b9d9-f7179ee99aba,
        idn-resource:4be1244b-2872-5199-8ba6-8c25fb02095d,
        idn-resource:57e68b9e-650f-501e-99ca-2c09222730b3,
        idn-resource:f79c4ca1-c640-5091-8d19-9492b9e2b483 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:country atns-country:244f6961-729f-5b21-8fc9-baff9dd9af7e ;
    atns:deleted false ;
