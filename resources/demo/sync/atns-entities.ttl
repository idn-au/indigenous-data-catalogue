idn-resource:3123d9a5-4994-59a9-a269-52706eae33d0 a atns:Entity ;
    dcterms:references idn-resource:2020622e-6e20-5734-9dca-b5059ce0bbb4,
        idn-resource:ae2ed60e-d52a-50bc-a94c-6370bfa78679 ;
    atns:category atns-cat:3303b0bc-4a7b-5535-b93a-159ae7b48345 ;
