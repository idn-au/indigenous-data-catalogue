idn-resource:24ce9c7d-0d49-5e03-8d6e-e810bbf50a0c a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A003048"^^xsd:token ;
