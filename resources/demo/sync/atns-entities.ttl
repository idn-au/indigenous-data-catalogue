        atns-sub:9c404ff9-19e6-5e64-a8bd-2e3b39773146,
        atns-sub:c74e76ef-701f-5784-8223-5fcd87a7641c,
        "Demo" ;
    schema:location "Umalka Tjintjira Community, Northern Territory, Australia"@en ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=1687> ;
    schema:name "Umalka Tjintjira (Community Living Area) Indigenous Land Use Agreement (ILUA)"@en ;
    schema:startDate "2003-06-30"^^xsd:date .

