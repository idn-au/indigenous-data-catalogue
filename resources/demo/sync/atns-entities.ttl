idn-resource:c1d20418-5ea3-5dc1-8be1-6980598e1b00 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A005308"^^xsd:token ;
    atns:sourceEntityId "5308"^^xsd:token ;
    atns:subcategory atns-subcat:09f0a068-ce65-5c11-8dec-f081d1a81ec2 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description "The Siam North Pastoral Indigenous Land Use Agreement (ILUA) was agreed between the State of South Australia, Yarrah Nominees Pty Ltd and Elliot McNamaara, Howard Richards, Andrew Dingaman and Ken Smith, who represent the Gawler Ranges Native Title Group. The purpose of this ILUA is to set out the relationship between native title rights and interests and other rights and interests in the agreement area."@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:29221ef9-81d0-59aa-a9c9-744b71ff8349,
        atns-sub:bda82010-54a4-5bac-8bf5-4b5341822974,
        "Demo" ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=5308> ;
    schema:name "Siam North Pastoral Indigenous Land Use Agreement (ILUA)"@en ;
    schema:startDate "2009-05-27"^^xsd:date ;
    schema:text """The extract provided on the National Native Title Tribunal's Register of Indigenous Land Use Agreements gives very little detail of the content of this ILUA. However, in the Notice of Applications to Register Area Agreements on the Register of Indigenous Land Use Agreements (25 February 2009), it is stated that this ILUA and several other pastoral ILUAs that fall within the Gawler Ranges Native Title Claim are intended to provide for access to the ILUA area by members of the Gawler Ranges Native Title Group for the purpose of undertaking traditional activities on certain terms.

Background on native title in the ILUA area

The ILUA area is located within the claim area of the currently active Gawler Ranges Native Title Claim (Federal Court File No. SAD6020/98). All members of the claim group identify as members of either the Barngarla or the Kokatha Peoples. The application for this claim was originally filed on 12 September 1997, and was amended on 15 September 1997. The claim extends over land and waters to the north of Wudinna in South Australia."""@en ;
    schema:url "http://www.nntt.gov.au/Indigenous-Land-Use-Agreements/Search-Registered-ILUAs/ILUA%20Register/2008/SI2008.007/ILUARegisterExport.pdf"^^xsd:anyURI .

