        idn-resource:ddf02c73-4885-526f-8496-a3f0accd7154,
        idn-resource:f0a1e242-79a0-59db-8ca7-80c1e9b9e844,
        idn-resource:f3d52e50-bb4a-5875-bfa1-ebe002c5fb58 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
