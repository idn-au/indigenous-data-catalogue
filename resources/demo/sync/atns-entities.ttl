    atns:subcategory atns-subcat:51e799aa-68a2-5df5-b3b6-ce3837c24612 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """The Commitment Statement (Shire) is an example of Reconciliation Agreement Principles provided by the National Native Title Tribunal (NNTT).

It is envisaged by the NNTT that this will be used to assist Indigenous Australians and non-Indigenous Australians to negotiate shire Commitment Statements that can be tailored to their specific needs and circumstances.

The Commitment Statement (Shire) is designed to be made between a Shire and a Working Group made up of native title applicants.

The template agreement sets out suggested clauses including:
(a) acknowledging the Indigenous people as the traditional owners of the region;
(b) commitments by the Shire to support the economic and cultural aspirations of its Indigenous community; and
(c) joint management arrangements, including formulating a planning strategy to be included in the town plan."""@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:f373baa1-6611-5aae-a140-c2cd1c548f13,
        "Demo" ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=3450> ;
    schema:name "Commitment Statement (Shire)"@en ;
    schema:text """The NNTT has issued template agreements covering six categories, being:
1. Future Act Agreements
2. Intra-Aboriginal Agreements
3. Mediation Withdrawal Agreements
4. Negotiating Framework Agreements
5. Pastoral Agreements
6. Reconciliation Agreements Principals.

Please see the ‘Template Agreement’ link at the bottom of this page for further information.

Please also see the National Native Title Tribunal's DISCLAIMER in relation to these agreements."""@en ;
    schema:url "http://www.nntt.gov.au/agreements/templates.html"^^xsd:anyURI .

idn-resource:c73b800f-6dd3-581d-a1f6-5863afccc144 a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:0a87baf8-543c-5a5e-af32-471fc87d662f,
        idn-resource:194872b5-ff98-5919-8b6d-43c56f8edcd7,
        idn-resource:2565d1ee-2235-5f99-8403-affc70e57d44 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
