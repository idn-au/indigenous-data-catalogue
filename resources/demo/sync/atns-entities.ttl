idn-resource:7b9504ee-c8a1-5c42-b419-3dd63f8fcceb a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:7b928a0d-47c5-537a-9136-066ae7f542f4 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A003913"^^xsd:token ;
    atns:sourceEntityId "3913"^^xsd:token ;
    atns:subcategory atns-subcat:09f0a068-ce65-5c11-8dec-f081d1a81ec2 ;
    schema:additionalType cat-obj-types:Agreement ;
    schema:conditionsOfAccess <https://linked.data.gov.au/def/data-access-rights/open> ;
    schema:description """The Evelyn Downs Pastoral Indigenous Land Use Agreement (ILUA) was agreed between the State of South Australia (APPLICANT); and Jean Wood, Sadie Singer, Lallie Lennon, Johnny Cullinan on behalf of the Yankunytjatjara Antakirinja and Evelyn Downs Pastoral Co Ltd. The ILUA was registered on 18 June 2007.

The purpose of the ILUA is to provide access for the Yankunytjatjara/Antakirinja people to conduct traditional activities over the ILUA area."""@en ;
    schema:isPartOf idn-resource:d23405b4-fc04-47e2-9e7a-9c5735ae3780 ;
    schema:keywords atns-sub:9335b2f1-4915-55cc-9736-2ded7c4a2008,
        atns-sub:9e5e8f61-69be-5e2a-a9cd-58fb000349bd,
        atns-sub:c74e76ef-701f-5784-8223-5fcd87a7641c,
        "Demo" ;
    schema:mainEntityOfPage <https://database.atns.net.au/agreement.asp?EntityID=3913> ;
    schema:name "The Evelyn Downs Pastoral Indigenous Land Use Agreement (ILUA)"@en ;
    schema:startDate "2007-06-18"^^xsd:date ;
    schema:text """This ILUA does not include any statements regarding 'future acts', nor does it alter the right to negotiate over future acts, as set out in the relevant Native Title Act 1993 (Cth) provisions. Under this Act any activity, such as a grant of land, that may affect native title rights is defined as a 'future act' and must comply with the future act provisions of the Act in order to be valid.

This ILUA is one of several that has resulted from the De Rose Hill native title determination (De Rose v State of South Australia (No 2) [2005] FCAFC 110) of the Yankunytjatjara/Antakirinja native title claim."""@en .

idn-resource:7b973d06-4998-5835-8c1e-efac47b02e2b a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
