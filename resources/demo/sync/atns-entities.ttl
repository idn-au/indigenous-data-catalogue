        idn-resource:3f980eb4-cc22-5a32-a218-ccb8bcff1e30,
        idn-resource:fee835c0-9bdd-5caf-98ee-730d311ef357 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
