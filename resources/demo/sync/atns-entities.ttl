idn-resource:41f2389e-6e36-5ab9-a5c4-2708de7744c5 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A005379"^^xsd:token ;
