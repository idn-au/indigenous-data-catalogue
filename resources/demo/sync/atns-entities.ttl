idn-resource:704e00c4-e63a-5ccd-82d8-38bf3b72e9d2 a atns:Entity,
        schema:CreativeWork ;
    dcterms:references idn-resource:ff943795-79c3-565e-9cd4-f131aa9af0d6 ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
