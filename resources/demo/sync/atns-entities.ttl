idn-resource:25bfb947-0dc0-56d0-a66b-4d7b7088a547 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A006372"^^xsd:token ;
