idn-resource:9002537a-cd98-5055-8b0e-ee0f7f3d3160 a atns:Entity,
        schema:CreativeWork ;
    atns:category atns-cat:13e77fec-44fd-554f-a075-ec60788eb1b1 ;
    atns:deleted false ;
    atns:eid "A006908"^^xsd:token ;
