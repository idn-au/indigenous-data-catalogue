cs:
    a skos:ConceptScheme ;
    skos:changeNote "2026-11-05: Updated to be VocPub conformant" ;
    skos:definition "Vocabulary of weapons using in colonial frontier massacres in Australia"@en ;
    skos:hasTopConcept
        :axes ,
        :bayonets ,
        :blades ,
        :boomerangs ,
        :cannons ,
        :clubs ,
        :firearms ,
        :horses ,
        :incineration ,
        :knives ,
        :machetes ,
        :plasterofParis ,
        :poison ,
        :rifleButts ,
        :spears ,
        :stirrups ,
        :stockwhips ,
        :stones ,
        :swords ,
        :unknown ;
    skos:prefLabel "Weapons of the colonial fronteir massacres"@en ;
    sdo:creator <https://linked.data.gov.au/org/idn> ;
    sdo:dateCreated "2026-08-06"^^xsd:date ;
    sdo:dateModified "2026-11-05"^^xsd:date ;
    sdo:publisher <https://linked.data.gov.au/org/idn> ;
    sdo:status astatus:experimental ;
.
