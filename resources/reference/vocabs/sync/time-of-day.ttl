<https://linked.data.gov.au/def/time-of-day/afternoon>
    a skos:Concept ;
    rdfs:isDefinedBy <https://linked.data.gov.au/def/time-of-day> ;
    skos:altLabel
        "Mid afternoon"@en ,
        "PM"@en ,
        "Post meridiem"@en ,
        "Postmeridian"@en ;
    skos:definition "The time between noon and sunset" ;
    skos:inScheme <https://linked.data.gov.au/def/time-of-day> ;
    skos:prefLabel "Afternoon"@en ;
    skos:topConceptOf <https://linked.data.gov.au/def/time-of-day> ;
.

<https://linked.data.gov.au/def/time-of-day/dawn>
    a skos:Concept ;
    rdfs:isDefinedBy <https://linked.data.gov.au/def/time-of-day> ;
    skos:altLabel
        "Aurora"@en ,
        "Cockcrow"@en ,
        "Dawning"@en ,
        "Daybreak"@en ,
        "Sunrise"@en ,
        "Sunup"@en ;
    skos:definition "Dawn is the time that marks the beginning of twilight before sunrise." ;
    skos:inScheme <https://linked.data.gov.au/def/time-of-day> ;
    skos:prefLabel "Dawn"@en ;
    skos:topConceptOf <https://linked.data.gov.au/def/time-of-day> ;
.

<https://linked.data.gov.au/def/time-of-day/day>
    a skos:Concept ;
    rdfs:isDefinedBy <https://linked.data.gov.au/def/time-of-day> ;
    skos:definition "Day time" ;
    skos:inScheme <https://linked.data.gov.au/def/time-of-day> ;
    skos:prefLabel "Day" ;
    skos:topConceptOf <https://linked.data.gov.au/def/time-of-day> ;
.

<https://linked.data.gov.au/def/time-of-day/evening>
    a skos:Concept ;
    rdfs:isDefinedBy <https://linked.data.gov.au/def/time-of-day> ;
    skos:definition "Evening" ;
    skos:inScheme <https://linked.data.gov.au/def/time-of-day> ;
    skos:prefLabel "Evening" ;
    skos:topConceptOf <https://linked.data.gov.au/def/time-of-day> ;
.

<https://linked.data.gov.au/def/time-of-day/midday>
    a skos:Concept ;
    rdfs:isDefinedBy <https://linked.data.gov.au/def/time-of-day> ;
    skos:altLabel
        "Meridian"@en ,
        "Midpoint"@en ,
        "Noon"@en ,
        "Noonday"@en ,
        "Noontide"@en ,
        "Noontime"@en ,
        "Solar noon"@en ;
    skos:definition "The time when the Sun appears to contact the local celestial meridian, at 12 noon apparent solar time." ;
    skos:inScheme <https://linked.data.gov.au/def/time-of-day> ;
    skos:prefLabel "Midday" ;
    skos:topConceptOf <https://linked.data.gov.au/def/time-of-day> ;
.

<https://linked.data.gov.au/def/time-of-day/morning>
    a skos:Concept ;
    rdfs:isDefinedBy <https://linked.data.gov.au/def/time-of-day> ;
    skos:altLabel
        "AM"@en ,
        "Ante meridiem"@en ,
        "Antemeridian"@en ,
        "Early morning"@en ,
        "Forenoon"@en ,
        "Matins"@en ,
        "Midmorning"@en ,
        "Morn"@en ;
    skos:definition "The time between Dawn and Midday"@en ;
    skos:inScheme <https://linked.data.gov.au/def/time-of-day> ;
    skos:prefLabel "Morning"@en ;
    skos:topConceptOf <https://linked.data.gov.au/def/time-of-day> ;
.

<https://linked.data.gov.au/def/time-of-day/night>
    a skos:Concept ;
    rdfs:isDefinedBy <https://linked.data.gov.au/def/time-of-day> ;
    skos:definition "Night" ;
    skos:inScheme <https://linked.data.gov.au/def/time-of-day> ;
    skos:prefLabel "Night"@en ;
    skos:topConceptOf <https://linked.data.gov.au/def/time-of-day> ;
.

<https://linked.data.gov.au/org/idn>
