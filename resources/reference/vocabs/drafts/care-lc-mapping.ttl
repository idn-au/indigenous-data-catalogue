PREFIX bc: <https://data.idnau.org/pid/vocab/bc-labels/>
PREFIX care: <http://linked.data.gov.au/def/care/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX regstat: <https://linked.data.gov.au/def/reg-statuses/>
PREFIX sdo: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX tk: <https://data.idnau.org/pid/vocab/tk-labels/>
PREFIX void: <http://rdfs.org/ns/void#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

care:A1
    skos:relatedMatch
        bc:provenance ,
        tk:attribution ,
        tk:multiple-communities ;
.

care:A2
    skos:relatedMatch
        bc:provenance ,
        tk:attribution ,
        tk:multiple-communities ;
.

care:C1
    skos:relatedMatch
        bc:non-commercial ,
        bc:open-to-collaboration ,
        bc:open-to-commercialization ,
        bc:research-use ,
        tk:commercial ,
        tk:non-commercial ,
        tk:open-to-collaboration ;
.

care:C2
    skos:relatedMatch
        bc:outreach ,
        tk:outreach ;
.

care:C3
    skos:relatedMatch tk:commercial ;
.

care:E1
    skos:relatedMatch
        tk:non-verified ,
        tk:verified ;
.

care:E3
    skos:relatedMatch
        bc:provenance ,
        tk:attribution ,
        tk:culturally-sensitive ;
.

<https://data.idnau.org/def/care-lc-mapping>
    a void:Linkset ;
    void:linkPredicate skos:relatedMatch ;
    void:objectsTarget
        bc: ,
        tk: ;
    void:subjectsTarget care: ;
    owl:versionIRI <https://data.idnau.org/def/care-lc-mapping/0.1.0> ;
    owl:versionInfo "0.1.0" ;
    skos:definition "Standalone semantic mapping of CARE Principles to Traditional Knowledge and Biocultural labels."@en ;
    skos:historyNote "Created for scoring, inference and cataloguing support"@en ;
    skos:prefLabel "CARE to Local Contexts label mappings"@en ;
    sdo:codeRepository "https://github.com/idn-au/reference-resource-register"^^xsd:anyURI ;
    sdo:copyrightHolder <https://linked.data.gov.au/org/idn> ;
    sdo:copyrightNotice "(c) Indigenous Data Network, 2026" ;
    sdo:copyrightYear "2026"^^xsd:gYear ;
    sdo:creator <https://linked.data.gov.au/org/idn> ;
    sdo:dateCreated "2026-03-04"^^xsd:date ;
    sdo:dateModified "2026-07-01"^^xsd:date ;
    sdo:identifier "carelcmap"^^xsd:token ;
    sdo:license "https://creativecommons.org/licenses/by/4.0/"^^xsd:anyURI ;
    sdo:publisher <https://linked.data.gov.au/org/idn> ;
    sdo:status regstat:experimental ;
.

<https://linked.data.gov.au/org/idn>
    a sdo:Organization ;
    sdo:name "Indigenous Data Network" ;
    sdo:url "https://www.idnau.org"^^xsd:anyURI ;
.
