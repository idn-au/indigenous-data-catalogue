PREFIX : <https://data.idnau.org/pid/lc-ont#>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX kai: <https://kurrawong.ai>
PREFIX odrl: <http://www.w3.org/ns/odrl/2/>
PREFIX odrl-action: <https://linked.data.gov.au/def/odrl-action/>
PREFIX ont: <https://data.idnau.org/pid/lc-ont>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

odrl:Policy
    a owl:Class ;
    rdfs:isDefinedBy odrl: ;
    skos:scopeNote "A Policy may contain multiple Rules." ;
    schema:description "A non-empty group of Permissions and/or Prohibitions." ;
    schema:name "Policy" ;
.

:CollectionsCareDuty
    a odrl:Duty ;
    odrl:action odrl-action:follow-protocol ;
    rdfs:isDefinedBy ont: ;
    schema:name "Collections Care Duty" ;
    schema:description "You are entering a space where Collections Care Notices are in use. Be prepared to follow the protocols for access, use, handling, and viewing associated with certain items or collections. These are in place for the care of the collections and the communities to whom they belong. For more information about Collections Care Notices, see localcontexts.org." ;
.

:templateText
    a owl:DatatypeProperty ;
    rdfs:domain
        [
            a owl:Class ;
            owl:unionOf
                (
                    :BCLabel
                    :LCNotice
                    :TKLabel
                ) ;
        ] ;
    rdfs:isDefinedBy ont: ;
    rdfs:range rdf:langString ;
    schema:description "A prescriptive text string associated with a Label or Notice that provides boilerplate wording intended to be reused or customised by end-users. Distinct from skos:example, which is illustrative only." ;
    schema:name "Template Text" ;
.

:relatedNotice
    a owl:ObjectProperty ;
    rdfs:domain
        [
            a owl:Class ;
            owl:unionOf
                (
                    :BCLabel
                    :TKLabel
                ) ;
        ] ;
    rdfs:isDefinedBy ont: ;
    rdfs:range :LCNotice ;
    schema:description "Relates a Traditional Knowledge or Biocultural Label to a relevant Local Contexts Notice." ;
    schema:name "Related Notice" ;
.

odrl:Duty
    a owl:Class ;
    rdfs:isDefinedBy odrl: ;
    schema:description "The obligation to perform an Action" ;
    schema:name "Duty" ;
.

:BCLabel
    a owl:Class ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf skos:Concept ;
    schema:description "A SKOS Concept representing a Biocultural Label from the Local Contexts framework." ;
    schema:name "Biocultural Label" ;
.

:CCNotice
    a owl:Class ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf :LCNotice ;
    schema:description "A SKOS Concept representing a Collection Care Notice from the Local Contexts framework." ;
    schema:name "Collections Care Notices" ;
.

:LCNotice
    a owl:Class ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf skos:Concept ;
    schema:description "A SKOS Concept representing a Notice from the Local Contexts framework." ;
    schema:name "Local Contexts Notice" ;
.

:QualifiedLocalContext
    a owl:Class ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf dcat:Relationship ;
    schema:description "A qualified relationship between a catalogued resource and a Local Contexts Label or Notice, used when information about the application of that Label or Notice must be recorded on the relationship itself." ;
    schema:name "Qualified Local Context" ;
    skos:scopeNote "Use the direct odrl:hasPolicy or schema:potentialAction relationship when no relationship-level qualification is required." ;
.

:TKLabel
    a owl:Class ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf skos:Concept ;
    schema:description "A SKOS Concept representing a Traditional Knowledge Label from the Local Contexts framework." ;
    schema:name "Traditional Knowledge Label" ;
.

kai:
    a schema:Organization ;
    schema:name "KurrawongAI" ;
    schema:url "https://kurrawong.ai"^^xsd:anyURI ;
.

<https://linked.data.gov.au/org/idn>
    a schema:Organization ;
    schema:name "Indigenous Data Network" ;
    schema:url "https://idnau.org/"^^xsd:anyURI ;
.

ont:
    a owl:Ontology ;
    owl:versionIRI :0.2 ;
    skos:historyNote """2026-02 NJC: made OntPub-conformant

2025-09 LK: created""" ;
    schema:additionalType schema:DataModel ;
    schema:codeRepository "https://github.com/idn-au/reference-resource-register"^^xsd:anyURI ;
    schema:creator kai: ;
    schema:dateCreated "2025-09-23"^^xsd:date ;
    schema:dateIssued "2026-03-31"^^xsd:date ;
    schema:dateModified "2026-10-05"^^xsd:date ;
    schema:description "Defines Local Contexts Label and Notice classes, an optional qualified relationship class, and properties for associating reusable boilerplate text and related Notices with Local Contexts resources." ;
    schema:keywords "Reference" ;
    schema:license <http://purl.org/NET/rdflicense/cc-by4.0> ;
    schema:name "Local Contexts Extension Vocabulary" ;
    schema:publisher <https://linked.data.gov.au/org/idn> ;
    schema:version "0.2" ;
.
