# this Dataset has two IRIs for dcterms:spatial and can be used to test downstream impacts for rendering spatial features. ref: https://github.com/idn-au/idn-catalogue-profile/issues/22

PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX ex: <https://example.org/catalog/>
PREFIX schema: <https://schema.org/>
PREFIX vcard: <http://www.w3.org/2006/vcard/ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

ex:dataset-coastal-biodiversity
    a schema:Dataset ;
    schema:contactPoints
        [
            a vcard:Individual ;
            vcard:fn "Dr. J. Smith" ;
            vcard:hasEmail <mailto:j.smith@example.org> ;
        ] ;
    dcat:landingPage <https://example.org/data/coastal-biodiversity> ;
    schema:creator <https://ror.org/03yrm5c26> ;
    schema:dateCreated "2025-10-08"^^xsd:date ;
    schema:dateIssued "2022-07-15"^^xsd:date ;
    schema:dateModified "2026-08-25"^^xsd:date ;
    schema:description "Survey data collected from two distinct Victorian coastal regions between 2019 and 2022."@en ;
    schema:keywords
        <http://vocab.australia.gov.au/def/anzsrc-for/0602> ,
        "Victoria" ,
        "biodiversity" ,
        "coastal ecosystem" ,
        "Demo" ;
    schema:name "Coastal biodiversity surveys of Port Phillip Bay and Western Port"@en ;
    schema:publisher <https://ror.org/03yrm5c26> ;
    schema:spatialCoverage
        <https://sws.geonames.org/2058695/> ,
        <https://sws.geonames.org/2158177/> ;
.
